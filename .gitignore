# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

#schema
/prisma/migrations
/prisma/seed.ts

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …but DO commit the secret-free template so the team has a reference
!.env.local.example

# vercel
.vercel

# generated PDFs are produced in-memory and streamed — never stored on disk
/public/invoices/

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/
prisma/seed.ts

# local scratch / build temp dir (TEMP redirect — see windows-c-drive notes)
/tmp/
