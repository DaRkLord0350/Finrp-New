// ============================================================
// ============ CLIENT WORKSPACE (CA ↔ Client Org RBAC) =======
// ============================================================
// ClientAssignment: grants a CA user access to a client
// organization with a scoped permission set. Powering:
//   • "Assigned Customers" list in the CA portal
//   • Workspace entry validation (impersonation)
//   • Per-module permission gating inside the workspace
// ClientActivityLog: immutable audit trail of every workspace
// session and every mutation a CA performs on behalf of a client.
// ============================================================

enum ClientPermission {
  VIEW_DASHBOARD
  MANAGE_BANKING
  MANAGE_GST
  MANAGE_TDS
  MANAGE_DOCUMENTS
  MANAGE_PAYROLL
  MANAGE_CONSENTS // explicit grant: CA may create/revoke consents + disconnect accounts
  MANAGE_KYC // explicit grant: CA may complete/edit the client's TBX KYC wizard on their behalf
}

enum ClientActivityAction {
  WORKSPACE_ENTER
  WORKSPACE_EXIT
  WORKSPACE_SWITCH
  VIEW
  CREATE
  UPDATE
  DELETE
  EXPORT
  PERMISSION_DENIED
  ASSIGNMENT_CREATED
  ASSIGNMENT_UPDATED
  ASSIGNMENT_REVOKED
}

model ClientAssignment {
  id             String             @id @default(cuid())
  caUserId       String // CA / CA_FIRM_ADMIN user granted access
  organizationId String // client organization being accessed
  firmId         String? // CA's firm at assignment time (firm-admin scope)
  permissions    ClientPermission[] @default([VIEW_DASHBOARD, MANAGE_BANKING, MANAGE_GST, MANAGE_TDS, MANAGE_DOCUMENTS, MANAGE_PAYROLL])
  isActive       Boolean            @default(true)
  notes          String?
  assignedById   String
  assignedAt     DateTime           @default(now())
  revokedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  caUser       User         @relation("ClientAssignmentCA", fields: [caUserId], references: [id])
  organization Organization @relation("ClientAssignmentOrg", fields: [organizationId], references: [id], onDelete: Cascade)
  assignedBy   User         @relation("ClientAssignmentCreatedBy", fields: [assignedById], references: [id])

  @@unique([caUserId, organizationId])
  @@index([caUserId, isActive])
  @@index([organizationId, isActive])
  @@index([firmId])
  @@map("client_assignments")
}

model ClientActivityLog {
  id             String               @id @default(cuid())
  caUserId       String // acting CA user
  organizationId String // client org acted upon
  action         ClientActivityAction
  method         String? // HTTP method for API mutations
  path           String? // request path / page route
  entity         String? // domain entity (e.g. "sale", "bankTransaction")
  entityId       String?
  summary        String // human-readable description
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime             @default(now())

  caUser       User         @relation("ClientActivityCA", fields: [caUserId], references: [id])
  organization Organization @relation("ClientActivityOrg", fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([caUserId, createdAt])
  @@index([action])
  @@map("client_activity_logs")
}

// ============================================================
