  ledgerBalance    Decimal @default(0) @db.Decimal(16, 2)

  // Flags
  isPrimary Boolean @default(false)
  isActive  Boolean @default(true)
  isVirtual Boolean @default(false)

  // Sync state
  lastSyncAt      DateTime?
  lastSyncStatus  String? // "SUCCESS" | "FAILED" | "PARTIAL"
