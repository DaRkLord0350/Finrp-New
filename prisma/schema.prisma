// ============================================
// FinRP — Prisma Schema
// Multi-tenant SaaS architecture
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ORGANIZATION (Tenant root)
// ============================================================
model Organization {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  plan                Plan     @default(FREE)
  onboardingCompleted Boolean  @default(false)
  enabledModules      String[] @default([])
  createdBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users            User[]
  memberships      Membership[]
  invitations      Invitation[]
  integrations     Integration[]
  importJobs       ImportJob[]
  fieldMappings    FieldMapping[]
  webhookEvents    WebhookEvent[]
  customers        Customer[]
  vendors          Vendor[]
  invoices         Invoice[]
  payments         Payment[]
  complianceTasks             ComplianceTask[]
  businessProfile             BusinessProfile?
  complianceCategories        ComplianceCategory[]
  complianceTypes             ComplianceType[]
  complianceSubmissions       ComplianceSubmission[]
  complianceDocuments         ComplianceDocument[]
  complianceApprovals         ComplianceApproval[]
  complianceReminders         ComplianceReminder[]
  complianceDeadlines         ComplianceDeadline[]
  complianceAuditLogs         ComplianceAuditLog[]
  complianceStatusHistory     ComplianceStatusHistory[]
  analyticsRecords AnalyticsRecord[]
  items            Item[]
  loans            Loan[]
  sales            Sale[]
  purchases        Purchase[]
  expenses         Expense[]
  payroll          Payroll[]
  accounts         Account[]
  journalEntries   JournalEntry[]
  bankAccounts     BankAccount[]
  recurringInvoices RecurringInvoice[]
  leads            Lead[]
  fileUploads      FileUpload[]
  taxRates         TaxRate[]
  employees        Employee[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  settings         Settings?
  subscription     Subscription?

  @@index([slug])
  @@map("organizations")
}

enum Plan {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

// ============================================================
// USER
// ============================================================
model User {
  id                     String   @id @default(cuid())
  clerkId                String   @unique
  email                  String
  name                   String?
  phone                  String?
  role                   Role     @default(STAFF)
  department             String?
  designation            String?
  lastActiveAt           DateTime?
  notificationPreference Json?
  avatarUrl              String?
  isActive               Boolean  @default(true)
  lastLoginAt            DateTime?
  organizationId         String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]
  notifications Notification[]
  memberships Membership[]
  complianceTasks ComplianceTask[] @relation("AssignedTo")
  invoices Invoice[] @relation("InvoiceCreatedBy")
  payments Payment[] @relation("PaymentCreatedBy")
  sales Sale[] @relation("SaleCreatedBy")
  purchases Purchase[] @relation("PurchaseCreatedBy")
  expenses Expense[] @relation("ExpenseCreatedBy")
  journalEntries JournalEntry[] @relation("JournalEntryCreatedBy")
  leads Lead[] @relation("LeadAssignedTo")

  @@index([organizationId])
  @@map("users")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  ACCOUNTANT
  STAFF
  VIEWER
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum EntryType {
  DEBIT
  CREDIT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum FileCategory {
  INVOICE
  RECEIPT
  TAX
  PAYROLL
  LOAN
  COMPLIANCE
  OTHER
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ============================================================
// CUSTOMER
// ============================================================
model Customer {
  id                String       @id @default(cuid())
  customerCode      String?
  name              String
  email             String?
  phone             String?
  company           String?
  address           String?
  city              String?
  state             String?
  country           String?
  gstin             String?
  customerType      CustomerType @default(INDIVIDUAL)
  creditLimit       Decimal      @default(0) @db.Decimal(12, 2)
  outstandingAmount Decimal      @default(0) @db.Decimal(12, 2)
  totalPurchases    Decimal      @default(0) @db.Decimal(16, 2)
  lastPurchaseDate  DateTime?
  customerScore     Int?
  tags              String[]
  notes             String?
  isActive          Boolean      @default(true)
  organizationId    String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     Invoice[]
  sales        Sale[]
  recurringInvoices RecurringInvoice[]
  convertedLeads Lead[] @relation("LeadConversion")

  @@unique([organizationId, customerCode])
  @@index([organizationId, customerType])
  @@index([organizationId])
  @@map("customers")
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
  WHOLESALE
  RETAIL
  GOVERNMENT
}

// ============================================================
// INVOICE
// ============================================================
model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String
  customerId     String
  organizationId String
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  deletedAt      DateTime?
  createdById    String?
  updatedById    String?

  // Amounts
  subtotal       Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  shipping       Decimal       @default(0) @db.Decimal(12, 2)
  taxRate        Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  balanceDue     Decimal       @db.Decimal(12, 2)

  // PDF
  pdfUrl         String?
  pdfFileName    String?
  pdfGeneratedAt DateTime?

  // Metadata
  currency       String        @default("INR")
  notes          String?
  terms          String?
  invoicePdf     String?
  sentAt         DateTime?
  viewedAt       DateTime?
  exchangeRate   Decimal?      @db.Decimal(16, 6)
  baseCurrency   String?       // For multi-currency tracking
  journalEntryId String?       // Link to general ledger
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id])
  createdBy    User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  items        InvoiceItem[]
  payments     Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@index([organizationId, issueDate])
  @@index([organizationId])
  @@index([customerId])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PAID
  PARTIAL
  OVERDUE
  CANCELLED
}

// ============================================================
// INVOICE ITEM
// ============================================================
model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  sku         String?
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  costPrice   Decimal @default(0) @db.Decimal(12, 2)
  taxPercent  Decimal @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  profit      Decimal @default(0) @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

// ============================================================
// PAYMENT
// ============================================================
model Payment {
  id             String        @id @default(cuid())
  invoiceId      String
  organizationId String
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod @default(BANK_TRANSFER)
  reference      String?
  transactionId  String?
  bankName       String?
  paymentGateway String?
  paymentFees    Decimal       @default(0) @db.Decimal(10, 2)
  notes          String?
  paidAt         DateTime      @default(now())
  createdAt      DateTime      @default(now())
  deletedAt      DateTime?
  bankAccountId  String?
  createdById    String?
  journalEntryId String?       // Link to general ledger

  bankAccount BankAccount? @relation("BankAccountPayments", fields: [bankAccountId], references: [id])
  invoice      Invoice      @relation(fields: [invoiceId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([invoiceId])
  @@map("payments")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  UPI
  CHEQUE
  ONLINE
  OTHER
}

// ============================================================
// COMPLIANCE TASK
// ============================================================
model ComplianceTask {
  id             String             @id @default(cuid())
  title          String
  description    String?
  category       TaskCategory @default(OTHER)
  status         TaskStatus         @default(PENDING)
  priority       PriorityLevel      @default(MEDIUM)
  dueDate        DateTime
  reminderDate   DateTime?
  completedAt    DateTime?
  penaltyAmount  Decimal?           @db.Decimal(12, 2)
  documentUrl    String?
  assignedToId   String?
  organizationId String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("AssignedTo", fields: [assignedToId], references: [id])

  @@index([organizationId])
  @@map("compliance_tasks")
}

enum TaskCategory {
  TAX
  GST
  TDS
  REGULATORY
  LICENSE
  AUDIT
  REPORTING
  OTHER
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

// ============================================================
// BUSINESS PROFILE (Extended org details — one-to-one)
// ============================================================
model BusinessProfile {
  id                  String         @id @default(cuid())
  organizationId      String         @unique

  // Identity
  businessName        String
  businessType        String?
  registrationNo      String?
  taxId               String?        // GST / VAT / EIN
  industry            String?
  companySize         String?        // "1-10", "11-50", etc.

  // Location
  country             String?
  state               String?
  city                String?
  address             String?
  pincode             String?

  // Preferences
  currency            String         @default("INR")
  timezone            String         @default("Asia/Kolkata")
  language            String         @default("en")
  fiscalYearStart     DateTime?
  fiscalYearType      FiscalYearType @default(APRIL_MARCH)

  // Financial setup (onboarding)
  initialCapital      Decimal?       @db.Decimal(16, 2)
  openingBankBalance  Decimal?       @db.Decimal(16, 2)
  openingCashBalance  Decimal?       @db.Decimal(16, 2)
  monthlyRevenueEstimate Decimal?    @db.Decimal(16, 2)
  monthlyExpenseEstimate Decimal?    @db.Decimal(16, 2)
  defaultTaxRate      Decimal?       @db.Decimal(5, 2)
  profitMarginTarget  Decimal?       @db.Decimal(5, 2)
  paymentTermsDays    Int            @default(30)
  invoicePrefix       String         @default("INV")
  loanInterestBenchmark Decimal?     @db.Decimal(5, 2)

  // Inventory setup
  inventoryEnabled    Boolean        @default(true)
  warehouseName       String?
  lowStockThreshold   Int            @default(10)
  skuFormat           String?
  unitsUsed           String?

  // Compliance setup
  taxFilingFrequency  String?
  gstFilingDates      String?
  licenseExpiryDates  Json?
  auditSchedule       String?
  payrollTaxEnabled   Boolean        @default(false)

  // Branding
  logoUrl             String?
  website             String?
  contactEmail        String?
  contactPhone        String?

  // Onboarding
  onboardingComplete  Boolean        @default(false)
  onboardingStep      Int            @default(0)

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

enum FiscalYearType {
  APRIL_MARCH     // India
  JANUARY_DECEMBER
  JULY_JUNE
  OCTOBER_SEPTEMBER
}

// ============================================================
// ANALYTICS RECORD
// ============================================================
model AnalyticsRecord {
  id             String   @id @default(cuid())
  organizationId String
  period         String   // e.g. "2025-01", "2025-Q1"
  metric         String   // e.g. "revenue", "invoices_count", "new_customers"
  value          Decimal  @db.Decimal(16, 4)
  metadata       Json?
  recordedAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([period])
  @@index([metric])
  @@map("analytics_records")
}

// ============================================================
// ITEM (Inventory Catalog)
// ============================================================
model Item {
  id             String   @id @default(cuid())
  sku            String?
  barcode        String?
  name           String
  description    String?
  category       String?
  brand          String?
  unit           String?
  image          String?
  batchNumber    String?
  expiryDate     DateTime?
  deletedAt      DateTime?

  // Pricing
  costPrice      Decimal  @default(0) @db.Decimal(12, 2)
  sellingPrice   Decimal  @default(0) @db.Decimal(12, 2)
  taxRate        Decimal  @default(0) @db.Decimal(5, 2)

  // Stock
  stock          Int      @default(0)
  reorderLevel   Int      @default(10)
  lowStockAt     Int      @default(10)

  // Storage
  warehouse      String?

  isActive       Boolean  @default(true)
  organizationId String
  vendorId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor       Vendor?        @relation(fields: [vendorId], references: [id])
  transactions Transaction[]
  saleItems    SaleItem[]
  purchaseItems PurchaseItem[]

  @@unique([organizationId, sku])
  @@index([organizationId, category])
  @@index([organizationId, stock])
  @@index([organizationId])
  @@map("items")
}

// ============================================================
// VENDOR / SUPPLIER
// ============================================================
model Vendor {
  id                String   @id @default(cuid())
  vendorCode        String?       // org-level unique handled separately
  name              String
  contactPerson     String?
  email             String?
  phone             String?
  address           String?
  city              String?
  state             String?
  country           String?
  gstin             String?
  bankName          String?
  bankAccount       String?
  bankIFSC          String?
  outstandingBalance Decimal  @default(0) @db.Decimal(12, 2)
  totalPurchases    Decimal   @default(0) @db.Decimal(16, 2)
  paymentTermsDays  Int       @default(30)
  category          String?
  tags              String[]
  notes             String?
  isActive          Boolean   @default(true)
  organizationId    String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchases    Purchase[]
  items        Item[]

  @@unique([organizationId, vendorCode])
  @@index([organizationId])
  @@map("vendors")
}

// ============================================================
// BUSINESS (Legacy — Clerk-linked onboarding record)
// Keep for backward compatibility, migrate to BusinessProfile
// ============================================================
model Business {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  name      String
  type      String?
  industry  String?
  address   String?
  country   String?
  currency  String   @default("INR")
  taxId     String?
  createdAt DateTime @default(now())

  @@map("businesses")
}

// ============================================================
// DOUBLE ENTRY ACCOUNTING
// ============================================================
model Account {
  id             String      @id @default(cuid())

  organizationId String

  code           String
  name           String

  type           AccountType

  description    String?

  balance        Decimal @default(0) @db.Decimal(16,2)

  isActive       Boolean @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journalLines JournalLine[]
  loans Loan[]

  @@index([organizationId])

  @@unique([organizationId, code])

  @@map("accounts")
  
  expenses Expense[] @relation("ExpensePaymentAccount")
}

model JournalEntry {
  id             String @id @default(cuid())

  organizationId String

  reference      String?
  description    String?

  entryDate      DateTime @default(now())

  totalDebit     Decimal @default(0) @db.Decimal(16,2)

  totalCredit    Decimal @default(0) @db.Decimal(16,2)

  createdById    String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser User? @relation("JournalEntryCreatedBy", fields: [createdById], references: [id])
  lines JournalLine[]

  @@index([organizationId, entryDate])

  @@map("journal_entries")
}

model JournalLine {
  id              String @id @default(cuid())

  journalEntryId  String

  accountId       String

  type            EntryType

  amount          Decimal @db.Decimal(16,2)

  description     String?

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])

  @@index([accountId])

  @@map("journal_lines")
}

// ============================================================
// BANK ACCOUNT
// ============================================================
model BankAccount {
  id               String @id @default(cuid())

  organizationId   String

  accountName      String

  bankName         String

  accountNumber    String

  ifscCode         String?

  swiftCode        String?

  currency         String @default("INR")

  openingBalance   Decimal @default(0) @db.Decimal(16,2)

  currentBalance   Decimal @default(0) @db.Decimal(16,2)

  isPrimary        Boolean @default(false)

  createdAt        DateTime @default(now())

  updatedAt        DateTime @updatedAt

  deletedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments Payment[] @relation("BankAccountPayments")

  @@index([organizationId])

  @@map("bank_accounts")
}

// ============================================================
// LEAD CRM
// ============================================================
model Lead {
  id             String @id @default(cuid())

  organizationId String

  name           String

  email          String?

  phone          String?

  company        String?

  source         String?

  valueEstimate  Decimal? @db.Decimal(12,2)

  status         LeadStatus @default(NEW)

  assignedToId   String?

  notes          String?

  convertedToCustomerId String?

  createdAt      DateTime @default(now())

  updatedAt      DateTime @updatedAt

  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  convertedToCustomer Customer? @relation("LeadConversion", fields: [convertedToCustomerId], references: [id])
  assignedTo User? @relation("LeadAssignedTo", fields: [assignedToId], references: [id])

  @@index([organizationId, status])

  @@map("leads")
}

// ============================================================
// FILE UPLOAD
// ============================================================
model FileUpload {
  id             String @id @default(cuid())

  organizationId String

  fileName       String

  fileUrl        String

  category       FileCategory @default(OTHER)

  entityType     String?

  entityId       String?

  uploadedById   String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([entityType, entityId])
  @@map("file_uploads")
}

// ============================================================
// RECURRING INVOICE
// FIXED CUSTOMER RELATION
// ============================================================
model RecurringInvoice {
  id               String @id @default(cuid())

  organizationId   String

  customerId       String

  frequency        String

  nextRunDate      DateTime

  lastRunDate      DateTime?

  isActive         Boolean @default(true)

  templateData     Json

  createdAt        DateTime @default(now())

  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([organizationId])

  @@map("recurring_invoices")
}

// ============================================================
// GST / TAX RATE
// ============================================================
model TaxRate {
  id             String @id @default(cuid())

  organizationId String

  name           String

  cgst           Decimal @default(0) @db.Decimal(5,2)

  sgst           Decimal @default(0) @db.Decimal(5,2)

  igst           Decimal @default(0) @db.Decimal(5,2)

  cess           Decimal @default(0) @db.Decimal(5,2)

  isActive       Boolean @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("tax_rates")
}

// ============================================================
// NOTIFICATION
// ============================================================
model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String?
  type           NotificationType @default(SYSTEM)
  title          String
  message        String
  referenceId    String?          // id of related record
  referenceType  String?          // "invoice", "loan", "task"
  isRead         Boolean          @default(false)
  readAt         DateTime?
  metadata       Json?            // Structured notification payload
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@map("notifications")
}

enum NotificationType {
  COMPLIANCE_REMINDER
  LOAN_EMI_DUE
  INVOICE_OVERDUE
  LOW_STOCK
  PAYMENT_RECEIVED
  TASK_ASSIGNED
  SYSTEM
}

// ============================================================
// AUDIT LOG
// ============================================================
model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  userId         String?
  action         AuditAction
  entity         String      // "invoice", "customer", "loan", etc.
  entityId       String?
  description    String
  oldValue       Json?
  newValue       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([entity])
  @@map("audit_logs")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  EXPORT
  SETTINGS_CHANGE
}

// ============================================================
// SETTINGS (Per-org feature flags and preferences)
// ============================================================
model Settings {
  id             String  @id @default(cuid())
  organizationId String  @unique

  // Features
  inventoryEnabled    Boolean @default(true)
  payrollEnabled      Boolean @default(true)
  complianceEnabled   Boolean @default(true)
  loanModuleEnabled   Boolean @default(true)
  multiCurrencyEnabled Boolean @default(false)

  // Tax
  defaultTaxRate      Decimal @default(18) @db.Decimal(5, 2)
  taxLabel            String  @default("GST")
  taxRegistered       Boolean @default(false)

  // Invoice
  invoicePrefix       String  @default("INV")
  invoiceStartNumber  Int     @default(1)
  defaultPaymentTerms Int     @default(30)
  invoiceNotes        String?
  invoiceFooter       String?
  showLogo            Boolean @default(true)

  // Notifications
  emailNotifications  Boolean @default(true)
  smsNotifications    Boolean @default(false)
  overdueReminderDays Int     @default(3)
  lowStockThreshold   Int     @default(10)

  // Payroll
  pfPercent           Decimal @default(12) @db.Decimal(5, 2)
  esiPercent          Decimal @default(1.75) @db.Decimal(5, 2)
  tdsPercent          Decimal @default(0) @db.Decimal(5, 2)

  // Misc
  dateFormat          String  @default("DD/MM/YYYY")
  numberFormat        String  @default("en-IN")
  metadata            Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("settings")
}

// ============================================================
// SUBSCRIPTION (SaaS billing)
// ============================================================
model Subscription {
  id             String    @id @default(cuid())
  organizationId String    @unique
  plan           Plan      @default(FREE)
  status         String    @default("active") // active, cancelled, expired, trialing
  stripeCustomerId String?
  stripeSubscriptionId String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean  @default(false)
  trialEndsAt        DateTime?
  priceId          String?
  amount           Decimal?  @db.Decimal(10, 2)
  currency         String    @default("USD")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ============================================================
// MULTI CURRENCY
// ============================================================
model ExchangeRate {
  id              String @id @default(cuid())

  baseCurrency    String

  targetCurrency  String

  rate            Decimal @db.Decimal(16,6)

  fetchedAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([baseCurrency, targetCurrency])

  @@map("exchange_rates")
}

// ============================================================
// TRANSACTION (Inventory movement — sale or restock)
// ============================================================
model Transaction {
  id             String          @id @default(cuid())
  itemId         String
  organizationId String
  type           TransactionType
  quantity       Int
  beforeStock    Int?
  afterStock     Int?
  referenceId    String?         // sale / purchase / invoice id
  note           String?
  createdAt      DateTime        @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([organizationId])
  @@map("transactions")
}

enum TransactionType {
  SALE
  RESTOCK
  ADJUSTMENT
  RETURN
  TRANSFER
}



// ============================================================
// LOAN
// ============================================================
model Loan {
  id                String     @id @default(cuid())
  organizationId    String
  loanNumber        String?
  loanType          String     // "Working Capital", "Equipment", "Term Loan"
  lenderType        LenderType @default(BANK)
  bank              String
  loanAmount        Decimal    @db.Decimal(16, 2)
  principalAmount   Decimal    @db.Decimal(16, 2)
  approvedAmount    Decimal?   @db.Decimal(16, 2)
  disbursedAmount   Decimal?   @db.Decimal(16, 2)
  remainingBalance  Decimal?   @db.Decimal(16, 2)
  interestRate      Decimal    @default(0) @db.Decimal(5, 2)
  tenure            Int        // months
  monthlyEMI        Decimal    @default(0) @db.Decimal(12, 2)
  processingFee     Decimal    @default(0) @db.Decimal(10, 2)
  collateral        String?
  cibilScore        Int?
  status            LoanStatus @default(PENDING)
  processingStatus  String?
  overdueEMI        Int        @default(0)
  applicationDate   DateTime   @default(now())
  approvalDate      DateTime?
  startDate         DateTime?
  endDate           DateTime?
  notes             String?
  deletedAt         DateTime?
  accountId         String?
  journalEntryId    String?       // Link to general ledger
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments     LoanPayment[]
  account      Account?       @relation(fields: [accountId], references: [id])

  @@unique([organizationId, loanNumber])
  @@index([organizationId])
  @@map("loans")
}

enum LoanStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  ACTIVE
  COMPLETED
  REJECTED
  DEFAULTED
}

enum LenderType {
  BANK
  NBFC
  GOVERNMENT
  PRIVATE
  MICROFINANCE
}

// ============================================================
// LOAN PAYMENT (EMI tracking)
// ============================================================
model LoanPayment {
  id          String        @id @default(cuid())
  loanId      String
  emiNumber   Int?
  amount      Decimal       @db.Decimal(12, 2)
  principal   Decimal       @default(0) @db.Decimal(12, 2)
  interest    Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount  Decimal       @default(0) @db.Decimal(12, 2)
  dueDate     DateTime
  paidDate    DateTime?
  status      PaymentStatus @default(PENDING)
  method      PaymentMethod?
  reference   String?
  notes       String?
  createdAt   DateTime      @default(now())

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@map("loan_payments")
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  PARTIAL
}

// ============================================================
// SALE (ERP — Sales tracking)
// ============================================================
model Sale {
  id             String        @id @default(cuid())
  saleNumber     String
  customerId     String?
  organizationId String
  totalAmount    Decimal       @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  profit         Decimal       @default(0) @db.Decimal(12, 2)
  status         SaleStatus    @default(COMPLETED)
  paymentStatus  PaymentStatus @default(PAID)
  paymentMethod  PaymentMethod @default(CASH)
  salesperson    String?
  channel        String?
  notes          String?
  journalEntryId String?       // Link to general ledger
  saleDate       DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  createdById    String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id])
  createdBy    User?        @relation("SaleCreatedBy", fields: [createdById], references: [id])
  items        SaleItem[]

  @@unique([organizationId, saleNumber])
  @@index([organizationId, saleDate])
  @@index([organizationId])
  @@map("sales")
}

enum SaleStatus {
  COMPLETED
  PENDING
  RETURNED
  CANCELLED
}

// ============================================================
// SALE ITEM (ERP — Sale line items)
// ============================================================
model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  itemId      String?
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  costPrice   Decimal @default(0) @db.Decimal(12, 2)
  taxPercent  Decimal @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  profit      Decimal @default(0) @db.Decimal(12, 2)

  sale Sale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item Item? @relation(fields: [itemId], references: [id])

  @@index([saleId])
  @@map("sale_items")
}

// ============================================================
// PURCHASE (ERP — Procurement)
// ============================================================
model Purchase {
  id               String         @id @default(cuid())
  purchaseNumber   String
  vendorId         String?
  vendorName       String?        // fallback if no vendor record
  organizationId   String
  totalAmount      Decimal        @db.Decimal(12, 2)
  taxAmount        Decimal        @default(0) @db.Decimal(12, 2)
  shippingCost     Decimal        @default(0) @db.Decimal(12, 2)
  status           PurchaseStatus @default(ORDERED)
  purchaseType     String?        // "goods", "services"
  paymentStatus    PaymentStatus  @default(PENDING)
  paymentMethod    PaymentMethod?
  reference        String?
  expectedDelivery DateTime?
  deletedAt        DateTime?
  createdById      String?
  deliveredAt      DateTime?
  notes            String?
  journalEntryId   String?       // Link to general ledger
  purchaseDate     DateTime       @default(now())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor       Vendor?        @relation(fields: [vendorId], references: [id])
  createdBy    User?          @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  items        PurchaseItem[]

  @@unique([organizationId, purchaseNumber])
  @@index([organizationId, purchaseDate])
  @@index([organizationId])
  @@map("purchases")
}

enum PurchaseStatus {
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

// ============================================================
// PURCHASE ITEM
// ============================================================
model PurchaseItem {
  id          String  @id @default(cuid())
  purchaseId  String
  itemId      String?
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitCost    Decimal @db.Decimal(12, 2)
  taxPercent  Decimal @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item     Item?    @relation(fields: [itemId], references: [id])

  @@index([purchaseId])
  @@map("purchase_items")
}

// ============================================================
// EXPENSE (Operational expenses)
// ============================================================
model Expense {
  id                  String          @id @default(cuid())
  category            ExpenseCategory @default(OPERATIONS)
  description         String
  amount              Decimal         @db.Decimal(12, 2)
  organizationId      String
  vendorName          String?
  department          String?
  approvedBy          String?
  receiptUrl          String?
  recurring           Boolean         @default(false)
  recurringFrequency  String?         // "monthly", "weekly", "yearly"
  taxAmount           Decimal         @default(0) @db.Decimal(12, 2)
  notes               String?
  expenseDate         DateTime        @default(now())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?
  createdById         String?
  paymentAccountId    String?
  journalEntryId      String?         // Link to general ledger

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy User? @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  paymentAccount Account? @relation("ExpensePaymentAccount", fields: [paymentAccountId], references: [id])
  
  @@index([organizationId, expenseDate])
  @@index([organizationId])
  @@map("expenses")
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARIES
  MARKETING
  TRAVEL
  SOFTWARE
  EQUIPMENT
  LOGISTICS
  MAINTENANCE
  OPERATIONS
  TAXES
  OTHER
}

// ============================================================
// EMPLOYEE
// ============================================================
model Employee {
  id               String         @id @default(cuid())
  employeeCode     String?
  name             String
  email            String?
  phone            String?
  designation      String?
  department       String?
  employmentType   EmploymentType @default(FULL_TIME)
  joiningDate      DateTime?
  resignationDate  DateTime?
  baseSalary       Decimal        @db.Decimal(12, 2)
  hra              Decimal        @default(0) @db.Decimal(12, 2)
  pf               Decimal        @default(0) @db.Decimal(10, 2)
  esi              Decimal        @default(0) @db.Decimal(10, 2)
  bankAccount      String?
  bankName         String?
  panNumber        String?
  aadharNumber     String?
  address          String?
  emergencyContact String?
  avatarUrl        String?
  isActive         Boolean        @default(true)
  organizationId   String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payroll      Payroll[]

  @@unique([organizationId, employeeCode])
  @@index([organizationId])
  @@map("employees")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  CONSULTANT
  INTERN
}

// ============================================================
// PAYROLL (Employee payroll records)
// ============================================================
model Payroll {
  id              String   @id @default(cuid())
  employeeId      String?
  employeeName    String
  designation     String?
  department      String?
  organizationId  String
  payPeriod       String   // e.g. "2026-04"
  payPeriodStart  DateTime?
  payPeriodEnd    DateTime?

  // Earnings
  baseSalary      Decimal  @db.Decimal(12, 2)
  hra             Decimal  @default(0) @db.Decimal(12, 2)
  bonus           Decimal  @default(0) @db.Decimal(12, 2)
  overtime        Decimal  @default(0) @db.Decimal(12, 2)
  allowances      Decimal  @default(0) @db.Decimal(12, 2)
  grossPay        Decimal  @db.Decimal(12, 2)

  // Deductions
  pf              Decimal  @default(0) @db.Decimal(12, 2)
  esi             Decimal  @default(0) @db.Decimal(12, 2)
  tax             Decimal  @default(0) @db.Decimal(12, 2)
  otherDeductions Decimal  @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal  @db.Decimal(12, 2)

  // Summary
  netPay          Decimal  @db.Decimal(12, 2)
  attendanceDays  Int?
  leaveDays       Int?
  paymentMethod   PaymentMethod @default(BANK_TRANSFER)
  paidAt          DateTime @default(now())
  notes           String?
  journalEntryId  String?       // Link to general ledger
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee?    @relation(fields: [employeeId], references: [id])

  @@index([organizationId])
  @@map("payroll")
}

// ============================================================
// MEMBERSHIP (User ↔ Organization many-to-many with roles)
// Complements User.role for multi-org and invite flow support.
// ============================================================
model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role
  invitedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

// ============================================================
// INVITATION (Pending team invites)
// ============================================================
model Invitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           Role
  token          String   @unique @default(cuid())
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedBy      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

// ============================================================
// =================== INTEGRATION PLATFORM ===================
// ============================================================

// ============================================================
// INTEGRATION (Connector connection record — one per provider)
// ============================================================
model Integration {
  id               String            @id @default(cuid())
  organizationId   String
  type             ConnectorType
  name             String
  status           IntegrationStatus @default(INACTIVE)
  config           Json?             // non-sensitive config (data center, server URL, etc.)
  lastSyncAt       DateTime?
  lastSyncStatus   SyncJobStatus?
  lastSyncError    String?
  syncIntervalMins Int               @default(60)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  oauthToken    OAuthToken?
  syncJobs      SyncJob[]
  importJobs    ImportJob[]
  fieldMappings FieldMapping[]
  webhookEvents WebhookEvent[]

  @@unique([organizationId, type])
  @@index([organizationId])
  @@map("integrations")
}

enum ConnectorType {
  ZOHO_CRM
  ZOHO_BOOKS
  ZOHO_INVENTORY
  TALLY
  ODOO
  CSV
  EXCEL
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
  ERROR
  PENDING_AUTH
  EXPIRED
  SYNCING
}

// ============================================================
// OAUTH TOKEN (encrypted at rest — AES-256-GCM)
// ============================================================
model OAuthToken {
  id             String    @id @default(cuid())
  integrationId  String    @unique
  organizationId String
  accessToken    String    // AES-256-GCM encrypted ciphertext
  refreshToken   String?   // AES-256-GCM encrypted ciphertext
  tokenType      String    @default("Bearer")
  scope          String?
  expiresAt      DateTime?
  grantedScopes  String[]
  accountId      String?   // Zoho accountId / Odoo dbname
  serverUrl      String?   // Odoo instance URL
  metadata       Json?     // provider-specific data
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("oauth_tokens")
}

// ============================================================
// SYNC JOB (background connector sync run)
// ============================================================
model SyncJob {
  id               String        @id @default(cuid())
  organizationId   String
  integrationId    String
  type             SyncJobType
  entity           String?       // "customers" | "invoices" | "products" | "all"
  status           SyncJobStatus @default(QUEUED)
  bullmqJobId      String?
  startedAt        DateTime?
  completedAt      DateTime?
  totalRecords     Int           @default(0)
  processedRecords Int           @default(0)
  successRecords   Int           @default(0)
  failedRecords    Int           @default(0)
  lastCursor       String?       // incremental sync cursor (ISO date or page token)
  scheduledAt      DateTime?
  triggeredBy      String?       // userId who triggered
  error            String?
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  logs         SyncLog[]

  @@index([integrationId, status])
  @@index([organizationId, status])
  @@map("sync_jobs")
}

enum SyncJobType {
  FULL
  INCREMENTAL
  ENTITY_SPECIFIC
  TRIGGERED
  SCHEDULED
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  PAUSED
}

// ============================================================
// SYNC LOG (per-record audit trail)
// ============================================================
model SyncLog {
  id         String     @id @default(cuid())
  syncJobId  String
  entityType String
  entityId   String?    // our DB record id
  externalId String?    // source system id
  action     SyncAction
  status     SyncLogStatus @default(SUCCESS)
  data       Json?
  error      String?
  durationMs Int?
  createdAt  DateTime   @default(now())

  syncJob SyncJob @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@index([syncJobId])
  @@index([entityType, entityId])
  @@map("sync_logs")
}

enum SyncAction {
  CREATE
  UPDATE
  SKIP
  DELETE
  MERGE
  ERROR
}

enum SyncLogStatus {
  SUCCESS
  FAILED
  SKIPPED
  WARNING
}

// ============================================================
// IMPORT JOB (CSV/Excel file import)
// ============================================================
model ImportJob {
  id             String       @id @default(cuid())
  organizationId String
  integrationId  String?
  type           ImportType
  entity         ImportEntity
  status         ImportStatus @default(PENDING)
  bullmqJobId    String?
  fileName       String
  originalName   String
  fileSize       Int
  filePath       String       // local tmp path or cloud URL
  mimeType       String
  totalRows      Int          @default(0)
  processedRows  Int          @default(0)
  successRows    Int          @default(0)
  failedRows     Int          @default(0)
  skippedRows    Int          @default(0)
  duplicateRows  Int          @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  uploadedById   String
  fieldMapping   Json?        // saved column → field mappings
  options        Json?        // { skipDuplicates, updateExisting, dryRun }
  detectedColumns String[]    // detected CSV headers
  errorFilePath  String?      // downloadable error CSV path
  error          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration?  @relation(fields: [integrationId], references: [id])
  rows         ImportRow[]
  errors       ImportError[]

  @@index([organizationId, status])
  @@index([organizationId, entity])
  @@map("import_jobs")
}

enum ImportType {
  CSV
  EXCEL
  JSON
  XML
}

enum ImportEntity {
  CUSTOMERS
  VENDORS
  INVOICES
  PRODUCTS
  EMPLOYEES
  EXPENSES
  PAYMENTS
  LEADS
}

enum ImportStatus {
  PENDING
  MAPPING
  VALIDATING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  PARTIAL
}

// ============================================================
// IMPORT ROW (staging table — one row per source record)
// ============================================================
model ImportRow {
  id           String    @id @default(cuid())
  importJobId  String
  rowIndex     Int
  rawData      Json      // original CSV row as key-value
  mappedData   Json?     // after field mapping applied
  normalizedData Json?   // after normalization (GST, dates, etc.)
  status       RowStatus @default(PENDING)
  isDuplicate  Boolean   @default(false)
  mergedIntoId String?   // entityId it was merged into
  entityId     String?   // created/updated entity id
  error        String?
  warnings     String[]
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  importJob ImportJob    @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  errors    ImportError[]

  @@index([importJobId, status])
  @@index([importJobId, rowIndex])
  @@map("import_rows")
}

enum RowStatus {
  PENDING
  SUCCESS
  FAILED
  SKIPPED
  DUPLICATE
  MERGED
}

// ============================================================
// IMPORT ERROR (validation and processing errors)
// ============================================================
model ImportError {
  id          String        @id @default(cuid())
  importJobId String
  importRowId String?
  rowIndex    Int?
  field       String?
  errorCode   String
  message     String
  value       String?       // the value that caused the error
  severity    ErrorSeverity @default(ERROR)
  createdAt   DateTime      @default(now())

  importJob ImportJob  @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  importRow ImportRow? @relation(fields: [importRowId], references: [id])

  @@index([importJobId])
  @@index([importRowId])
  @@map("import_errors")
}

enum ErrorSeverity {
  ERROR
  WARNING
  INFO
}

// ============================================================
// FIELD MAPPING (saved reusable column mapping templates)
// ============================================================
model FieldMapping {
  id             String       @id @default(cuid())
  organizationId String
  integrationId  String?
  name           String
  entity         ImportEntity
  sourceType     ConnectorType
  mappings       Json         // MappingRule[] — see connector types
  isDefault      Boolean      @default(false)
  useCount       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration?  @relation(fields: [integrationId], references: [id])

  @@index([organizationId, entity])
  @@map("field_mappings")
}

// ============================================================
// WEBHOOK EVENT (inbound webhooks from Zoho, etc.)
// ============================================================
model WebhookEvent {
  id             String        @id @default(cuid())
  organizationId String
  integrationId  String
  source         ConnectorType
  eventType      String
  externalId     String?       // provider event id (for dedup)
  payload        Json
  rawPayload     String?       // raw body for signature verify
  signature      String?
  status         WebhookStatus @default(PENDING)
  bullmqJobId    String?
  processedAt    DateTime?
  error          String?
  retryCount     Int           @default(0)
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([externalId])
  @@map("webhook_events")
}

enum WebhookStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

// ============================================================
// INVOICE COUNTER (Atomic sequence for collision-safe numbering)
// ============================================================
model InvoiceCounter {
  id             String @id @default(cuid())
  organizationId String
  year           Int
  lastNumber     Int    @default(0)

  @@unique([organizationId, year])
  @@index([organizationId])
  @@map("invoice_counters")
}

// ============================================================
// =============== COMPLIANCE MANAGEMENT MODULE ===============
// ============================================================

enum ComplianceStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  PENDING_RENEWAL
}

enum ComplianceApprovalAction {
  APPROVE
  REJECT
  REQUEST_CHANGES
  ESCALATE
}

enum ComplianceReminderType {
  DUE_DATE
  EXPIRY
  PENDING_APPROVAL
  REJECTED_FOLLOW_UP
  RENEWAL
  CUSTOM
}

// ============================================================
// COMPLIANCE CATEGORY (dynamic, org-scoped categories)
// ============================================================
model ComplianceCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  code           String
  color          String   @default("#6366f1")
  icon           String   @default("ShieldCheck")
  isActive       Boolean  @default(true)
  isSystem       Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  types        ComplianceType[]
  submissions  ComplianceSubmission[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("compliance_categories")
}

// ============================================================
// COMPLIANCE TYPE (sub-types within categories)
// ============================================================
model ComplianceType {
  id                String   @id @default(cuid())
  organizationId    String
  categoryId        String
  name              String
  description       String?
  code              String
  requiredDocuments String[]
  validityDays      Int?
  defaultPenalty    Decimal? @db.Decimal(12, 2)
  isActive          Boolean  @default(true)
  isSystem          Boolean  @default(false)
  sortOrder         Int      @default(0)
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     ComplianceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  submissions  ComplianceSubmission[]

  @@unique([organizationId, categoryId, code])
  @@index([organizationId, categoryId])
  @@map("compliance_types")
}

// ============================================================
// COMPLIANCE DOCUMENT (PostgreSQL BYTEA binary storage)
// Binary data excluded from listing queries — fetched on demand
// ============================================================
model ComplianceDocument {
  id             String   @id @default(cuid())
  organizationId String
  submissionId   String?

  fileName       String
  fileExtension  String
  mimeType       String
  fileSize       Int
  checksum       String

  binaryData     Bytes

  version        Int      @default(1)
  isLatest       Boolean  @default(true)
  documentType   String?
  description    String?

  uploadedById   String?
  uploadedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submission   ComplianceSubmission?  @relation(fields: [submissionId], references: [id])

  @@index([organizationId])
  @@index([submissionId])
  @@map("compliance_documents")
}

// ============================================================
// COMPLIANCE SUBMISSION (core compliance lifecycle record)
// ============================================================
model ComplianceSubmission {
  id              String           @id @default(cuid())
  organizationId  String
  categoryId      String
  typeId          String?

  title           String
  description     String?
  referenceNumber String?

  status          ComplianceStatus @default(DRAFT)

  submissionDate  DateTime?
  effectiveDate   DateTime?
  expiryDate      DateTime?
  dueDate         DateTime?
  renewalDate     DateTime?

  penaltyAmount   Decimal?         @db.Decimal(12, 2)
  feeAmount       Decimal?         @db.Decimal(12, 2)

  assignedToId    String?
  reviewedById    String?

  complianceData  Json?

  version         Int              @default(1)
  tags            String[]
  notes           String?

  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       ComplianceCategory        @relation(fields: [categoryId], references: [id])
  type           ComplianceType?           @relation(fields: [typeId], references: [id])
  documents      ComplianceDocument[]
  approvals      ComplianceApproval[]
  reminders      ComplianceReminder[]
  statusHistory  ComplianceStatusHistory[]
  deadlines      ComplianceDeadline[]
  auditLogs      ComplianceAuditLog[]

  @@index([organizationId, status])
  @@index([organizationId, categoryId])
  @@index([organizationId, dueDate])
  @@index([organizationId, expiryDate])
  @@index([organizationId, deletedAt])
  @@map("compliance_submissions")
}

// ============================================================
// COMPLIANCE APPROVAL (approve/reject/escalate workflow)
// ============================================================
model ComplianceApproval {
  id             String                   @id @default(cuid())
  organizationId String
  submissionId   String

  action         ComplianceApprovalAction
  comments       String?
  conditions     String?

  approvedById   String?
  approvedAt     DateTime                 @default(now())

  createdAt      DateTime                 @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submission   ComplianceSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([submissionId])
  @@map("compliance_approvals")
}

// ============================================================
// COMPLIANCE REMINDER (automated reminders for deadlines/expiry)
// ============================================================
model ComplianceReminder {
  id             String                 @id @default(cuid())
  organizationId String
  submissionId   String?

  type           ComplianceReminderType
  title          String
  message        String?

  reminderDate   DateTime
  isTriggered    Boolean                @default(false)
  triggeredAt    DateTime?

  assignedToId   String?
  isActive       Boolean                @default(true)

  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submission   ComplianceSubmission?  @relation(fields: [submissionId], references: [id])

  @@index([organizationId])
  @@index([reminderDate, isTriggered, isActive])
  @@map("compliance_reminders")
}

// ============================================================
// COMPLIANCE DEADLINE (deadline tracking with penalty rates)
// ============================================================
model ComplianceDeadline {
  id              String   @id @default(cuid())
  organizationId  String
  submissionId    String?

  title           String
  description     String?
  deadlineDate    DateTime
  gracePeriodDays Int      @default(0)

  isCompleted     Boolean  @default(false)
  completedAt     DateTime?

  penaltyPerDay   Decimal? @db.Decimal(10, 2)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submission   ComplianceSubmission?  @relation(fields: [submissionId], references: [id])

  @@index([organizationId])
  @@index([deadlineDate, isCompleted])
  @@map("compliance_deadlines")
}

// ============================================================
// COMPLIANCE AUDIT LOG (compliance-specific event trail)
// ============================================================
model ComplianceAuditLog {
  id             String   @id @default(cuid())
  organizationId String
  submissionId   String?

  action         String
  description    String

  performedById  String?
  oldValue       Json?
  newValue       Json?

  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submission   ComplianceSubmission?  @relation(fields: [submissionId], references: [id])

  @@index([organizationId])
  @@index([submissionId])
  @@map("compliance_audit_logs")
}

// ============================================================
// COMPLIANCE STATUS HISTORY (immutable status change trail)
// ============================================================
model ComplianceStatusHistory {
  id             String            @id @default(cuid())
  organizationId String
  submissionId   String

  fromStatus     ComplianceStatus?
  toStatus       ComplianceStatus

  reason         String?
  comments       String?

  changedById    String?
  changedAt      DateTime          @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submission   ComplianceSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([organizationId])
  @@map("compliance_status_history")
}
