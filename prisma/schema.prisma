// ============================================================
// Modules 4 + 5 + part of 1 — unified related-person registry.
// Unifies "Authorized Signatories" (Module 4) + "Directors /
// Partners / Proprietors / LLP Members / Beneficial Owners"
// (Module 5) + "Authorized Contacts" (Module 1) into ONE table
// instead of three near-duplicate ones — a real person is very
// often more than one of these at once, and the fields overlap
// heavily (name/PAN/verification status). See docs/TBX_FOUNDATION
// .md §15 #1.
//
// No point-in-time history on `roles` — overwriting it loses "who
// was a director as of date X." Accepted for Phase 1: reconstruction
// relies on AuditLog old/new-value diffs on every roles[] change,
// not a dedicated history table. Deliberate limitation, not an
// oversight — see §13 Risk 4.
// ============================================================
enum PartyRole {
  DIRECTOR
  PARTNER
  PROPRIETOR
  LLP_MEMBER
  BENEFICIAL_OWNER
  AUTHORIZED_SIGNATORY
  AUTHORIZED_CONTACT
}

model OrganizationRelatedParty {
  id             String      @id @default(cuid())
  organizationId String
  roles          PartyRole[]

  name  String
  email String?
  phone String?

  pan                   String?
  panVerificationStatus TbxVerificationStatus @default(NOT_STARTED)
  aadhaarLast4          String? // last 4 digits only — full number is never persisted
  aadhaarHash           String? // salted hash, dedupe-matching only

  din                 String? // director-only (MCA Director Identification Number)
  shareholdingPercent Decimal? @db.Decimal(5, 2) // director / beneficial-owner
  designation         String?
  isPrimarySignatory  Boolean  @default(false) // true = Primary, false = Secondary (signatory roles only)

  addressLine String?
  city        String?
  state       String?
  country     String?
  pincode     String?

  verificationStatus TbxVerificationStatus @default(NOT_STARTED)
  tbxVerificationRef String?
  notes              String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, pan])
  @@map("organization_related_parties")
}

// ============================================================
// Module 6 — Bank Account Linking. Satellite off the EXISTING
// BankAccount (Banking OS), mirroring the BankSyncHistory /
// BankBalance satellite pattern already used there. Does NOT
// duplicate BankAccount — TBX's ongoing balance/statement sync is
// architecturally unrelated to this one-off identity/ownership
// verification. Carries organizationId directly (not just via the
// bankAccountId join) so it can be tenant-filtered without a join,
// matching its siblings.
// ============================================================
enum BankVerificationMethod {
  PENNY_DROP
  PENNILESS_BAV
}

model OrgBankAccountVerification {
  id             String @id @default(cuid())
  organizationId String
  bankAccountId  String

  verificationMethod        BankVerificationMethod
  verificationStatus        TbxVerificationStatus  @default(NOT_STARTED)
  verifiedAccountHolderName String?
  nameMatchScore            Int? // 0-100
  tbxReferenceId            String?
  failureReason             String?
  verifiedAt                DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount  BankAccount  @relation("BankAccountVerifications", fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([bankAccountId])
  @@map("org_bank_account_verifications")
}

// ============================================================
// PHASE 3 — MODULE 1: LENDING PLATFORM (Loan Origination System)
//
// Naming note: an existing `Loan` / `LoanPayment` model (see the LOAN
// section above) already tracks an organization's OWN borrowings —
// bank/NBFC lender, EMI bookkeeping for the org's own accounting. That
// is a different domain and is untouched here. In THIS module the
// Organization IS the lender, originating loans TO its own CRM
// `Customer` records. To avoid colliding with the existing `Loan` /
// `LoanStatus` names, the pre-disbursement workflow entity is
// `LoanApplication` and the post-disbursement active loan is
// `LoanAccount`.
//
// Workflow (LoanApplicationStage), matching the spec's pipeline:
//   APPLICATION → DOCUMENT_COLLECTION → VERIFICATION → CREDIT_BUREAU →
//   AML → FRAUD → RISK_SCORE → APPROVAL_MATRIX → SANCTION → AGREEMENT →
//   DISBURSEMENT → REPAYMENT → MONITORING
// Mirrors lib/tax/filing/service.ts's state-machine shape: current
// stage/status live on LoanApplication, every transition is appended
// as an immutable LoanApplicationLog row (payload-hashed, actor-
// attributed) — no return/decision reaches disbursement without a
// full audit trail.
//
// Reuse, not duplication:
//   - KYC gate            → existing KycProfile / requireTenant({ requireKyc })
//   - Identity/bank/AML-PEP verification → existing lib/tbx/service.ts
//     (verifyPan, verifyGstin, verifyAadhaar, verifyBankAccount,
//     fetchDirector, fetchCkyc, screenAmlPep)
//   - eSign                → existing SignatureRequest / SignatureEvent
//   - Disbursement / auto-debit collection → existing lib/tbx/payments/
//   - Bank account linkage → existing BankAccount (Banking OS)
//   - Audit trail          → existing lib/audit.ts createAuditLog
// ============================================================

