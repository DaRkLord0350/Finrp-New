// ============================================================
// DOUBLE ENTRY ACCOUNTING
// ============================================================
model Account {
  id String @id @default(cuid())

  organizationId String

  code String
  name String

  type           AccountType
  accountSubType String?

  description String?

  // Running ledger balance (debit/credit-normalized per `type`).
  // Exposed to API/service consumers as `currentBalance`.
  balance        Decimal @default(0) @db.Decimal(16, 2)
  openingBalance Decimal @default(0) @db.Decimal(16, 2)

  isActive          Boolean @default(true)
  isSystemGenerated Boolean @default(false)

  parentAccountId String?
  parentAccount   Account?  @relation("AccountHierarchy", fields: [parentAccountId], references: [id], onDelete: SetNull)
  children        Account[] @relation("AccountHierarchy")

  createdBy String?
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journalLines JournalLine[]
  loans        Loan[]
  budgetLines  BudgetLine[]

  expenses Expense[] @relation("ExpensePaymentAccount")

  // Source-document account references (used by Bulk Account Update + posting)
  invoiceIncomeLinks       Invoice[]      @relation("InvoiceIncomeAccount")
  invoiceItemIncomeLinks   InvoiceItem[]  @relation("InvoiceItemIncomeAccount")
  paymentDepositLinks      Payment[]      @relation("PaymentDepositAccount")
  purchaseExpenseLinks     Purchase[]     @relation("PurchaseExpenseAccount")
  purchaseItemExpenseLinks PurchaseItem[] @relation("PurchaseItemExpenseAccount")
  vendorPayableLinks       Vendor[]       @relation("VendorPayableAccount")
  creditNoteLinks          CreditNote[]   @relation("CreditNoteAccount")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, type])
  @@index([organizationId, isActive])
  @@index([parentAccountId])
  @@map("accounts")
}

enum JournalStatus {
  DRAFT
  POSTED
  VOID
}

enum JournalType {
  MANUAL
  SYSTEM
  OPENING
  CLOSING
  FOREX
  ADJUSTMENT
}

model JournalEntry {
  id String @id @default(cuid())

  organizationId String

  // Human-facing sequence number (e.g. JN-2026-000001) — manual/posted entries.
  journalNumber String?

  status      JournalStatus @default(POSTED)
  journalType JournalType   @default(MANUAL)

  reference   String?
  description String?

  // Origin of the entry for system/integration postings (INVOICE/PAYMENT/EXPENSE/BANK/…).
  source   String?
  sourceId String?

  entryDate DateTime @default(now())

  // Multi-currency: amounts are stored in base currency; these document the source rate.
  currency     String  @default("INR")
  exchangeRate Decimal @default(1) @db.Decimal(18, 8)

  notes String?

  totalDebit Decimal @default(0) @db.Decimal(16, 2)

  totalCredit Decimal @default(0) @db.Decimal(16, 2)

  createdById String?
  postedById  String?
  postedAt    DateTime?

  // Reversal linkage — a VOID/reversing entry points back at the original.
  reversalOfId String?

  // Fiscal period the entry posts into (resolved at post time).
  fiscalYearId   String?
  fiscalPeriodId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser User?          @relation("JournalEntryCreatedBy", fields: [createdById], references: [id])
  postedByUser  User?          @relation("JournalEntryPostedBy", fields: [postedById], references: [id])
  reversalOf    JournalEntry?  @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversals     JournalEntry[] @relation("JournalReversal")
  fiscalYear    FiscalYear?    @relation(fields: [fiscalYearId], references: [id])
  fiscalPeriod  FiscalPeriod?  @relation(fields: [fiscalPeriodId], references: [id])
  lines         JournalLine[]

  @@unique([organizationId, journalNumber])
  @@index([organizationId, entryDate])
  @@index([organizationId, status])
  @@index([organizationId, journalType])
  @@index([organizationId, source, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id String @id @default(cuid())

  journalEntryId String

  accountId String

  type EntryType

  amount Decimal @db.Decimal(16, 2)

  description String?

  lineOrder Int @default(0)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

model JournalNumberCounter {
  id String @id @default(cuid())

  organizationId String
  prefix         String
  year           Int
  lastNumber     Int    @default(0)

  updatedAt DateTime @updatedAt

  @@unique([organizationId, prefix, year])
  @@map("journal_number_counters")
}

// ============================================================
// FISCAL YEARS, PERIODS & ACCOUNTING SETTINGS
// ============================================================
enum FiscalYearStatus {
  OPEN
  CLOSED
}

enum FiscalPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

model FiscalYear {
  id String @id @default(cuid())

  organizationId String

  name      String // e.g. "FY 2026-27"
  startDate DateTime
  endDate   DateTime

  status FiscalYearStatus @default(OPEN)

  closedAt    DateTime?
  closedById  String?
  // Journal entries created by the year-end close (closing + opening).
  closingJournalId String?
  openingJournalId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  periods      FiscalPeriod[]
  journals     JournalEntry[]
  budgets      Budget[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@map("fiscal_years")
}

model FiscalPeriod {
  id String @id @default(cuid())

  organizationId String
  fiscalYearId   String

  name         String // e.g. "Apr 2026"
  periodNumber Int
  startDate    DateTime
  endDate      DateTime

  status FiscalPeriodStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fiscalYear   FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  journals     JournalEntry[]

  @@unique([fiscalYearId, periodNumber])
  @@index([organizationId, startDate, endDate])
  @@map("fiscal_periods")
}

model AccountingSettings {
  id String @id @default(cuid())

  organizationId String @unique

  baseCurrency String @default("INR")

  // Transaction locking — postings on/before this date are blocked
  // unless the actor holds `accounting.manage`.
  lockDate   DateTime?
  lockReason String?

  // System account mappings used by closing / forex / rounding postings.
  retainedEarningsAccountId String?
  forexGainLossAccountId    String?
  roundingAccountId         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("accounting_settings")
}

// ============================================================
// BUDGETS
// ============================================================
enum BudgetGranularity {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum BudgetStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Budget {
  id String @id @default(cuid())

  organizationId String
  fiscalYearId   String

  name        String
  granularity BudgetGranularity @default(MONTHLY)
  status      BudgetStatus      @default(DRAFT)

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fiscalYear   FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  lines        BudgetLine[]

  @@unique([organizationId, fiscalYearId, name])
  @@index([organizationId, status])
  @@map("budgets")
}

model BudgetLine {
  id String @id @default(cuid())

  budgetId    String
  accountId   String
  periodIndex Int // 0-based; 0-11 monthly, 0-3 quarterly, 0 yearly
  amount      Decimal @default(0) @db.Decimal(16, 2)

  budget  Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id])

  @@unique([budgetId, accountId, periodIndex])
  @@index([budgetId])
  @@index([accountId])
  @@map("budget_lines")
}

// ============================================================
// CURRENCY — org rate book + revaluation runs
// ============================================================
enum RevaluationStatus {
  DRAFT
  POSTED
}

model OrgExchangeRate {
  id String @id @default(cuid())

  organizationId String

  baseCurrency   String
  targetCurrency String
  rate           Decimal  @db.Decimal(18, 8)
  asOfDate       DateTime
  source         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, baseCurrency, targetCurrency, asOfDate])
  @@index([organizationId, targetCurrency, asOfDate])
  @@map("org_exchange_rates")
}

model CurrencyRevaluation {
  id String @id @default(cuid())

  organizationId String

  asOfDate      DateTime
  baseCurrency  String
  status        RevaluationStatus @default(DRAFT)
  totalGainLoss Decimal           @default(0) @db.Decimal(16, 2)

  journalEntryId String?
  createdById    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        CurrencyRevaluationLine[]

  @@index([organizationId, status])
  @@map("currency_revaluations")
}

// ============================================================
// BULK ACCOUNT UPDATE — replace an account reference across source
// documents via a background (BullMQ) job, with progress tracking.
// ============================================================
enum BulkUpdateStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model BulkAccountUpdateJob {
  id String @id @default(cuid())

  organizationId String

  fromAccountId String
  toAccountId   String
  scopes        String[] // entity keys: invoices, payments, purchases, etc.

  status          BulkUpdateStatus @default(QUEUED)
  totalRecords    Int              @default(0)
  processedRecords Int             @default(0)
  perEntityCounts Json? // { invoices: 12, payments: 3, ... }
  error           String?

  createdById String?
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("bulk_account_update_jobs")
}

model CurrencyRevaluationLine {
  id String @id @default(cuid())

  revaluationId String

  accountId      String
  currency       String
  foreignBalance Decimal @db.Decimal(18, 4)
  oldRate        Decimal @db.Decimal(18, 8)
  newRate        Decimal @db.Decimal(18, 8)
  baseBefore     Decimal @db.Decimal(16, 2)
  baseAfter      Decimal @db.Decimal(16, 2)
  gainLoss       Decimal @db.Decimal(16, 2)

  revaluation CurrencyRevaluation @relation(fields: [revaluationId], references: [id], onDelete: Cascade)

  @@index([revaluationId])
  @@map("currency_revaluation_lines")
}

// ============================================================
// BANK ACCOUNT
// ============================================================
model BankAccount {
  id             String @id @default(cuid())
  organizationId String

  // Identity
  accountName   String
  bankName      String
  bankCode      String? // First 4 chars of IFSC
  accountNumber String
  maskedNumber  String? // e.g. "XXXX XXXX 4321"
  ifscCode      String?
  swiftCode     String?
  micrCode      String?
  branchName    String?
  branchCity    String?

  // Account classification
  accountType BankAccountType @default(CURRENT)
  currency    String          @default("INR")

  // Balances
  openingBalance   Decimal @default(0) @db.Decimal(16, 2)
  currentBalance   Decimal @default(0) @db.Decimal(16, 2)
  availableBalance Decimal @default(0) @db.Decimal(16, 2)
  ledgerBalance    Decimal @default(0) @db.Decimal(16, 2)

  // Flags
  isPrimary Boolean @default(false)
  isActive  Boolean @default(true)
  isVirtual Boolean @default(false)

  // Sync state
  lastSyncAt      DateTime?
  lastSyncStatus  String? // "SUCCESS" | "FAILED" | "PARTIAL"
  lastSyncError   String?
  autoSyncEnabled Boolean   @default(false)
  syncFrequency   String? // "HOURLY" | "DAILY" | "WEEKLY"
  nextSyncAt      DateTime?

  // Health & consent
  healthScore      Int? // 0-100
  consentStatus    String? // "ACTIVE" | "EXPIRED" | "REVOKED" | "NONE"
  connectionId     String?
  linkedAccountRef String? // AA linkRefNumber — maps Setu FI data to this account

  // Metadata
  notes    String?
  metadata Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization     Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments         Payment[]                   @relation("BankAccountPayments")
  connection       BankConnection?             @relation("BankConnectionAccounts", fields: [connectionId], references: [id])
  bankTransactions BankTransaction[]           @relation("BankAccountTransactions")
  reconciliations  BankReconciliationSession[] @relation("BankAccountReconciliations")
  statementImports BankStatementImport[]       @relation("BankAccountImports")
  consents         BankConsent[]               @relation("BankAccountConsents")
  balances         BankBalance[]               @relation("BankAccountBalances")
  syncHistory      BankSyncHistory[]           @relation("BankAccountSyncHistory")

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([organizationId, accountType])
  @@index([linkedAccountRef])
  @@map("bank_accounts")
}

enum BankAccountType {
  SAVINGS
  CURRENT
  CASH_CREDIT
  OVERDRAFT
  FIXED_DEPOSIT
  RECURRING_DEPOSIT
  NRE
  NRO
  FOREX
  WALLET
}

// ============================================================
// LEAD CRM
