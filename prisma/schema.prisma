  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([firmId, status])
  @@index([organizationId])
  @@index([returnType, periodYear, periodMonth])
  @@index([dueDate])
  @@map("ca_hub_gst_filings")
}

// ── Income tax returns (ITR 1-7) ──────────────────────────────
model ItrFiling {
