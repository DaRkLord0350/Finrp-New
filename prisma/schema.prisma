// ---------------------------------------------------------------------------
// Loan Product catalog (per-lender-organization)
// ---------------------------------------------------------------------------
model LoanProduct {
  id             String          @id @default(cuid())
  organizationId String
  code           String
  name           String
  type           LoanProductType
  description    String?

  minAmount Decimal @db.Decimal(16, 2)
  maxAmount Decimal @db.Decimal(16, 2)

  minTenureMonths Int
  maxTenureMonths Int

  interestRateType InterestRateType @default(REDUCING_BALANCE)
  minInterestRate  Decimal          @db.Decimal(5, 2)
  maxInterestRate  Decimal          @db.Decimal(5, 2)

  processingFeePercent      Decimal @default(0) @db.Decimal(5, 2)
  processingFeeFlat         Decimal @default(0) @db.Decimal(12, 2)
  latePaymentPenaltyPercent Decimal @default(0) @db.Decimal(5, 2)

  foreclosureAllowed       Boolean @default(true)
  foreclosureChargePercent Decimal @default(0) @db.Decimal(5, 2)
  partPaymentAllowed       Boolean @default(true)
  partPaymentChargePercent Decimal @default(0) @db.Decimal(5, 2)

  collateralRequired Boolean @default(false)
  eligibilityRules   Json // engine-readable rule set: min income, min credit score, min vintage, max DTI, ...

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applications        LoanApplication[]
  approvalMatrixRules LoanApprovalMatrixRule[]
  accounts            LoanAccount[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, type])
  @@map("loan_products")
}

// ---------------------------------------------------------------------------
// Loan Application — the LOS workflow entity (pre-disbursement)
// ---------------------------------------------------------------------------
model LoanApplication {
  id                String @id @default(cuid())
  organizationId    String
  customerId        String
  productId         String
  applicationNumber String

  requestedAmount       Decimal  @db.Decimal(16, 2)
  approvedAmount        Decimal? @db.Decimal(16, 2)
  requestedTenureMonths Int
  approvedTenureMonths  Int?
  purpose               String?

  stage  LoanApplicationStage  @default(APPLICATION)
  status LoanApplicationStatus @default(DRAFT)

  payloadHash String? // SHA-256 of the application snapshot at last stage-affecting change

  riskScore    Int?
  riskCategory RiskLevel?

  interestRateOffered Decimal? @db.Decimal(5, 2)
  emiAmount           Decimal? @db.Decimal(12, 2)

  assignedUnderwriterId String?

  submittedAt     DateTime?
  sanctionedAt    DateTime?
  disbursedAt     DateTime?
  closedAt        DateTime?
  rejectionReason String?
  holdReason      String?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer            Customer     @relation(fields: [customerId], references: [id])
  product             LoanProduct  @relation(fields: [productId], references: [id])
  assignedUnderwriter User?        @relation("LoanApplicationUnderwriter", fields: [assignedUnderwriterId], references: [id])
  createdBy           User?        @relation("LoanApplicationCreatedBy", fields: [createdById], references: [id])

  coApplicants              LoanCoApplicant[]
  documents                 LoanDocument[]
  eligibilityChecks         LoanEligibilityCheck[]
  collaterals               LoanCollateral[]
  approvalSteps             LoanApprovalStep[]
  generatedLetters          LoanGeneratedLetter[]
  agreements                LoanAgreement[]
  underwritingDecisions     LoanUnderwritingDecision[]
  logs                      LoanApplicationLog[]
  account                   LoanAccount?
  disbursements             LoanDisbursement[]
  creditReports             CreditReport[]
  amlScreenings             AMLScreening[]
  amlCases                  AMLCase[]
  fraudIdentityFingerprints FraudIdentityFingerprint[]
  fraudScores               FraudScore[]
  fraudCases                FraudCase[]
  fraudProviderChecks       FraudProviderCheck[]
  verificationCases         VerificationCase[]

  @@unique([organizationId, applicationNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, stage])
  @@index([customerId])
  @@index([productId])
  @@map("loan_applications")
}

// Immutable, append-only. Mirrors TaxFilingLog's shape exactly.
