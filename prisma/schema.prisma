// ============================================================
// ORGANIZATION DOCUMENT (Settings > Compliance doc center)
// Stores compliance/identity documents for the organization.
// ============================================================
model OrganizationDocument {
  id             String            @id @default(cuid())
  organizationId String
  documentType   String // "PAN", "GST", "CIN", "AADHAAR", "MOA", "AOA", etc.
  displayName    String
  fileName       String
  mimeType       String
  fileSize       Int
  fileUrl        String // Cloud storage URL or base64 ref
  storageKey     String? // Cloud storage key
  uploadedById   String?
  uploadedAt     DateTime          @default(now())
  expiryDate     DateTime?
  status         OrgDocumentStatus @default(UPLOADED)
  isVerified     Boolean           @default(false)
  verifiedBy     String?
  verifiedAt     DateTime?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // ── Module 3: Document Vault extensions (Phase 1) ────────────
  // currentVersion + versions[] mirror CustomerDocument's proven
  // versioning shape. folder is free-text like documentType — the
  // existing DocumentFolder enum is a semantic mismatch (CA
  // tax-workflow folders, not KYC document categories).
  currentVersion Int                           @default(1)
  folder         String?
  tags           String[]                      @default([])
  deletedAt      DateTime?
  versions       OrganizationDocumentVersion[]

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Was @@unique — relaxed to @@index so a soft-deleted document
  // doesn't permanently block re-upload of the same documentType.
  // The service layer (lib/services/org-document.service.ts) still
  // enforces "one active row per (org, documentType)" by archiving
  // the current file into OrganizationDocumentVersion and updating
  // in place, rather than the DB constraint doing it — this keeps
  // the existing Compliance Doc Center UI's one-slot-per-type model
  // working unchanged.
  @@index([organizationId, documentType])
  @@index([organizationId])
  @@map("organization_documents")
}

model OrganizationDocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  versionNumber Int
  fileUrl       String
  fileName      String
  fileSize      Int      @default(0)
  uploadedById  String?
  notes         String?
  createdAt     DateTime @default(now())

  document OrganizationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("organization_document_versions")
}

enum OrgDocumentStatus {
  UPLOADED
  PENDING_VERIFICATION
  VERIFIED
  OCR_READY
  REJECTED
  EXPIRED
  MISSING
}

// ============================================================
// API TOKEN (Settings > Security — programmatic API access)
