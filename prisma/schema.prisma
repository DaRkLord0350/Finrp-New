// Daily/weekly/monthly KPI snapshot per organization
model DashboardSnapshot {
  id             String   @id @default(cuid())
  organizationId String
  snapshotDate   DateTime @db.Date
  period         String // "daily" | "weekly" | "monthly"

  totalRevenue    Decimal @default(0) @db.Decimal(16, 2)
  totalCustomers  Int     @default(0)
  totalInvoices   Int     @default(0)
  overdueInvoices Int     @default(0)
  paidInvoices    Int     @default(0)
  revenueGrowth   Decimal @default(0) @db.Decimal(7, 2)
  newCustomers    Int     @default(0)
  activeLoans     Int     @default(0)
  complianceDue   Int     @default(0)
  metadata        Json?

  computedAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, snapshotDate, period])
  @@index([organizationId, snapshotDate])
  @@index([organizationId, period])
  @@map("dashboard_snapshots")
}

