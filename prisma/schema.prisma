// ============================================================
// BANK WEBHOOK EVENT (banking webhook audit + idempotency store)
// Standalone (not the generic WebhookEvent) because these webhooks
// arrive before any Integration row exists and may not be resolvable
// to an organization until the account/connection is looked up.
// ============================================================
model BankWebhookEvent {
  id             String        @id @default(cuid())
  organizationId String? // resolved from account/connection lookup; null if unknown
  provider       AAProvider    @default(TBX)
  eventType      String
  externalId     String?       @unique // provider notification id (replay dedup)
  consentId      String? // legacy AA consent id, unused by TBX events
  dataSessionId  String?
  payload        Json
  rawBody        String?
  signature      String?
  signatureValid Boolean       @default(false)
  status         WebhookStatus @default(PENDING)
  processedAt    DateTime?
  error          String?
  retryCount     Int           @default(0)
  receivedAt     DateTime      @default(now())

  organization Organization? @relation("OrgBankWebhookEvents", fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([provider, eventType])
  @@index([consentId])
  @@index([status, receivedAt])
  @@map("bank_webhook_events")
}

// ============================================================
// ============================================================
//   CA HUB — Chartered Accountant Practice Operating System
//
//   Net-new data layer for the CA Hub super-module. Designed to be
//   ADDITIVE: every model carries scalar tenant keys (firmId /
//   organizationId = client org) with indexes instead of formal
//   back-relations, so adding this block does NOT require touching
//   any of the 100+ existing core models. Wire formal relations
//   later if/when needed.
