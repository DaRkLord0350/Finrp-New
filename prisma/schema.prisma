// ============================================================
// CUSTOMER INVITATION
//
// A CA (or firm admin) invites a customer to onboard onto FinRP via
// email. The invitee signs up through Clerk; on acceptance a brand-new
// customer Organization is provisioned for them, a CRM Customer record
// is created in the firm's org, and the inviting CA is auto-assigned
// (CustomerAssignment for CRM + ClientAssignment for workspace access).
//
// Lifecycle: PENDING → SENT → ACCEPTED, or → EXPIRED (also REVOKED on
// manual cancel). See lib/customer-invitations/*.
// ============================================================
model CustomerInvitation {
  id                     String       @id @default(cuid())
  organizationId         String // firm's org (tenant that owns this invite)
  firmId                 String? // firm record (when firm-scoped)
  customerId             String? // optional link to a pre-existing CRM Customer
  email                  String
  name                   String?
  phone                  String?
  company                String?
  message                String? // optional personal note included in the email
  // ── Pre-filled business profile (captured by the firm at invite time) ──
  gstin                  String?
  pan                    String?
  address                String?
  city                   String?
  state                  String?
  country                String?
  pincode                String?
  industry               String?
  token                  String       @unique @default(cuid())
  status                 InviteStatus @default(PENDING)
  invitedById            String // CA / firm admin who created the invite
  assignedCaId           String? // CA to auto-assign on accept (defaults to inviter)
  acceptedOrganizationId String? // the customer's own org created on accept
  resendCount            Int          @default(0)
  expiresAt              DateTime
  sentAt                 DateTime? // first successful email dispatch
  lastSentAt             DateTime? // most recent dispatch (resends)
  emailOpenedAt          DateTime? // onboarding stage: invite link engaged
  // ── Email delivery status (Resend) ──────────────────────────
  emailMessageId         String? // Resend message id for the last dispatch
  emailError             String? // last send failure (null once a send succeeds)
  acceptedAt             DateTime?
  documentsUploadedAt    DateTime? // onboarding stage: first document uploaded
  bankConnectedAt        DateTime? // onboarding stage: bank account linked
  completedAt            DateTime? // onboarding stage: fully onboarded
  revokedAt              DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  organization Organization @relation("OrgCustomerInvitations", fields: [organizationId], references: [id], onDelete: Cascade)
  firm         Firm?        @relation("FirmCustomerInvitations", fields: [firmId], references: [id])
  customer     Customer?    @relation("CustomerInviteLinks", fields: [customerId], references: [id])
  invitedBy    User         @relation("CustomerInviteInvitedBy", fields: [invitedById], references: [id])
  assignedCa   User?        @relation("CustomerInviteAssignedCa", fields: [assignedCaId], references: [id])

  @@index([organizationId])
  @@index([firmId])
  @@index([email])
  @@index([status])
  @@index([assignedCaId])
  @@map("customer_invitations")
}

