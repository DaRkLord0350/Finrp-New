  @@index([senderId, receiverId])
  @@index([organizationId])
  @@index([parentId])
  @@index([receiverId, isRead])
  @@index([conversationId])
  @@map("messages")
}

// ============================================================
// ============ CLIENT PORTAL =================================
// ============================================================
// Firm-org-scoped client collaboration: document requests &
// uploads, filing (GST/ITR) e-approvals, conversations, and
// portal notifications. Records live in the FIRM's organization
// (plain `organizationId String`, ca_hub convention) and reference
// the CRM Customer. ClientPortalAccess bridges the logged-in
// customer (their own org/user) to their Customer row.
// See lib/client-portal/*.
// ============================================================

enum ClientPortalAccessStatus {
  INVITED
  ACTIVE
  SUSPENDED
