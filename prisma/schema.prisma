enum TbxPaymentType {
  NEFT
  RTGS
  IMPS
  BULK
  SCHEDULED
}

enum TbxPaymentStatus {
  DRAFT
  MAKER_PENDING
  CHECKER_PENDING
  SUBMITTED
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

enum VendorPaymentEvent {
  CREATED
  SUBMITTED_FOR_APPROVAL
  APPROVED
  REJECTED
  SUBMITTED_TO_TBX
  PROCESSING
  WEBHOOK_RECEIVED
  SUCCEEDED
  FAILED
  CANCELLED
  RETRY_SCHEDULED
