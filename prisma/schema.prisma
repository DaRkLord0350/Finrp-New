}

// ============================================================
// MULTI CURRENCY
// ============================================================
model ExchangeRate {
  id String @id @default(cuid())

  baseCurrency String

  targetCurrency String

  rate Decimal @db.Decimal(16, 6)

  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([baseCurrency, targetCurrency])
  @@map("exchange_rates")
}

// ============================================================
// TRANSACTION (Inventory movement — sale or restock)
// ============================================================
model Transaction {
  id             String          @id @default(cuid())
  itemId         String
  organizationId String
  type           TransactionType
  quantity       Int
  beforeStock    Int?
  afterStock     Int?
  referenceId    String? // sale / purchase / invoice id
  note           String?
  createdAt      DateTime        @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([organizationId])
  @@index([organizationId, type])
  @@index([organizationId, createdAt])
  @@map("transactions")
}

enum TransactionType {
  SALE
  RESTOCK
  ADJUSTMENT
  RETURN
  TRANSFER
}

// ============================================================
// LOAN
// ============================================================
model Loan {
  id               String     @id @default(cuid())
  organizationId   String
  loanNumber       String?
  loanType         String // "Working Capital", "Equipment", "Term Loan"
  lenderType       LenderType @default(BANK)
  bank             String
  loanAmount       Decimal    @db.Decimal(16, 2)
  principalAmount  Decimal    @db.Decimal(16, 2)
  approvedAmount   Decimal?   @db.Decimal(16, 2)
  disbursedAmount  Decimal?   @db.Decimal(16, 2)
  remainingBalance Decimal?   @db.Decimal(16, 2)
  interestRate     Decimal    @default(0) @db.Decimal(5, 2)
  tenure           Int // months
  monthlyEMI       Decimal    @default(0) @db.Decimal(12, 2)
  processingFee    Decimal    @default(0) @db.Decimal(10, 2)
  collateral       String?
  cibilScore       Int?
  status           LoanStatus @default(PENDING)
  processingStatus String?
  overdueEMI       Int        @default(0)
  applicationDate  DateTime   @default(now())
  approvalDate     DateTime?
  startDate        DateTime?
  endDate          DateTime?
  notes            String?
  deletedAt        DateTime?
  accountId        String?
  journalEntryId   String? // Link to general ledger
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments     LoanPayment[]
  account      Account?      @relation(fields: [accountId], references: [id])

  @@unique([organizationId, loanNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("loans")
}

enum LoanStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  ACTIVE
  COMPLETED
  REJECTED
  DEFAULTED
}

enum LenderType {
  BANK
  NBFC
  GOVERNMENT
  PRIVATE
  MICROFINANCE
}

// ============================================================
// LOAN PAYMENT (EMI tracking)
// ============================================================
model LoanPayment {
  id         String         @id @default(cuid())
  loanId     String
  emiNumber  Int?
  amount     Decimal        @db.Decimal(12, 2)
  principal  Decimal        @default(0) @db.Decimal(12, 2)
  interest   Decimal        @default(0) @db.Decimal(12, 2)
  paidAmount Decimal        @default(0) @db.Decimal(12, 2)
  dueDate    DateTime
  paidDate   DateTime?
  status     PaymentStatus  @default(PENDING)
  method     PaymentMethod?
  reference  String?
  notes      String?
  createdAt  DateTime       @default(now())

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@map("loan_payments")
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  PARTIAL
}

// ============================================================
// SALE (ERP — Sales tracking)
// ============================================================
model Sale {
  id             String        @id @default(cuid())
  saleNumber     String
  customerId     String?
  organizationId String
  totalAmount    Decimal       @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  profit         Decimal       @default(0) @db.Decimal(12, 2)
  status         SaleStatus    @default(COMPLETED)
  paymentStatus  PaymentStatus @default(PAID)
  paymentMethod  PaymentMethod @default(CASH)
  salesperson    String?
  channel        String?
  notes          String?
  journalEntryId String? // Link to general ledger
  saleDate       DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  createdById    String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id])
  createdBy    User?        @relation("SaleCreatedBy", fields: [createdById], references: [id])
  items        SaleItem[]

  @@unique([organizationId, saleNumber])
  @@index([organizationId, saleDate])
  @@index([organizationId])
  @@map("sales")
}

enum SaleStatus {
  COMPLETED
  PENDING
  RETURNED
  CANCELLED
}

// ============================================================
// SALE ITEM (ERP — Sale line items)
// ============================================================
model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  itemId      String?
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  costPrice   Decimal @default(0) @db.Decimal(12, 2)
  taxPercent  Decimal @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  profit      Decimal @default(0) @db.Decimal(12, 2)

  sale Sale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item Item? @relation(fields: [itemId], references: [id])

  @@index([saleId])
  @@map("sale_items")
}

// ============================================================
// PURCHASE (ERP — Procurement)
// ============================================================
model Purchase {
  id               String         @id @default(cuid())
  purchaseNumber   String
  vendorId         String?
  vendorName       String? // fallback if no vendor record
  organizationId   String
  totalAmount      Decimal        @db.Decimal(12, 2)
  taxAmount        Decimal        @default(0) @db.Decimal(12, 2)
  shippingCost     Decimal        @default(0) @db.Decimal(12, 2)
  status           PurchaseStatus @default(ORDERED)
  purchaseType     String? // "goods", "services"
  paymentStatus    PaymentStatus  @default(PENDING)
  paymentMethod    PaymentMethod?
  reference        String?
  expectedDelivery DateTime?
  deletedAt        DateTime?
  createdById      String?
  deliveredAt      DateTime?
  notes            String?
  journalEntryId   String? // Link to general ledger
  expenseAccountId String? // default expense account for ledger posting
  purchaseDate     DateTime       @default(now())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor         Vendor?        @relation(fields: [vendorId], references: [id])
  createdBy      User?          @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  expenseAccount Account?       @relation("PurchaseExpenseAccount", fields: [expenseAccountId], references: [id])
  items          PurchaseItem[]

  @@unique([organizationId, purchaseNumber])
  @@index([organizationId, purchaseDate])
  @@index([organizationId])
  @@map("purchases")
}

enum PurchaseStatus {
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

// ============================================================
// PURCHASE ITEM
// ============================================================
model PurchaseItem {
  id          String  @id @default(cuid())
  purchaseId  String
  itemId      String?
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitCost    Decimal @db.Decimal(12, 2)
  taxPercent  Decimal @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)

  expenseAccountId String?

  purchase       Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item           Item?    @relation(fields: [itemId], references: [id])
  expenseAccount Account? @relation("PurchaseItemExpenseAccount", fields: [expenseAccountId], references: [id])

  @@index([purchaseId])
  @@index([expenseAccountId])
  @@map("purchase_items")
}

// ============================================================
// EXPENSE (Operational expenses)
// ============================================================
model Expense {
  id                 String          @id @default(cuid())
  category           ExpenseCategory @default(OPERATIONS)
  description        String
  amount             Decimal         @db.Decimal(12, 2)
  organizationId     String
  vendorName         String?
  department         String?
  approvedBy         String?
  receiptUrl         String?
  recurring          Boolean         @default(false)
  recurringFrequency String? // "monthly", "weekly", "yearly"
  taxAmount          Decimal         @default(0) @db.Decimal(12, 2)
  notes              String?
  expenseDate        DateTime        @default(now())
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?
  createdById        String?
  paymentAccountId   String?
  journalEntryId     String? // Link to general ledger

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  paymentAccount Account?     @relation("ExpensePaymentAccount", fields: [paymentAccountId], references: [id])

  @@index([organizationId, expenseDate])
  @@index([organizationId])
  @@map("expenses")
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARIES
  MARKETING
  TRAVEL
  SOFTWARE
  EQUIPMENT
  LOGISTICS
  MAINTENANCE
  OPERATIONS
  TAXES
  OTHER
}

// ============================================================
// EMPLOYEE
// ============================================================
model Employee {
  id               String         @id @default(cuid())
  employeeCode     String?
  name             String
  email            String?
  phone            String?
  designation      String?
  department       String?
  employmentType   EmploymentType @default(FULL_TIME)
  joiningDate      DateTime?
  resignationDate  DateTime?
  baseSalary       Decimal        @db.Decimal(12, 2)
  hra              Decimal        @default(0) @db.Decimal(12, 2)
  pf               Decimal        @default(0) @db.Decimal(10, 2)
  esi              Decimal        @default(0) @db.Decimal(10, 2)
  bankAccount      String?
  bankName         String?
  panNumber        String?
  aadharNumber     String?
  address          String?
  emergencyContact String?
  avatarUrl        String?
  isActive         Boolean        @default(true)
  organizationId   String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payroll      Payroll[]

  @@unique([organizationId, employeeCode])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("employees")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  CONSULTANT
  INTERN
}

// ============================================================
// PAYROLL (Employee payroll records)
// ============================================================
model Payroll {
  id             String    @id @default(cuid())
  employeeId     String?
  employeeName   String
  designation    String?
  department     String?
  organizationId String
  payPeriod      String // e.g. "2026-04"
  payPeriodStart DateTime?
  payPeriodEnd   DateTime?

  // Earnings
  baseSalary Decimal @db.Decimal(12, 2)
  hra        Decimal @default(0) @db.Decimal(12, 2)
  bonus      Decimal @default(0) @db.Decimal(12, 2)
  overtime   Decimal @default(0) @db.Decimal(12, 2)
  allowances Decimal @default(0) @db.Decimal(12, 2)
  grossPay   Decimal @db.Decimal(12, 2)

  // Deductions
  pf              Decimal @default(0) @db.Decimal(12, 2)
  esi             Decimal @default(0) @db.Decimal(12, 2)
  tax             Decimal @default(0) @db.Decimal(12, 2)
  otherDeductions Decimal @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal @db.Decimal(12, 2)

  // Summary
  netPay         Decimal       @db.Decimal(12, 2)
  attendanceDays Int?
  leaveDays      Int?
  paymentMethod  PaymentMethod @default(BANK_TRANSFER)
  paidAt         DateTime      @default(now())
  notes          String?
  journalEntryId String? // Link to general ledger
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee?    @relation(fields: [employeeId], references: [id])

  @@index([organizationId])
  @@index([organizationId, payPeriod])
  @@map("payroll")
}

// ============================================================
// MEMBERSHIP (User ↔ Organization many-to-many with roles)
// Complements User.role for multi-org and invite flow support.
// ============================================================
model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role
  invitedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

// ============================================================
// ROLE PERMISSION (Per-org custom-role overrides)
//
// Optional, organization-scoped overrides of the static code
// matrix in lib/auth/permissions.ts. When NO rows exist for an
// (organizationId, role) pair, the resolver falls back to the
// code defaults — so this table is purely additive and safe to
// leave empty. One row per (org, role, module) holds the CRUD
// flags; lib/auth/permission-resolver.ts expands them back into
// the flat `<resource>.<action>` permission list. OWNER is never
// customizable (always full access).
// ============================================================
model RolePermission {
  id             String   @id @default(cuid())
  organizationId String
  role           Role
  module         String // AppModule string (crm, billing, finance, ...)
  canView        Boolean  @default(false)
  canCreate      Boolean  @default(false)
  canEdit        Boolean  @default(false)
  canDelete      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, role, module])
  @@index([organizationId])
  @@map("role_permissions")
}

// ============================================================
// INVITATION (Pending team invites)
// ============================================================
model Invitation {
  id             String          @id @default(cuid())
  organizationId String
  email          String
  role           Role
  token          String          @unique @default(cuid())
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedBy      String?
  createdAt      DateTime        @default(now())
  // ── Firm team-member invite payload (Phase 3) ───────────────
  name           String?
  phone          String?
  firmId         String?
  firmRole       FirmMemberRole?
  specialization Specialization?
  joiningDate    DateTime?
  userRole       UserRole? // CA | CA_FIRM_ADMIN to grant on accept
  status         InviteStatus    @default(PENDING)
  revokedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([status])
  @@map("invitations")
}

// ============================================================
// TEAM ACTIVITY LOG (Phase 3 — firm team management audit trail;
// also the foundation reused by the Phase 10 audit module)
// ============================================================
model TeamActivityLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String? // user who performed the action
  actorName      String?
  targetUserId   String? // affected member (when they have a User row)
  targetEmail    String? // affected member email (covers pending invites)
  action         String // MEMBER_INVITED | MEMBER_UPDATED | MEMBER_DEACTIVATED | MEMBER_REACTIVATED | MEMBERS_IMPORTED | PERMISSIONS_UPDATED | INVITE_RESENT | INVITE_REVOKED
  module         String   @default("TEAM")
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  targetUser   User?        @relation("TeamActivityTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([targetUserId])
  @@map("team_activity_logs")
}

// ============================================================
// =================== INTEGRATION PLATFORM ===================
// ============================================================

// ============================================================
// INTEGRATION (Connector connection record — one per provider)
// ============================================================
model Integration {
  id               String            @id @default(cuid())
  organizationId   String
  type             ConnectorType
  name             String
  status           IntegrationStatus @default(INACTIVE)
  config           Json? // non-sensitive config (data center, server URL, etc.)
  lastSyncAt       DateTime?
  lastSyncStatus   SyncJobStatus?
  lastSyncError    String?
  syncIntervalMins Int               @default(60)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  oauthToken    OAuthToken?
  syncJobs      SyncJob[]
  importJobs    ImportJob[]
  fieldMappings FieldMapping[]
  webhookEvents WebhookEvent[]

  @@unique([organizationId, type])
  @@index([organizationId])
  @@map("integrations")
}

enum ConnectorType {
  ZOHO_CRM
  ZOHO_BOOKS
  ZOHO_INVENTORY
  TALLY
  ODOO
  CSV
  EXCEL
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
  ERROR
  PENDING_AUTH
  EXPIRED
  SYNCING
}

// ============================================================
// OAUTH TOKEN (encrypted at rest — AES-256-GCM)
// ============================================================
model OAuthToken {
  id             String    @id @default(cuid())
  integrationId  String    @unique
  organizationId String
  accessToken    String // AES-256-GCM encrypted ciphertext
  refreshToken   String? // AES-256-GCM encrypted ciphertext
  tokenType      String    @default("Bearer")
  scope          String?
  expiresAt      DateTime?
  grantedScopes  String[]
  accountId      String? // Zoho accountId / Odoo dbname
  serverUrl      String? // Odoo instance URL
  metadata       Json? // provider-specific data
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("oauth_tokens")
}

// ============================================================
// SYNC JOB (background connector sync run)
// ============================================================
model SyncJob {
  id               String        @id @default(cuid())
  organizationId   String
  integrationId    String
  type             SyncJobType
  entity           String? // "customers" | "invoices" | "products" | "all"
  status           SyncJobStatus @default(QUEUED)
  bullmqJobId      String?
  startedAt        DateTime?
  completedAt      DateTime?
  totalRecords     Int           @default(0)
  processedRecords Int           @default(0)
  successRecords   Int           @default(0)
  failedRecords    Int           @default(0)
  lastCursor       String? // incremental sync cursor (ISO date or page token)
  scheduledAt      DateTime?
  triggeredBy      String? // userId who triggered
  error            String?
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  logs         SyncLog[]

  @@index([integrationId, status])
  @@index([organizationId, status])
  @@map("sync_jobs")
}

enum SyncJobType {
  FULL
  INCREMENTAL
  ENTITY_SPECIFIC
  TRIGGERED
  SCHEDULED
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  PAUSED
}

// ============================================================
// SYNC LOG (per-record audit trail)
// ============================================================
model SyncLog {
  id         String        @id @default(cuid())
  syncJobId  String
  entityType String
  entityId   String? // our DB record id
  externalId String? // source system id
  action     SyncAction
  status     SyncLogStatus @default(SUCCESS)
  data       Json?
  error      String?
  durationMs Int?
  createdAt  DateTime      @default(now())

  syncJob SyncJob @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@index([syncJobId])
  @@index([syncJobId, status])
  @@index([entityType, entityId])
  @@map("sync_logs")
}

enum SyncAction {
  CREATE
  UPDATE
  SKIP
  DELETE
  MERGE
  ERROR
}

enum SyncLogStatus {
  SUCCESS
  FAILED
  SKIPPED
  WARNING
}

// ============================================================
// IMPORT JOB (CSV/Excel file import)
// ============================================================
model ImportJob {
  id              String       @id @default(cuid())
  organizationId  String
  integrationId   String?
  type            ImportType
  entity          ImportEntity
  status          ImportStatus @default(PENDING)
  bullmqJobId     String?
  fileName        String
  originalName    String
  fileSize        Int
  filePath        String // local tmp path or cloud URL
  mimeType        String
  totalRows       Int          @default(0)
  processedRows   Int          @default(0)
  successRows     Int          @default(0)
  failedRows      Int          @default(0)
  skippedRows     Int          @default(0)
  duplicateRows   Int          @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  queuedAt        DateTime? // set when BullMQ job is confirmed in Redis
  failedAt        DateTime? // set when status → FAILED
  lastHeartbeatAt DateTime? // worker updates this every 10 s — detect crashes
  retryCount      Int          @default(0)
  uploadedById    String
  fieldMapping    Json? // saved column → field mappings
  options         Json? // { skipDuplicates, updateExisting, dryRun }
  detectedColumns String[] // detected CSV headers
  errorFilePath   String? // downloadable error CSV path
  error           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration?  @relation(fields: [integrationId], references: [id])
  rows         ImportRow[]
  errors       ImportError[]

  @@index([organizationId, status])
  @@index([organizationId, entity])
  @@index([status])
  @@index([bullmqJobId])
  @@index([createdAt])
  @@map("import_jobs")
}

enum ImportType {
  CSV
  EXCEL
  JSON
  XML
}

enum ImportEntity {
  CUSTOMERS
  VENDORS
  INVOICES
  PRODUCTS
  EMPLOYEES
  EXPENSES
  PAYMENTS
  LEADS
  CA_USERS
  FIRMS
  ASSIGNMENTS
  MASTER_IMPORT
}

enum ImportStatus {
  PENDING
  QUEUED
  MAPPING
  VALIDATING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  PARTIAL
}

// ============================================================
// IMPORT ROW (staging table — one row per source record)
// ============================================================
model ImportRow {
  id             String    @id @default(cuid())
  importJobId    String
  rowIndex       Int
  rawData        Json // original CSV row as key-value
  mappedData     Json? // after field mapping applied
  normalizedData Json? // after normalization (GST, dates, etc.)
  status         RowStatus @default(PENDING)
  isDuplicate    Boolean   @default(false)
  mergedIntoId   String? // entityId it was merged into
  entityId       String? // created/updated entity id
  error          String?
  warnings       String[]
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  importJob ImportJob     @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  errors    ImportError[]

  @@index([importJobId, status])
  @@index([importJobId, rowIndex])
  @@map("import_rows")
}

enum RowStatus {
  PENDING
  SUCCESS
  FAILED
  SKIPPED
  DUPLICATE
  MERGED
}

// ============================================================
// IMPORT ERROR (validation and processing errors)
// ============================================================
model ImportError {
  id          String        @id @default(cuid())
  importJobId String
  importRowId String?
  rowIndex    Int?
  field       String?
  errorCode   String
  message     String
  value       String? // the value that caused the error
  severity    ErrorSeverity @default(ERROR)
  createdAt   DateTime      @default(now())

  importJob ImportJob  @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  importRow ImportRow? @relation(fields: [importRowId], references: [id])

  @@index([importJobId])
  @@index([importRowId])
  @@map("import_errors")
}

enum ErrorSeverity {
  ERROR
  WARNING
  INFO
}

// ============================================================
// FIELD MAPPING (saved reusable column mapping templates)
// ============================================================
model FieldMapping {
  id             String        @id @default(cuid())
  organizationId String
  integrationId  String?
  name           String
  entity         ImportEntity
  sourceType     ConnectorType
  mappings       Json // MappingRule[] — see connector types
  isDefault      Boolean       @default(false)
  useCount       Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration? @relation(fields: [integrationId], references: [id])

  @@index([organizationId, entity])
  @@map("field_mappings")
}

// ============================================================
// WEBHOOK EVENT (inbound webhooks from Zoho, etc.)
// ============================================================
model WebhookEvent {
  id             String        @id @default(cuid())
  organizationId String
  integrationId  String
  source         ConnectorType
  eventType      String
  externalId     String? // provider event id (for dedup)
  payload        Json
  rawPayload     String? // raw body for signature verify
  signature      String?
  status         WebhookStatus @default(PENDING)
  bullmqJobId    String?
  processedAt    DateTime?
  error          String?
  retryCount     Int           @default(0)
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([externalId])
  @@map("webhook_events")
}

enum WebhookStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

// ============================================================
// INVOICE COUNTER (Atomic sequence for collision-safe numbering)
// ============================================================
model InvoiceCounter {
  id             String @id @default(cuid())
  organizationId String
  year           Int
  lastNumber     Int    @default(0)

  @@unique([organizationId, year])
  @@index([organizationId])
  @@map("invoice_counters")
}

// ============================================================
// =============== COMPLIANCE MANAGEMENT MODULE ===============
// ============================================================

enum ComplianceStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  PENDING_RENEWAL
  COMPLETED
}

enum ComplianceApprovalAction {
  APPROVE
  REJECT
  REQUEST_CHANGES
  ESCALATE
}

enum ComplianceReminderType {
  DUE_DATE
  EXPIRY
  PENDING_APPROVAL
  REJECTED_FOLLOW_UP
  RENEWAL
  CUSTOM
}

// ============================================================
// COMPLIANCE CATEGORY (dynamic, org-scoped categories)
// ============================================================
model ComplianceCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  code           String
  color          String   @default("#6366f1")
  icon           String   @default("ShieldCheck")
  isActive       Boolean  @default(true)
  isSystem       Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  types        ComplianceType[]
  submissions  ComplianceSubmission[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("compliance_categories")
}

// ============================================================
// COMPLIANCE TYPE (sub-types within categories)
// ============================================================
model ComplianceType {
  id                String   @id @default(cuid())
  organizationId    String
  categoryId        String
  name              String
  description       String?
  code              String
  requiredDocuments String[]
  validityDays      Int?
  defaultPenalty    Decimal? @db.Decimal(12, 2)
  isActive          Boolean  @default(true)
  isSystem          Boolean  @default(false)
  sortOrder         Int      @default(0)
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     ComplianceCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  submissions  ComplianceSubmission[]

  @@unique([organizationId, categoryId, code])
  @@index([organizationId, categoryId])
  @@map("compliance_types")
}

// ============================================================
// COMPLIANCE DOCUMENT (PostgreSQL BYTEA binary storage)
// Binary data excluded from listing queries — fetched on demand
// ============================================================
model ComplianceDocument {
  id             String  @id @default(cuid())
  organizationId String
  submissionId   String?

  fileName      String
  fileExtension String
  mimeType      String
  fileSize      Int
  checksum      String

  binaryData Bytes

  version      Int     @default(1)
  isLatest     Boolean @default(true)
  documentType String?
  description  String?

  reviewStatus  DocumentReviewStatus @default(PENDING)
  reviewComment String?
  reviewedById  String?
  reviewedAt    DateTime?

  uploadedById String?
  uploadedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submission   ComplianceSubmission? @relation(fields: [submissionId], references: [id])
  versions     DocumentVersion[]

  @@index([organizationId])
  @@index([submissionId])
  @@index([reviewStatus])
  @@map("compliance_documents")
}

enum DocumentReviewStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

// ============================================================
// COMPLIANCE SUBMISSION (core compliance lifecycle record)
// ============================================================
model ComplianceSubmission {
  id             String  @id @default(cuid())
  organizationId String
  categoryId     String
  typeId         String?

  title           String
  description     String?
  referenceNumber String?

  status ComplianceStatus @default(DRAFT)

  submissionDate DateTime?
  effectiveDate  DateTime?
  expiryDate     DateTime?
  dueDate        DateTime?
  renewalDate    DateTime?

  penaltyAmount Decimal? @db.Decimal(12, 2)
  feeAmount     Decimal? @db.Decimal(12, 2)

  assignedToId String?
  reviewedById String?
  assignedCaId String?
  verifiedById String?

  complianceData Json?

  version Int      @default(1)
  tags    String[]
  notes   String?

  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category      ComplianceCategory        @relation(fields: [categoryId], references: [id])
  type          ComplianceType?           @relation(fields: [typeId], references: [id])
  documents     ComplianceDocument[]
  approvals     ComplianceApproval[]
  reminders     ComplianceReminder[]
  statusHistory ComplianceStatusHistory[]
  deadlines     ComplianceDeadline[]
  auditLogs     ComplianceAuditLog[]

  @@index([organizationId, status])
  @@index([organizationId, categoryId])
  @@index([organizationId, dueDate])
  @@index([organizationId, expiryDate])
  @@index([organizationId, deletedAt])
  @@index([organizationId, deletedAt, status, dueDate])
  @@index([organizationId, deletedAt, status, expiryDate])
  @@map("compliance_submissions")
}

// ============================================================
// COMPLIANCE APPROVAL (approve/reject/escalate workflow)
// ============================================================
model ComplianceApproval {
  id             String @id @default(cuid())
  organizationId String
  submissionId   String

  action     ComplianceApprovalAction
  comments   String?
  conditions String?

  approvedById String?
  approvedAt   DateTime @default(now())

  createdAt DateTime @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submission   ComplianceSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([submissionId])
  @@map("compliance_approvals")
}

// ============================================================
// COMPLIANCE REMINDER (automated reminders for deadlines/expiry)
// ============================================================
model ComplianceReminder {
  id             String  @id @default(cuid())
  organizationId String
  submissionId   String?

  type    ComplianceReminderType
  title   String
  message String?

  reminderDate DateTime
  isTriggered  Boolean   @default(false)
  triggeredAt  DateTime?

  assignedToId String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submission   ComplianceSubmission? @relation(fields: [submissionId], references: [id])

  @@index([organizationId])
  @@index([reminderDate, isTriggered, isActive])
  @@index([organizationId, isActive, isTriggered, reminderDate])
  @@map("compliance_reminders")
}

// ============================================================
// COMPLIANCE DEADLINE (deadline tracking with penalty rates)
// ============================================================
model ComplianceDeadline {
  id             String  @id @default(cuid())
  organizationId String
  submissionId   String?

  title           String
  description     String?
  deadlineDate    DateTime
  gracePeriodDays Int      @default(0)

  isCompleted Boolean   @default(false)
  completedAt DateTime?

  penaltyPerDay Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submission   ComplianceSubmission? @relation(fields: [submissionId], references: [id])

  @@index([organizationId])
  @@index([deadlineDate, isCompleted])
  @@index([organizationId, isCompleted, deadlineDate])
  @@map("compliance_deadlines")
}

// ============================================================
// COMPLIANCE AUDIT LOG (compliance-specific event trail)
// ============================================================
model ComplianceAuditLog {
  id             String  @id @default(cuid())
  organizationId String
  submissionId   String?

  action      String
  description String

  performedById String?
  oldValue      Json?
  newValue      Json?

  ipAddress String?
  createdAt DateTime @default(now())

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submission   ComplianceSubmission? @relation(fields: [submissionId], references: [id])

  @@index([organizationId])
  @@index([submissionId])
  @@map("compliance_audit_logs")
}

// ============================================================
// COMPLIANCE STATUS HISTORY (immutable status change trail)
// ============================================================
model ComplianceStatusHistory {
  id             String @id @default(cuid())
  organizationId String
  submissionId   String

  fromStatus ComplianceStatus?
  toStatus   ComplianceStatus

  reason   String?
  comments String?

  changedById String?
  changedAt   DateTime @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submission   ComplianceSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([organizationId])
  @@map("compliance_status_history")
}

// ============================================================
// ORGANIZATION DOCUMENT (Settings > Compliance doc center)
// Stores compliance/identity documents for the organization.
// ============================================================
model OrganizationDocument {
  id             String            @id @default(cuid())
  organizationId String
  documentType   String // "PAN", "GST", "CIN", etc.
  displayName    String
  fileName       String
  mimeType       String
  fileSize       Int
  fileUrl        String // Cloud storage URL or base64 ref
  storageKey     String? // Cloud storage key
  uploadedById   String?
  uploadedAt     DateTime          @default(now())
  expiryDate     DateTime?
  status         OrgDocumentStatus @default(UPLOADED)
  isVerified     Boolean           @default(false)
  verifiedBy     String?
  verifiedAt     DateTime?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, documentType])
  @@index([organizationId])
  @@map("organization_documents")
}

enum OrgDocumentStatus {
  UPLOADED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  EXPIRED
  MISSING
}

// ============================================================
// API TOKEN (Settings > Security — programmatic API access)
// ============================================================
model ApiToken {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  tokenHash      String    @unique // SHA-256 of actual token
  tokenPrefix    String // first 8 chars for display (e.g. "fnrp_a1b")
  scopes         String[]  @default([])
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("api_tokens")
}

// ============================================================
// =================== TREDS MODULE ===========================
// ============================================================

enum TredsIntegrationStatus {
  ACTIVE
  INACTIVE
  ERROR
  PENDING
}

enum TredsInvoiceStatus {
  DRAFT
  READY
  SUBMITTED
  BUYER_APPROVED
  UNDER_BIDDING
  DISCOUNTED
  SETTLED
  REJECTED
}

enum TredsBidStatus {
  ACTIVE
  ACCEPTED
  REJECTED
  EXPIRED
}

enum TredsSettlementStatus {
  SCHEDULED
  PROCESSING
  PAID
  FAILED
}

enum TredsNotificationType {
  INVOICE_SUBMITTED
  BUYER_APPROVED
  BID_RECEIVED
  FUNDING_APPROVED
  SETTLEMENT_COMPLETED
  PAYMENT_RECEIVED
  INVOICE_REJECTED
}

model TredsIntegration {
  id                    String                 @id @default(cuid())
  organizationId        String                 @unique
  provider              String                 @default("M1XCHANGE")
  clientId              String
  encryptedClientSecret String
  apiEndpoint           String?
  status                TredsIntegrationStatus @default(INACTIVE)
  lastSyncAt            DateTime?
  syncFrequencyMins     Int                    @default(60)
  webhookUrl            String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices      TredsInvoice[]
  notifications TredsNotification[]

  @@index([organizationId])
  @@map("treds_integrations")
}

model TredsInvoice {
  id              String             @id @default(cuid())
  organizationId  String
  integrationId   String
  invoiceId       String?
  m1ReferenceId   String?
  invoiceNumber   String
  buyerName       String
  buyerGstin      String?
  invoiceAmount   Decimal            @db.Decimal(16, 2)
  dueDate         DateTime
  status          TredsInvoiceStatus @default(DRAFT)
  submittedAt     DateTime?
  approvedAt      DateTime?
  fundedAt        DateTime?
  settlementDate  DateTime?
  financingRate   Decimal?           @db.Decimal(5, 3)
  financierName   String?
  fundingAmount   Decimal?           @db.Decimal(16, 2)
  rejectionReason String?
  documents       String[]           @default([])
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  TredsIntegration   @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  bids         TredsBid[]
  settlement   TredsSettlement?
  activityLogs TredsActivityLog[]

  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@index([integrationId])
  @@map("treds_invoices")
}

model TredsBid {
  id             String         @id @default(cuid())
  tredsInvoiceId String
  financierName  String
  interestRate   Decimal        @db.Decimal(5, 3)
  bidAmount      Decimal        @db.Decimal(16, 2)
  expiryTime     DateTime
  status         TredsBidStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tredsInvoice TredsInvoice @relation(fields: [tredsInvoiceId], references: [id], onDelete: Cascade)

  @@index([tredsInvoiceId])
  @@map("treds_bids")
}

model TredsSettlement {
  id             String                @id @default(cuid())
  tredsInvoiceId String                @unique
  organizationId String
  amount         Decimal               @db.Decimal(16, 2)
  settlementDate DateTime
  status         TredsSettlementStatus @default(SCHEDULED)
  utr            String?
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  tredsInvoice TredsInvoice @relation(fields: [tredsInvoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("treds_settlements")
}

model TredsNotification {
  id             String                @id @default(cuid())
  organizationId String
  integrationId  String?
  type           TredsNotificationType
  title          String
  description    String
  read           Boolean               @default(false)
  metadata       Json?
  createdAt      DateTime              @default(now())

  integration TredsIntegration? @relation(fields: [integrationId], references: [id])

  @@index([organizationId])
  @@index([organizationId, read])
  @@map("treds_notifications")
}

model TredsActivityLog {
  id             String   @id @default(cuid())
  tredsInvoiceId String
  action         String
  description    String
  performedById  String?
  metadata       Json?
  createdAt      DateTime @default(now())

  tredsInvoice TredsInvoice @relation(fields: [tredsInvoiceId], references: [id], onDelete: Cascade)

  @@index([tredsInvoiceId])
  @@map("treds_activity_logs")
}

// ============================================================
// CA CLIENT (CA ↔ Customer Organization relationship)
// ============================================================
model CAClient {
  id             String   @id @default(cuid())
  caUserId       String
  organizationId String
  assignedAt     DateTime @default(now())
  isActive       Boolean  @default(true)
  notes          String?

  caUser       User         @relation("CAManagedClients", fields: [caUserId], references: [id])
  organization Organization @relation("CAManagedOrgs", fields: [organizationId], references: [id])

  @@unique([caUserId, organizationId])
  @@index([caUserId])
  @@index([organizationId])
  @@map("ca_clients")
}

// ============================================================
// COMPLIANCE CHECKLIST (CA builds per-compliance checklist)
// ============================================================
model ComplianceChecklist {
  id             String   @id @default(cuid())
  submissionId   String   @unique
  organizationId String
  name           String
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items ChecklistItem[]

  @@index([organizationId])
  @@map("compliance_checklists")
}

model ChecklistItem {
  id          String    @id @default(cuid())
  checklistId String
  label       String
  isMandatory Boolean   @default(false)
  isCompleted Boolean   @default(false)
  dueDate     DateTime?
  notes       String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  checklist ComplianceChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
  @@map("checklist_items")
}

// ============================================================
// CA MESSAGE (CA ↔ Client communication)
// ============================================================
model CAMessage {
  id             String   @id @default(cuid())
  caUserId       String
  organizationId String
  subject        String
  body           String
  templateType   String?
  isRead         Boolean  @default(false)
  sentAt         DateTime @default(now())

  caUser User @relation("CASentMessages", fields: [caUserId], references: [id])

  @@index([caUserId])
  @@index([organizationId])
  @@map("ca_messages")
}

// ============================================================
// FIRM (CA Practice Firm entity)
// ============================================================
model Firm {
  id                 String   @id @default(cuid())
  name               String
  registrationNumber String? // ICAI registration number
  email              String?
  phone              String?
  address            String?
  city               String?
  state              String?
  country            String?
  website            String?
  ownerId            String? // CA_FIRM_ADMIN userId who created this firm
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users         User[]                    @relation("FirmUsers")
  customers     Customer[]                @relation("FirmCustomers")
  templates     ComplianceTemplate[]      @relation("FirmTemplates")
  branding      FirmBranding?             @relation("FirmBranding")
  notifSettings FirmNotificationSettings? @relation("FirmNotifSettings")

  @@index([ownerId])
  @@map("firms")
}

// ============================================================
// CUSTOMER ASSIGNMENT (CA ↔ Customer CRM record mapping)
// ============================================================
model CustomerAssignment {
  id           String    @id @default(cuid())
  customerId   String
  caId         String
  assignedById String
  notes        String?
  reason       String?
  isActive     Boolean   @default(true)
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  customer   Customer @relation("CustomerAssignments", fields: [customerId], references: [id])
  ca         User     @relation("CAAssignments", fields: [caId], references: [id])
  assignedBy User     @relation("AssignmentCreatedBy", fields: [assignedById], references: [id])

  @@index([caId])
  @@index([customerId])
  @@index([customerId, isActive])
  @@map("customer_assignments")
}

// ============================================================
// FIRM TASK (Compliance task created by CA firm for a customer)
// ============================================================
enum FirmTaskStatus {
  PENDING
  IN_PROGRESS
  WAITING_CLIENT
  REVIEW
  COMPLETED
}

model FirmTask {
  id             String         @id @default(cuid())
  title          String
  description    String?
  customerId     String
  assignedCaId   String
  dueDate        DateTime
  status         FirmTaskStatus @default(PENDING)
  priority       PriorityLevel  @default(MEDIUM)
  createdById    String
  organizationId String
  notes          String?
  completedAt    DateTime?
  templateId     String?
  templateTaskId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  customer     Customer             @relation("CustomerFirmTasks", fields: [customerId], references: [id])
  assignedCa   User                 @relation("CATasks", fields: [assignedCaId], references: [id])
  createdBy    User                 @relation("FirmTaskCreatedBy", fields: [createdById], references: [id])
  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  comments     FirmTaskComment[]
  activities   FirmTaskActivity[]
  attachments  FirmTaskAttachment[]

  @@index([customerId])
  @@index([assignedCaId])
  @@index([organizationId])
  @@index([templateId])
  @@map("firm_tasks")
}

// ============================================================
// FIRM TASK WORKFLOW (Phase 6 — comments / attachments / history)
// ============================================================
model FirmTaskComment {
  id         String   @id @default(cuid())
  taskId     String
  authorId   String
  authorName String?
  body       String   @db.Text
  createdAt  DateTime @default(now())

  task FirmTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("firm_task_comments")
}

model FirmTaskActivity {
  id         String   @id @default(cuid())
  taskId     String
  actorId    String?
  actorName  String?
  action     String // CREATED | STATUS_CHANGED | REASSIGNED | COMMENTED | ATTACHMENT_ADDED | UPDATED
  fromStatus String?
  toStatus   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  task FirmTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("firm_task_activities")
}

model FirmTaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  fileName     String
  fileUrl      String
  mimeType     String?
  fileSize     Int      @default(0)
  uploadedById String?
  createdAt    DateTime @default(now())

  task FirmTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("firm_task_attachments")
}

// ============================================================
// CUSTOMER DOCUMENT VAULT (Phase 5 — folders / versions / downloads)
// Stores metadata + fileUrl (same pattern as OrganizationDocument).
// ============================================================
enum DocumentFolder {
  GST
  INCOME_TAX
  TDS
  AUDIT
  ROC
  PAYROLL
  BANK_STATEMENTS
  INVOICES
  OTHER
}

model CustomerDocument {
  id             String         @id @default(cuid())
  organizationId String
  customerId     String
  firmId         String?
  folder         DocumentFolder @default(OTHER)
  displayName    String
  fileName       String
  mimeType       String?
  fileSize       Int            @default(0)
  fileUrl        String
  storageKey     String?
  currentVersion Int            @default(1)
  uploadedById   String?
  isConfidential Boolean        @default(false)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization              @relation("OrgVaultDocuments", fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer                  @relation("CustomerVaultDocuments", fields: [customerId], references: [id], onDelete: Cascade)
  versions     CustomerDocumentVersion[]
  downloads    DocumentDownloadLog[]

  @@index([organizationId])
  @@index([customerId])
  @@index([customerId, folder])
  @@map("customer_documents")
}

model CustomerDocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  versionNumber Int
  fileUrl       String
  fileName      String
  fileSize      Int      @default(0)
  uploadedById  String?
  notes         String?
  createdAt     DateTime @default(now())

  document CustomerDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("customer_document_versions")
}

model DocumentDownloadLog {
  id             String   @id @default(cuid())
  documentId     String
  organizationId String
  userId         String?
  userName       String?
  ipAddress      String?
  createdAt      DateTime @default(now())

  document CustomerDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([organizationId])
  @@map("document_download_logs")
}

// ============================================================
// MESSAGE (Customer ↔ CA direct messaging)
// ============================================================
model Message {
  id             String    @id @default(cuid())
  senderId       String
  receiverId     String
  organizationId String
  subject        String?
  content        String
  isRead         Boolean   @default(false)
  readAt         DateTime?
  parentId       String?
  createdAt      DateTime  @default(now())

  sender       User         @relation("MessageSender", fields: [senderId], references: [id])
  receiver     User         @relation("MessageReceiver", fields: [receiverId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Message?     @relation("MessageThread", fields: [parentId], references: [id])
  replies      Message[]    @relation("MessageThread")

  @@index([senderId, receiverId])
  @@index([organizationId])
  @@index([parentId])
  @@index([receiverId, isRead])
  @@map("messages")
}

// ============================================================
// =================== PHASE 2 MODELS ========================
// ============================================================

// ============================================================
// COMPLIANCE TEMPLATE ENGINE
// ============================================================

enum TemplateFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  CUSTOM
}

model ComplianceTemplate {
  id             String            @id @default(cuid())
  organizationId String
  firmId         String?
  name           String
  description    String?
  frequency      TemplateFrequency
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

