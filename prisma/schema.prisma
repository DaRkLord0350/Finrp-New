enum NotificationType {
  COMPLIANCE_REMINDER
  LOAN_EMI_DUE
  INVOICE_OVERDUE
  LOW_STOCK
  PAYMENT_RECEIVED
  TASK_ASSIGNED
  DOCUMENT_UPLOADED
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  MESSAGE_RECEIVED
  ASSIGNMENT_CREATED
  TASK_DUE
  SYSTEM
}

// ============================================================
// AUDIT LOG
// ============================================================
model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  userId         String?
  action         AuditAction
  entity         String // "invoice", "customer", "loan", etc.
  entityId       String?
  description    String
  oldValue       Json?
  newValue       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([entity])
  @@map("audit_logs")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  EXPORT
  IMPORT
  POST
  REVERSE
  LOCK
  CLOSE
  SETTINGS_CHANGE
}

// ============================================================
// SETTINGS (Per-org feature flags and preferences)
// ============================================================
model Settings {
  id             String @id @default(cuid())
  organizationId String @unique

  // Features
  inventoryEnabled     Boolean @default(true)
  payrollEnabled       Boolean @default(true)
  complianceEnabled    Boolean @default(true)
  loanModuleEnabled    Boolean @default(true)
  multiCurrencyEnabled Boolean @default(false)

  // Tax
  defaultTaxRate Decimal @default(18) @db.Decimal(5, 2)
  taxLabel       String  @default("GST")
  taxRegistered  Boolean @default(false)

  // Invoice
  invoicePrefix       String  @default("INV")
  invoiceStartNumber  Int     @default(1)
  defaultPaymentTerms Int     @default(30)
  invoiceNotes        String?
  invoiceFooter       String?
  showLogo            Boolean @default(true)

  // Notifications
  emailNotifications  Boolean @default(true)
  smsNotifications    Boolean @default(false)
  overdueReminderDays Int     @default(3)
  lowStockThreshold   Int     @default(10)

  // Payroll
  pfPercent  Decimal @default(12) @db.Decimal(5, 2)
  esiPercent Decimal @default(1.75) @db.Decimal(5, 2)
  tdsPercent Decimal @default(0) @db.Decimal(5, 2)

  // Misc
  dateFormat   String @default("DD/MM/YYYY")
  numberFormat String @default("en-IN")
  metadata     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

