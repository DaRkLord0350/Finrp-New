model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String?
  type           NotificationType @default(SYSTEM)
  title          String
  message        String
  referenceId    String? // id of related record
  referenceType  String? // "invoice", "loan", "task"
