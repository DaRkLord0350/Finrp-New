// ============================================
// FinRP — Prisma Schema
// Multi-tenant SaaS architecture
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ORGANIZATION (Tenant root)
// ============================================================
model Organization {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  plan                Plan     @default(FREE)
  onboardingCompleted Boolean  @default(false)
  enabledModules      String[] @default([])
  createdBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users                   User[]
  memberships             Membership[]
  invitations             Invitation[]
  rolePermissions         RolePermission[]
  integrations            Integration[]
  importJobs              ImportJob[]
  fieldMappings           FieldMapping[]
  webhookEvents           WebhookEvent[]
  customers               Customer[]
  vendors                 Vendor[]
  invoices                Invoice[]
  payments                Payment[]
  complianceTasks         ComplianceTask[]
  businessProfile         BusinessProfile?
  complianceCategories    ComplianceCategory[]
  complianceTypes         ComplianceType[]
  complianceSubmissions   ComplianceSubmission[]
  complianceDocuments     ComplianceDocument[]
  complianceApprovals     ComplianceApproval[]
  complianceReminders     ComplianceReminder[]
  complianceDeadlines     ComplianceDeadline[]
  complianceAuditLogs     ComplianceAuditLog[]
  complianceStatusHistory ComplianceStatusHistory[]
  analyticsRecords        AnalyticsRecord[]
  items                   Item[]
  loans                   Loan[]
  sales                   Sale[]
  purchases               Purchase[]
  expenses                Expense[]
  payroll                 Payroll[]
  accounts                Account[]
  journalEntries          JournalEntry[]
  bankAccounts            BankAccount[]
  recurringInvoices       RecurringInvoice[]
  leads                   Lead[]
  fileUploads             FileUpload[]
  taxRates                TaxRate[]
  employees               Employee[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  settings                Settings?
  subscription            Subscription?
  orgDocuments            OrganizationDocument[]
  apiTokens               ApiToken[]
  caClients               CAClient[]                @relation("CAManagedOrgs")
  tredsIntegration        TredsIntegration?
  tredsInvoices           TredsInvoice[]
  firmTasks               FirmTask[]
  messages                Message[]
  signatureRequests       SignatureRequest[]
  notificationQueue       NotificationQueue[]
  complianceTemplates     ComplianceTemplate[]
  firmBranding            FirmBranding?
  firmNotifSettings       FirmNotificationSettings?
  dashboardSnapshots      DashboardSnapshot[]
  monthlyRevenueStats     MonthlyRevenueStat[]
  firmSnapshots           FirmSnapshot[]
  complianceStats         ComplianceStat[]
  scheduledReports        ScheduledReport[]

  // ── Banking OS ──────────────────────────────
  bankTransactions       BankTransaction[]
  bankingRules           BankingRule[]
  reconciliationSessions BankReconciliationSession[]
  bankConsents           BankConsent[]
  bankConnections        BankConnection[]
  bankStatementImports   BankStatementImport[]
  cashFlowSnapshots      CashFlowSnapshot[]
  gstBankMatches         GSTBankMatch[]
  bankRiskAlerts         BankRiskAlert[]
  bankAIInsights         BankAIInsight[]
  bankSyncHistory        BankSyncHistory[]
  bankBalances           BankBalance[]
  bankWebhookEvents      BankWebhookEvent[]          @relation("OrgBankWebhookEvents")

  // ── Client Workspace (CA impersonation) ─────
  clientAssignments  ClientAssignment[]  @relation("ClientAssignmentOrg")
  clientActivityLogs ClientActivityLog[] @relation("ClientActivityOrg")

  // ── Firm team management (Phase 3) ──────────
  teamActivityLogs TeamActivityLog[]

  // ── Customer document vault (Phase 5) ───────
  vaultDocuments CustomerDocument[] @relation("OrgVaultDocuments")

  // ── Invoice module (premium workspace) ──────
  invoiceAppearance InvoiceAppearanceSettings?
  invoiceTemplates  InvoiceTemplate[]
  invoiceShareLinks InvoiceShareLink[]
  invoiceActivities InvoiceActivity[]
  invoiceVersions   InvoiceVersion[]
  creditNotes       CreditNote[]

  // ── Accounting (fiscal years, periods, settings) ─
  fiscalYears          FiscalYear[]
  fiscalPeriods        FiscalPeriod[]
  accountingSettings   AccountingSettings?
  budgets               Budget[]
  orgExchangeRates      OrgExchangeRate[]
  currencyRevaluations  CurrencyRevaluation[]
  bulkAccountUpdateJobs BulkAccountUpdateJob[]

  @@index([slug])
  @@map("organizations")
}

enum Plan {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

// ============================================================
// USER
// ============================================================
model User {
  id                     String             @id @default(cuid())
  clerkId                String             @unique
  email                  String
  name                   String?
  phone                  String?
  role                   Role               @default(STAFF)
  userRole               UserRole? // null = new user, hasn't selected role yet
  department             String?
  designation            String?
  lastActiveAt           DateTime?
  notificationPreference Json?
  avatarUrl              String?
  isActive               Boolean            @default(true)
  lastLoginAt            DateTime?
  organizationId         String
  firmId                 String?
  // ── Firm team-member profile (Phase 3) ──────────────────────
  firmRole               FirmMemberRole? // firm designation (≠ platform userRole)
  specialization         Specialization?
  joiningDate            DateTime?
  defaultPermissions     ClientPermission[] @default([]) // applied when assigned to a client workspace
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  organization            Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firm                    Firm?                @relation("FirmUsers", fields: [firmId], references: [id])
  auditLogs               AuditLog[]
  notifications           Notification[]
  memberships             Membership[]
  complianceTasks         ComplianceTask[]     @relation("AssignedTo")
  invoices                Invoice[]            @relation("InvoiceCreatedBy")
  payments                Payment[]            @relation("PaymentCreatedBy")
  sales                   Sale[]               @relation("SaleCreatedBy")
  purchases               Purchase[]           @relation("PurchaseCreatedBy")
  expenses                Expense[]            @relation("ExpenseCreatedBy")
  journalEntries          JournalEntry[]       @relation("JournalEntryCreatedBy")
  journalEntriesPosted    JournalEntry[]       @relation("JournalEntryPostedBy")
  leads                   Lead[]               @relation("LeadAssignedTo")
  caClients               CAClient[]           @relation("CAManagedClients")
  caMessages              CAMessage[]          @relation("CASentMessages")
  customerAssignments     CustomerAssignment[] @relation("CAAssignments")
  assignmentsMade         CustomerAssignment[] @relation("AssignmentCreatedBy")
  firmTasksAsCa           FirmTask[]           @relation("CATasks")
  firmTasksCreated        FirmTask[]           @relation("FirmTaskCreatedBy")
  sentMessages            Message[]            @relation("MessageSender")
  receivedMessages        Message[]            @relation("MessageReceiver")
  templateAssignmentsMade TemplateAssignment[] @relation("TemplateAssignmentCreatedBy")
  clientAssignments       ClientAssignment[]   @relation("ClientAssignmentCA")
  clientAssignmentsMade   ClientAssignment[]   @relation("ClientAssignmentCreatedBy")
  clientActivityLogs      ClientActivityLog[]  @relation("ClientActivityCA")
  teamActivityLogs        TeamActivityLog[]    @relation("TeamActivityTarget")

  @@index([organizationId])
  @@index([userRole])
  @@map("users")
}

// Firm-internal designation for a team member (distinct from the
// platform-level UserRole that governs which portal they enter).
enum FirmMemberRole {
  CA
  MANAGER
  ARTICLE_ASSISTANT
  ADMIN
}

// Practice area a team member specialises in.
enum Specialization {
  GST
  INCOME_TAX
  AUDIT
  ROC
  ACCOUNTING
  PAYROLL
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  ACCOUNTANT
  STAFF
  VIEWER
}

enum UserRole {
  CUSTOMER
  CA
  CA_FIRM_ADMIN
  ADMIN
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
  COGS
  STOCK
  BANK
  CASH
  TAX
}

enum EntryType {
  DEBIT
  CREDIT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum FileCategory {
  INVOICE
  RECEIPT
  TAX
  PAYROLL
  LOAN
  COMPLIANCE
  OTHER
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ============================================================
// CUSTOMER
// ============================================================
model Customer {
  id                String       @id @default(cuid())
  customerCode      String?
  name              String
  email             String?
  phone             String?
  company           String?
  address           String?
  city              String?
  state             String?
  country           String?
  gstin             String?
  customerType      CustomerType @default(INDIVIDUAL)
  creditLimit       Decimal      @default(0) @db.Decimal(12, 2)
  outstandingAmount Decimal      @default(0) @db.Decimal(12, 2)
  totalPurchases    Decimal      @default(0) @db.Decimal(16, 2)
  lastPurchaseDate  DateTime?
  customerScore     Int?
  tags              String[]
  notes             String?
  isActive          Boolean      @default(true)
  organizationId    String
  firmId            String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firm                Firm?                @relation("FirmCustomers", fields: [firmId], references: [id])
  invoices            Invoice[]
  sales               Sale[]
  recurringInvoices   RecurringInvoice[]
  creditNotes         CreditNote[]
  convertedLeads      Lead[]               @relation("LeadConversion")
  customerAssignments CustomerAssignment[] @relation("CustomerAssignments")
  firmTasks           FirmTask[]           @relation("CustomerFirmTasks")
  templateAssignments TemplateAssignment[] @relation("CustomerTemplateAssignments")
  vaultDocuments      CustomerDocument[]   @relation("CustomerVaultDocuments")

  @@unique([organizationId, customerCode])
  @@index([organizationId, customerType])
  @@index([organizationId])
  @@map("customers")
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
  WHOLESALE
  RETAIL
  GOVERNMENT
}

// ============================================================
// INVOICE
// ============================================================
model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String
  customerId     String
  organizationId String
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  deletedAt      DateTime?
  createdById    String?
  updatedById    String?

  // Amounts
  subtotal   Decimal @db.Decimal(12, 2)
  discount   Decimal @default(0) @db.Decimal(12, 2)
  shipping   Decimal @default(0) @db.Decimal(12, 2)
  taxRate    Decimal @default(0) @db.Decimal(5, 2)
  taxAmount  Decimal @default(0) @db.Decimal(12, 2)
  total      Decimal @db.Decimal(12, 2)
  paidAmount Decimal @default(0) @db.Decimal(12, 2)
  balanceDue Decimal @db.Decimal(12, 2)

  // PDF
  pdfUrl         String?
  pdfFileName    String?
  pdfGeneratedAt DateTime?

  // Metadata
  currency       String    @default("INR")
  notes          String?
  terms          String?
  internalNotes  String? // private — never shown on PDF / public link
  customFields   Json? // [{ label, value }] extra fields rendered on the invoice
  invoicePdf     String?
  sentAt         DateTime?
  viewedAt       DateTime?
  exchangeRate     Decimal?  @db.Decimal(16, 6)
  baseCurrency     String? // For multi-currency tracking
  journalEntryId   String? // Link to general ledger
  incomeAccountId  String? // default income account for ledger posting
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer      Customer           @relation(fields: [customerId], references: [id])
  createdBy     User?              @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  incomeAccount Account?           @relation("InvoiceIncomeAccount", fields: [incomeAccountId], references: [id])
  items         InvoiceItem[]
  payments     Payment[]
  shareLinks   InvoiceShareLink[]
  activities   InvoiceActivity[]
  versions     InvoiceVersion[]
  creditNotes  CreditNote[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@index([organizationId, issueDate])
  @@index([organizationId, createdAt])
  @@index([organizationId])
  @@index([customerId])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PAID
  PARTIAL
  OVERDUE
  CANCELLED
}

// ============================================================
// INVOICE ITEM
// ============================================================
model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  sku         String?
  hsnSac      String? // HSN (goods) / SAC (services) code for GST
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  costPrice   Decimal @default(0) @db.Decimal(12, 2)
  taxPercent  Decimal @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  profit      Decimal @default(0) @db.Decimal(12, 2)

  incomeAccountId String?

  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  incomeAccount Account? @relation("InvoiceItemIncomeAccount", fields: [incomeAccountId], references: [id])

  @@index([invoiceId])
  @@index([incomeAccountId])
  @@map("invoice_items")
}

// ============================================================
// CREDIT NOTE — a credit issued against an invoice. Stored in its
// own table so it never pollutes invoice revenue / outstanding math.
// ============================================================
model CreditNote {
  id               String   @id @default(cuid())
  organizationId   String
  invoiceId        String
  customerId       String
  creditNoteNumber String
  reason           String?
  status           String   @default("ISSUED") // ISSUED, APPLIED, CANCELLED
  currency         String   @default("INR")
  subtotal         Decimal  @db.Decimal(12, 2)
  taxAmount        Decimal  @default(0) @db.Decimal(12, 2)
  total            Decimal  @db.Decimal(12, 2)
  notes            String?
  items            Json // snapshot of credited line items
  issueDate        DateTime @default(now())
  createdById      String?
  accountId        String? // account the credit posts against
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id])
  account      Account?     @relation("CreditNoteAccount", fields: [accountId], references: [id])

  @@unique([organizationId, creditNoteNumber])
  @@index([invoiceId])
  @@index([organizationId])
  @@map("credit_notes")
}

// ============================================================
// PAYMENT
// ============================================================
model Payment {
  id             String        @id @default(cuid())
  invoiceId      String
  organizationId String
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod @default(BANK_TRANSFER)
  reference      String?
  transactionId  String?
  bankName       String?
  paymentGateway String?
  paymentFees    Decimal       @default(0) @db.Decimal(10, 2)
  notes          String?
  paidAt         DateTime      @default(now())
  createdAt      DateTime      @default(now())
  deletedAt      DateTime?
  bankAccountId  String?
  createdById    String?
  journalEntryId String? // Link to general ledger
  depositToAccountId String? // ledger account funds are deposited to

  bankAccount     BankAccount? @relation("BankAccountPayments", fields: [bankAccountId], references: [id])
  invoice         Invoice      @relation(fields: [invoiceId], references: [id])
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User?        @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  depositToAccount Account?    @relation("PaymentDepositAccount", fields: [depositToAccountId], references: [id])

  @@index([organizationId])
  @@index([invoiceId])
  @@map("payments")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  UPI
  CHEQUE
  ONLINE
  OTHER
}

// ============================================================
// INVOICE MODULE — premium workspace (appearance, themes,
// share links, activity timeline, version history)
// All additive; no changes to existing invoice columns.
// ============================================================

// Per-organization invoice appearance / branding for PDFs + preview.
model InvoiceAppearanceSettings {
  id             String @id @default(cuid())
  organizationId String @unique

  // Theme + branding
  template          String  @default("elegant-purple") // active built-in theme key
  accentColor       String  @default("#6366f1")
  fontFamily        String  @default("Helvetica")
  borderRadius      Int     @default(8)
  invoiceTitle      String  @default("INVOICE")
  footerText        String  @default("Generated securely by FinRP")
  signatureText     String?
  signatureImageUrl String?
  watermarkText     String?
  draftWatermark    Boolean @default(true)
  logoUrl           String? // overrides BusinessProfile.logoUrl when set

  // Visibility toggles
  showLogo            Boolean @default(true)
  showQr              Boolean @default(false)
  showPaymentLink     Boolean @default(false)
  showDueStamp        Boolean @default(true)
  showGst             Boolean @default(true)
  showPan             Boolean @default(true)
  showItemDescription Boolean @default(true)
  showDiscountColumn  Boolean @default(true)
  showTaxColumn       Boolean @default(true)
  showShipping        Boolean @default(true)
  showNotes           Boolean @default(true)
  showTerms           Boolean @default(true)

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("invoice_appearance_settings")
}

// Saved / custom invoice templates (built-ins live in code; users can save variants).
model InvoiceTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  key            String // theme key: modern-minimal, executive-dark, glass-premium, corporate-blue, elegant-purple, classic-accounting
  isBuiltIn      Boolean  @default(false)
  isDefault      Boolean  @default(false)
  config         Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invoice_templates")
}

// Secure public share links for an invoice.
model InvoiceShareLink {
  id             String    @id @default(cuid())
  invoiceId      String
  organizationId String
  token          String    @unique
  passwordHash   String?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  viewCount      Int       @default(0)
  lastViewedAt   DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([token])
  @@map("invoice_share_links")
}

// Activity / audit timeline entries for an invoice.
model InvoiceActivity {
  id             String   @id @default(cuid())
  invoiceId      String
  organizationId String
  type           String // CREATED, STATUS_CHANGED, UPDATED, PDF_GENERATED, PAYMENT_RECORDED, EMAIL_SENT, SHARED, VIEWED, DELETED
  message        String
  metadata       Json?
  actorId        String?
  actorName      String?
  createdAt      DateTime @default(now())

  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([invoiceId, createdAt])
  @@index([organizationId])
  @@map("invoice_activities")
}

// Immutable version snapshots of an invoice (history / restore).
model InvoiceVersion {
  id             String   @id @default(cuid())
  invoiceId      String
  organizationId String
  version        Int
  snapshot       Json
  changedById    String?
  changeSummary  String?
  createdAt      DateTime @default(now())

  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, version])
  @@index([invoiceId])
  @@map("invoice_versions")
}

// ============================================================
// COMPLIANCE TASK
// ============================================================
model ComplianceTask {
  id             String        @id @default(cuid())
  title          String
  description    String?
  category       TaskCategory  @default(OTHER)
  status         TaskStatus    @default(PENDING)
  priority       PriorityLevel @default(MEDIUM)
  dueDate        DateTime
  reminderDate   DateTime?
  completedAt    DateTime?
  penaltyAmount  Decimal?      @db.Decimal(12, 2)
  documentUrl    String?
  assignedToId   String?
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("AssignedTo", fields: [assignedToId], references: [id])

  @@index([organizationId])
  @@index([organizationId, status, dueDate])
  @@map("compliance_tasks")
}

enum TaskCategory {
  TAX
  GST
  TDS
  REGULATORY
  LICENSE
  AUDIT
  REPORTING
  OTHER
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

// ============================================================
// BUSINESS PROFILE (Extended org details — one-to-one)
// ============================================================
model BusinessProfile {
  id             String @id @default(cuid())
  organizationId String @unique

  // Identity
  businessName   String
  businessType   String?
  registrationNo String?
  taxId          String? // GST / VAT / EIN
  gstin          String?
  pan            String?
  cin            String?
  industry       String?
  companySize    String? // "1-10", "11-50", etc.

  // Location
  country String?
  state   String?
  city    String?
  address String?
  pincode String?

  // Preferences
  currency        String         @default("INR")
  timezone        String         @default("Asia/Kolkata")
  language        String         @default("en")
  fiscalYearStart DateTime?
  fiscalYearType  FiscalYearType @default(APRIL_MARCH)

  // Financial setup (onboarding)
  initialCapital         Decimal? @db.Decimal(16, 2)
  openingBankBalance     Decimal? @db.Decimal(16, 2)
  openingCashBalance     Decimal? @db.Decimal(16, 2)
  monthlyRevenueEstimate Decimal? @db.Decimal(16, 2)
  monthlyExpenseEstimate Decimal? @db.Decimal(16, 2)
  defaultTaxRate         Decimal? @db.Decimal(5, 2)
  profitMarginTarget     Decimal? @db.Decimal(5, 2)
  paymentTermsDays       Int      @default(30)
  invoicePrefix          String   @default("INV")
  loanInterestBenchmark  Decimal? @db.Decimal(5, 2)

  // Inventory setup
  inventoryEnabled  Boolean @default(true)
  warehouseName     String?
  lowStockThreshold Int     @default(10)
  skuFormat         String?
  unitsUsed         String?

  // Compliance setup
  taxFilingFrequency String?
  gstFilingDates     String?
  licenseExpiryDates Json?
  auditSchedule      String?
  payrollTaxEnabled  Boolean @default(false)

  // Branding
  logoUrl      String?
  website      String?
  websiteUrl   String?
  contactEmail String?
  contactPhone String?
  phone        String?

  // Onboarding
  onboardingComplete Boolean @default(false)
  onboardingStep     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

enum FiscalYearType {
  APRIL_MARCH // India
  JANUARY_DECEMBER
  JULY_JUNE
  OCTOBER_SEPTEMBER
}

// ============================================================
// ANALYTICS RECORD
// ============================================================
model AnalyticsRecord {
  id             String   @id @default(cuid())
  organizationId String
  period         String // e.g. "2025-01", "2025-Q1"
  metric         String // e.g. "revenue", "invoices_count", "new_customers"
  value          Decimal  @db.Decimal(16, 4)
  metadata       Json?
  recordedAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([period])
  @@index([metric])
  @@map("analytics_records")
}

// ============================================================
// ITEM (Inventory Catalog)
// ============================================================
model Item {
  id          String    @id @default(cuid())
  sku         String?
  barcode     String?
  name        String
  description String?
  category    String?
  brand       String?
  unit        String?
  image       String?
  batchNumber String?
  expiryDate  DateTime?
  deletedAt   DateTime?

  // Pricing
  costPrice    Decimal @default(0) @db.Decimal(12, 2)
  sellingPrice Decimal @default(0) @db.Decimal(12, 2)
  taxRate      Decimal @default(0) @db.Decimal(5, 2)

  // Stock
  stock        Int @default(0)
  reorderLevel Int @default(10)
  lowStockAt   Int @default(10)

  // Storage
  warehouse String?

  isActive       Boolean  @default(true)
  organizationId String
  vendorId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor        Vendor?        @relation(fields: [vendorId], references: [id])
  transactions  Transaction[]
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]

  @@unique([organizationId, sku])
  @@index([organizationId, category])
  @@index([organizationId, stock])
  @@index([organizationId])
  @@map("items")
}

// ============================================================
// VENDOR / SUPPLIER
// ============================================================
model Vendor {
  id                 String    @id @default(cuid())
  vendorCode         String? // org-level unique handled separately
  name               String
  contactPerson      String?
  email              String?
  phone              String?
  address            String?
  city               String?
  state              String?
  country            String?
  gstin              String?
  bankName           String?
  bankAccount        String?
  bankIFSC           String?
  outstandingBalance Decimal   @default(0) @db.Decimal(12, 2)
  totalPurchases     Decimal   @default(0) @db.Decimal(16, 2)
  paymentTermsDays   Int       @default(30)
  category           String?
  tags               String[]
  notes              String?
  isActive           Boolean   @default(true)
  organizationId     String
