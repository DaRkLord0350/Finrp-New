  businessOrganization Organization? @relation("CARelationshipBusiness", fields: [businessOrganizationId], references: [id], onDelete: Cascade)

  @@unique([caOrganizationId, businessOrganizationId])
  @@index([caOrganizationId, status])
  @@index([businessOrganizationId, status])
  @@index([caOrganizationId, invitedEmail])
  @@index([invitedEmail])
  @@map("ca_relationships")
}

