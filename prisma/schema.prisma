model TdsDeduction {
  id             String    @id @default(cuid())
  organizationId String
  deducteeId     String
  challanId      String?
  section        String
  financialYear  String
  quarter        String
  paymentDate    DateTime
  amountPaid     Decimal   @default(0) @db.Decimal(16, 2)
  tdsRate        Decimal   @default(0) @db.Decimal(5, 2)
