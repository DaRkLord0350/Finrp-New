// ============================================================
// TBX Payments (Phase 2D) — outbound vendor-bill payments via TBX
// Corporate Internet Banking, driven through a Maker-Checker
// approval workflow. Attaches to Purchase (Accounts Payable), never
// to Invoice (Accounts Receivable) — see architecture decision.
//
// State machine (matches TBX brief exactly):
//   DRAFT -> CHECKER_PENDING -> SUBMITTED -> PROCESSING -> SUCCESS
//                            \-> CANCELLED            \-> FAILED
// MAKER_PENDING is part of the vocabulary (matches the brief's
// status list) and reserved for the BULK-payment batch-assembly
// flow; today's single-payment flow moves DRAFT straight to
// CHECKER_PENDING on submit. A checker rejection resolves to
// CANCELLED (captured via rejectionReason + a REJECTED log event).
//
// VendorPaymentLog is an immutable append-only trail (mirrors
// TaxFilingSubmission/TaxFilingLog — a status state machine needs
// fromStatus/toStatus/providerResponse fields the generic AuditLog
// doesn't have), never updated or deleted.
// ============================================================
model VendorPayment {
  id             String @id @default(cuid())
  organizationId String
  purchaseId     String
  bankAccountId  String // paying FROM this org bank account

  amount       Decimal          @db.Decimal(12, 2)
  paymentType  TbxPaymentType
  status       TbxPaymentStatus @default(DRAFT)
  batchId      String? // groups legs of a BULK payment submission
  scheduledFor DateTime? // future-dated run for SCHEDULED type

  // Maker-Checker
  makerById       String?
  makerAt         DateTime?
  makerNote       String?
  checkerById     String?
  checkerAt       DateTime?
  rejectionReason String?

  // TBX provider state
  tbxPaymentId  String? // TBX's reference for this payment instruction
  tbxUtr        String? // settlement UTR once processed
  tbxStatus     String? // raw status string from TBX, for diagnostics
  failureReason String?
  submittedAt   DateTime? // when pushed to TBX
  processedAt   DateTime? // terminal SUCCESS/FAILED timestamp

  journalEntryId String? // Link to general ledger — set only on SUCCESS

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchase     Purchase           @relation(fields: [purchaseId], references: [id])
  bankAccount  BankAccount        @relation("VendorPaymentBankAccount", fields: [bankAccountId], references: [id])
  maker        User?              @relation("VendorPaymentMaker", fields: [makerById], references: [id])
  checker      User?              @relation("VendorPaymentChecker", fields: [checkerById], references: [id])
  logs         VendorPaymentLog[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([purchaseId])
  @@index([bankAccountId])
  @@index([batchId])
  @@map("vendor_payments")
}

// IMMUTABLE: rows are only ever appended — never updated or deleted.
model VendorPaymentLog {
  id               String             @id @default(cuid())
  paymentId        String
  organizationId   String
  event            VendorPaymentEvent
  fromStatus       TbxPaymentStatus?
  toStatus         TbxPaymentStatus?
  actorId          String?
  actorRole        String?
  detail           String?
  providerResponse Json?
  createdAt        DateTime           @default(now())

  payment VendorPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@index([organizationId, createdAt])
  @@map("vendor_payment_logs")
