  firmId           String?
  snapshotDate     DateTime
  totalClients     Int      @default(0)
  gstDue           Int      @default(0)
  tdsDue           Int      @default(0)
  itrDue           Int      @default(0)
  rocDue           Int      @default(0)
  auditPending     Int      @default(0)
  overdueCount     Int      @default(0)
