// ============================================================
// =================== BANKING OS MODELS ======================
// ============================================================

// ============================================================
// BANK TRANSACTION
// ============================================================
model BankTransaction {
  id             String @id @default(cuid())
  organizationId String
  bankAccountId  String

  transactionDate DateTime
  valueDate       DateTime?
  narration       String
  referenceNumber String?
  chequeNumber    String?
  utr             String? // NEFT/RTGS/IMPS Unique Transaction Reference, distinct from referenceNumber

  // Amounts
  credit  Decimal? @db.Decimal(16, 2)
  debit   Decimal? @db.Decimal(16, 2)
  balance Decimal? @db.Decimal(16, 2)

  // Classification
  category    String?
  subCategory String?
  gstCategory GSTCategory?
  txnType     BankTxnType  @default(UNKNOWN)

  // GST correlation
  gstin      String?
  invoiceRef String?
  gstAmount  Decimal? @db.Decimal(16, 2)

  // Status
  status          BankTxnStatus   @default(UNREVIEWED)
  reconcileStatus ReconcileStatus @default(UNMATCHED)

  // Source
  source        BankTxnSource @default(MANUAL)
  importJobId   String?
  externalTxnId String? // provider txn id (AA dedup key)

  // Ledger posting (Phase 2B — statement.sync.ts posts each transaction once)
  journalEntryId   String? // Link to general ledger
  postedToLedgerAt DateTime?

  // Entity link (after matching)
  entityType String?
  entityId   String?

  // Flags
  isFlagged        Boolean @default(false)
  isDuplicate      Boolean @default(false)
  isIgnored        Boolean @default(false)
  requiresApproval Boolean @default(false)

  // Metadata
  tags         String[]
  notes        String?
  metadata     Json?
  aiCategory   String?
  aiConfidence Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount      BankAccount           @relation("BankAccountTransactions", fields: [bankAccountId], references: [id])
  reconcileMatches ReconciliationMatch[]
  riskAlerts       BankRiskAlert[]

  @@unique([bankAccountId, externalTxnId])
  @@index([organizationId, transactionDate])
  @@index([organizationId, bankAccountId])
  @@index([organizationId, status])
  @@index([organizationId, reconcileStatus])
  @@index([bankAccountId, transactionDate])
  @@map("bank_transactions")
}

enum BankTxnType {
  UPI
  NEFT
  RTGS
  IMPS
  CHEQUE
  CASH
  EMI
  SALARY
  GST_PAYMENT
  TDS_PAYMENT
  VENDOR_PAYMENT
  CUSTOMER_RECEIPT
  BANK_CHARGE
  INTEREST
  DIVIDEND
  LOAN_EMI
  REFUND
  REVERSAL
  UNKNOWN
}

enum BankTxnStatus {
  UNREVIEWED
  REVIEWED
  CATEGORIZED
  MATCHED
  EXCLUDED
}

enum ReconcileStatus {
  UNMATCHED
  MATCHED
  PARTIAL
  EXCEPTION
  DUPLICATE
  IGNORED
}

enum BankTxnSource {
  TBX_API
  MANUAL
}

enum GSTCategory {
  B2B_PURCHASE
  B2B_SALE
  B2C_SALE
  GST_PAYMENT
  GST_REFUND
  IMPORT
  EXPORT
  RCM_PAYMENT
  EXEMPT
  UNKNOWN
}

// ============================================================
// RAW BANK STATEMENT (Phase 2B — cache of the raw TBX Statement API
// response before parsing, distinct from the file-upload-shaped
// BankStatementImport that was removed with Setu/CSV import)
// ============================================================
model RawBankStatement {
  id             String @id @default(cuid())
  organizationId String
  bankAccountId  String

  requestDate DateTime @default(now())
  fromDate    DateTime
  toDate      DateTime

  rawJson Json
  status  RawStatementStatus @default(REQUESTED)

  fetchedAt    DateTime?
  parsedAt     DateTime?
  errorMessage String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount  BankAccount  @relation("BankAccountRawStatements", fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([organizationId, bankAccountId])
  @@index([organizationId, status])
  @@map("raw_bank_statements")
}

enum RawStatementStatus {
  REQUESTED
  FETCHED
  PARSED
  FAILED
}

// ============================================================
// BANKING RULE (Auto-categorization engine)
// ============================================================
model BankingRule {
  id             String @id @default(cuid())
  organizationId String

  name        String
  description String?

  priority Int     @default(100)
  isActive Boolean @default(true)
  isSystem Boolean @default(false)

  // Conditions: [{field, operator, value, logic}]
  conditions Json

  // Actions: [{type, value}]
  actions Json

  matchCount    Int       @default(0)
  lastMatchedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive])
  @@index([organizationId, priority])
  @@map("banking_rules")
}

// ============================================================
// BANK RECONCILIATION SESSION
// ============================================================
model BankReconciliationSession {
  id             String @id @default(cuid())
  organizationId String
  bankAccountId  String

  name      String?
  startDate DateTime
  endDate   DateTime

  status ReconcileSessionStatus @default(IN_PROGRESS)

  totalTxns     Int @default(0)
  matchedTxns   Int @default(0)
  unmatchedTxns Int @default(0)
  exceptionTxns Int @default(0)

  openingBalance Decimal? @db.Decimal(16, 2)
  closingBalance Decimal? @db.Decimal(16, 2)

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount  BankAccount           @relation("BankAccountReconciliations", fields: [bankAccountId], references: [id])
  matches      ReconciliationMatch[]

  @@index([organizationId, bankAccountId])
  @@index([organizationId, status])
  @@map("bank_reconciliation_sessions")
}

enum ReconcileSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

// ============================================================
// RECONCILIATION MATCH
// ============================================================
model ReconciliationMatch {
  id                String @id @default(cuid())
  sessionId         String
  bankTransactionId String

  entityType String?
  entityId   String?
  entityRef  String?

  matchType  MatchType       @default(MANUAL)
  confidence Decimal?        @db.Decimal(5, 2)
  status     ReconcileStatus @default(MATCHED)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session         BankReconciliationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  bankTransaction BankTransaction           @relation(fields: [bankTransactionId], references: [id])

  @@index([sessionId])
  @@index([bankTransactionId])
  @@map("reconciliation_matches")
}

enum MatchType {
  AUTO
  MANUAL
  SUGGESTED
}

// AAProvider is reused as a generic "sync/webhook source" tag by
// BankSyncHistory and BankWebhookEvent below — the name predates
// non-Account-Aggregator usage (TBX's Corporate Internet Banking is
// not an AA), kept as-is to avoid churn on two live models.
enum AAProvider {
  TBX
  MANUAL
}

// ============================================================
// BANK CONNECTION (API integration config)
// ============================================================
model BankConnection {
  id             String @id @default(cuid())
  organizationId String

  provider    BankProvider @default(MANUAL)
  name        String?
  displayName String?

  accessToken   String?
  refreshToken  String?
  webhookSecret String?

  status      ConnectionStatus @default(DISCONNECTED)
  lastSyncAt  DateTime?
  nextSyncAt  DateTime?
  healthScore Int?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccounts BankAccount[] @relation("BankConnectionAccounts")

  @@unique([organizationId, provider])
  @@index([organizationId])
  @@map("bank_connections")
