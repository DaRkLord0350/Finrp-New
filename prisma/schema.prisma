  status ConsentStatus @default(PENDING)

  startDate   DateTime?
  endDate     DateTime?
  consentType String?
  frequency   String?

  fiTypes String[]

  metadata Json?

  // Lifecycle + audit
  vua             String? // masked customer AA handle (e.g. 99XXXXXX99@onemoney)
  purposeCode     String?   @default("101")
  redirectUrl     String?
  approvedAt      DateTime?
  revokedAt       DateTime?
  rejectedAt      DateTime?
  lastDataFetchAt DateTime?
  failureReason   String?
  createdById     String? // DB User.id of the customer who initiated
