  phone String?

  company String?

  source String?

  valueEstimate Decimal? @db.Decimal(12, 2)

  status LeadStatus @default(NEW)

  assignedToId String?

  notes String?

  convertedToCustomerId String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

