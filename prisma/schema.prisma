// ============================================================
// ============ CA PORTAL (REBUILD) ===========================
// ============================================================
// Customer-centric CA workspace. Convention (mirrors tax/ca_hub
// models): plain scalar customerId / organizationId / caUserId
// (firm tenant + CRM Customer ids) with NO back-relations on the
// shared User / Customer / Organization models. The only relation
// is to CustomerDocument, which needs nested includes.
//   • customerId      → CRM Customer (firm-scoped)
//   • organizationId  → firm's org (tenant that owns the row)
//   • caUserId        → assigned CA User
// Virtual Access maps these 5 tiers onto the existing
// ClientPermission[] impersonation system (lib/workspace/*).
// ============================================================

// ── Virtual Access — 5-tier governance layer ────────────────
enum CAWorkspaceAccessTier {
  READ_ONLY
  READ_WRITE
  ACCOUNTING_ONLY
  COMPLIANCE_ONLY
  FULL_ACCESS
}

model CAWorkspacePermission {
  id             String                @id @default(cuid())
  caUserId       String
  customerId     String
  organizationId String? // customer's onboarded org (bridge), null until onboarded
  tier           CAWorkspaceAccessTier @default(READ_ONLY)
  grantedById    String
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([caUserId, customerId])
  @@index([caUserId])
  @@index([customerId])
  @@index([organizationId])
  @@map("ca_workspace_permissions")
}

