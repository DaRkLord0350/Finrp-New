// ============================================================
// PURCHASE ITEM
// ============================================================
model PurchaseItem {
  id          String  @id @default(cuid())
  purchaseId  String
  itemId      String?
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitCost    Decimal @db.Decimal(12, 2)
  taxPercent  Decimal @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)

  expenseAccountId String?

  purchase       Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item           Item?    @relation(fields: [itemId], references: [id])
  expenseAccount Account? @relation("PurchaseItemExpenseAccount", fields: [expenseAccountId], references: [id])

  @@index([purchaseId])
  @@index([expenseAccountId])
  @@map("purchase_items")
}

// ============================================================
// EXPENSE (Operational expenses)
// ============================================================
model Expense {
  id                 String          @id @default(cuid())
  category           ExpenseCategory @default(OPERATIONS)
  description        String
  amount             Decimal         @db.Decimal(12, 2)
  organizationId     String
  vendorName         String?
  department         String?
  approvedBy         String?
  receiptUrl         String?
  recurring          Boolean         @default(false)
  recurringFrequency String? // "monthly", "weekly", "yearly"
  taxAmount          Decimal         @default(0) @db.Decimal(12, 2)
  notes              String?
  expenseDate        DateTime        @default(now())
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?
  createdById        String?
  paymentAccountId   String?
  journalEntryId     String? // Link to general ledger

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  paymentAccount Account?     @relation("ExpensePaymentAccount", fields: [paymentAccountId], references: [id])

  @@index([organizationId, expenseDate])
  @@index([organizationId])
  @@map("expenses")
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARIES
  MARKETING
  TRAVEL
  SOFTWARE
  EQUIPMENT
  LOGISTICS
  MAINTENANCE
  OPERATIONS
  TAXES
  OTHER
}

// ============================================================
// EMPLOYEE
// ============================================================
model Employee {
  id               String         @id @default(cuid())
  employeeCode     String?
  name             String
  email            String?
  phone            String?
  designation      String?
  department       String?
  employmentType   EmploymentType @default(FULL_TIME)
  joiningDate      DateTime?
  resignationDate  DateTime?
  baseSalary       Decimal        @db.Decimal(12, 2)
  hra              Decimal        @default(0) @db.Decimal(12, 2)
  pf               Decimal        @default(0) @db.Decimal(10, 2)
  esi              Decimal        @default(0) @db.Decimal(10, 2)
  bankAccount      String?
  bankName         String?
  panNumber        String?
  aadharNumber     String?
  address          String?
  emergencyContact String?
  avatarUrl        String?
  isActive         Boolean        @default(true)
  organizationId   String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payroll      Payroll[]

  @@unique([organizationId, employeeCode])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("employees")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  CONSULTANT
  INTERN
}

// ============================================================
// PAYROLL (Employee payroll records)
// ============================================================
model Payroll {
  id             String    @id @default(cuid())
  employeeId     String?
  employeeName   String
  designation    String?
  department     String?
  organizationId String
  payPeriod      String // e.g. "2026-04"
  payPeriodStart DateTime?
  payPeriodEnd   DateTime?

  // Earnings
  baseSalary Decimal @db.Decimal(12, 2)
  hra        Decimal @default(0) @db.Decimal(12, 2)
  bonus      Decimal @default(0) @db.Decimal(12, 2)
  overtime   Decimal @default(0) @db.Decimal(12, 2)
  allowances Decimal @default(0) @db.Decimal(12, 2)
  grossPay   Decimal @db.Decimal(12, 2)

  // Deductions
  pf              Decimal @default(0) @db.Decimal(12, 2)
  esi             Decimal @default(0) @db.Decimal(12, 2)
  tax             Decimal @default(0) @db.Decimal(12, 2)
  otherDeductions Decimal @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal @db.Decimal(12, 2)

  // Summary
  netPay         Decimal       @db.Decimal(12, 2)
  attendanceDays Int?
  leaveDays      Int?
  paymentMethod  PaymentMethod @default(BANK_TRANSFER)
  paidAt         DateTime      @default(now())
  notes          String?
  journalEntryId String? // Link to general ledger
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee?    @relation(fields: [employeeId], references: [id])

  @@index([organizationId])
  @@index([organizationId, payPeriod])
  @@map("payroll")
}

// ============================================================
// MEMBERSHIP (User ↔ Organization many-to-many with roles)
// Complements User.role for multi-org and invite flow support.
// ============================================================
model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role
  invitedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

// ============================================================
// ROLE PERMISSION (Per-org custom-role overrides)
//
// Optional, organization-scoped overrides of the static code
// matrix in lib/auth/permissions.ts. When NO rows exist for an
// (organizationId, role) pair, the resolver falls back to the
// code defaults — so this table is purely additive and safe to
// leave empty. One row per (org, role, module) holds the CRUD
// flags; lib/auth/permission-resolver.ts expands them back into
// the flat `<resource>.<action>` permission list. OWNER is never
// customizable (always full access).
// ============================================================
model RolePermission {
  id             String   @id @default(cuid())
  organizationId String
  role           Role
  module         String // AppModule string (crm, billing, finance, ...)
  canView        Boolean  @default(false)
  canCreate      Boolean  @default(false)
  canEdit        Boolean  @default(false)
  canDelete      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, role, module])
  @@index([organizationId])
  @@map("role_permissions")
}

// ============================================================
// INVITATION (Pending team invites)
// ============================================================
model Invitation {
  id              String           @id @default(cuid())
  organizationId  String
  email           String
  role            Role
  token           String           @unique @default(cuid())
  expiresAt       DateTime
  acceptedAt      DateTime?
  invitedBy       String?
  createdAt       DateTime         @default(now())
  // ── Firm team-member invite payload (Phase 3) ───────────────
  name            String?
  phone           String?
  firmId          String?
  firmRole        FirmMemberRole?
  specialization  Specialization?
  joiningDate     DateTime?
  userRole        UserRole? // CA | CA_FIRM_ADMIN to grant on accept
  firmPermissions FirmPermission[] @default([]) // carried to User on accept (Add-CA wizard)
  managerId       String? // reporting manager carried to User on accept
  emailOpenedAt   DateTime? // onboarding stage: invite link engaged (EMAIL_OPENED)
  // ── Email delivery status (Resend) ──────────────────────────
  emailSentAt     DateTime? // when Resend accepted the invite email
  emailMessageId  String? // Resend message id for the last dispatch
  emailError      String? // last send failure (null once a send succeeds)
  status          InviteStatus     @default(PENDING)
  revokedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([status])
  @@map("invitations")
}

// ============================================================
// TEAM ACTIVITY LOG (Phase 3 — firm team management audit trail;
// also the foundation reused by the Phase 10 audit module)
// ============================================================
model TeamActivityLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String? // user who performed the action
  actorName      String?
  targetUserId   String? // affected member (when they have a User row)
  targetEmail    String? // affected member email (covers pending invites)
  action         String // MEMBER_INVITED | MEMBER_UPDATED | MEMBER_DEACTIVATED | MEMBER_REACTIVATED | MEMBERS_IMPORTED | PERMISSIONS_UPDATED | INVITE_RESENT | INVITE_REVOKED
  module         String   @default("TEAM")
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  targetUser   User?        @relation("TeamActivityTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([targetUserId])
  @@map("team_activity_logs")
}

// ============================================================
// =================== INTEGRATION PLATFORM ===================
// ============================================================

// ============================================================
// INTEGRATION (Connector connection record — one per provider)
// ============================================================
model Integration {
  id               String            @id @default(cuid())
  organizationId   String
  type             ConnectorType
  name             String
  status           IntegrationStatus @default(INACTIVE)
  config           Json? // non-sensitive config (data center, server URL, etc.)
  lastSyncAt       DateTime?
  lastSyncStatus   SyncJobStatus?
  lastSyncError    String?
  syncIntervalMins Int               @default(60)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  oauthToken    OAuthToken?
  syncJobs      SyncJob[]
  importJobs    ImportJob[]
  fieldMappings FieldMapping[]
  webhookEvents WebhookEvent[]

  @@unique([organizationId, type])
  @@index([organizationId])
  @@map("integrations")
}

enum ConnectorType {
  ZOHO_CRM
  ZOHO_BOOKS
  ZOHO_INVENTORY
  TALLY
  ODOO
  CSV
  EXCEL
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
  ERROR
  PENDING_AUTH
  EXPIRED
  SYNCING
}

// ============================================================
// OAUTH TOKEN (encrypted at rest — AES-256-GCM)
// ============================================================
model OAuthToken {
  id             String    @id @default(cuid())
  integrationId  String    @unique
  organizationId String
  accessToken    String // AES-256-GCM encrypted ciphertext
  refreshToken   String? // AES-256-GCM encrypted ciphertext
  tokenType      String    @default("Bearer")
  scope          String?
  expiresAt      DateTime?
  grantedScopes  String[]
  accountId      String? // Zoho accountId / Odoo dbname
  serverUrl      String? // Odoo instance URL
  metadata       Json? // provider-specific data
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("oauth_tokens")
}

// ============================================================
// SYNC JOB (background connector sync run)
// ============================================================
model SyncJob {
  id               String        @id @default(cuid())
  organizationId   String
  integrationId    String
  type             SyncJobType
  entity           String? // "customers" | "invoices" | "products" | "all"
  status           SyncJobStatus @default(QUEUED)
  bullmqJobId      String?
  startedAt        DateTime?
  completedAt      DateTime?
  totalRecords     Int           @default(0)
  processedRecords Int           @default(0)
  successRecords   Int           @default(0)
  failedRecords    Int           @default(0)
  lastCursor       String? // incremental sync cursor (ISO date or page token)
  scheduledAt      DateTime?
  triggeredBy      String? // userId who triggered
  error            String?
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  logs         SyncLog[]

  @@index([integrationId, status])
  @@index([organizationId, status])
  @@map("sync_jobs")
}

enum SyncJobType {
  FULL
  INCREMENTAL
  ENTITY_SPECIFIC
  TRIGGERED
  SCHEDULED
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  PAUSED
}

// ============================================================
// SYNC LOG (per-record audit trail)
// ============================================================
model SyncLog {
  id         String        @id @default(cuid())
  syncJobId  String
  entityType String
  entityId   String? // our DB record id
  externalId String? // source system id
  action     SyncAction
  status     SyncLogStatus @default(SUCCESS)
  data       Json?
  error      String?
  durationMs Int?
  createdAt  DateTime      @default(now())

  syncJob SyncJob @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@index([syncJobId])
  @@index([syncJobId, status])
  @@index([entityType, entityId])
  @@map("sync_logs")
}

enum SyncAction {
  CREATE
  UPDATE
  SKIP
  DELETE
  MERGE
  ERROR
}

enum SyncLogStatus {
  SUCCESS
  FAILED
  SKIPPED
  WARNING
}

// ============================================================
// IMPORT JOB (CSV/Excel file import)
// ============================================================
model ImportJob {
  id              String       @id @default(cuid())
  organizationId  String
  integrationId   String?
  type            ImportType
  entity          ImportEntity
  status          ImportStatus @default(PENDING)
  bullmqJobId     String?
  fileName        String
  originalName    String
  fileSize        Int
  filePath        String // local tmp path or cloud URL
  mimeType        String
  totalRows       Int          @default(0)
  processedRows   Int          @default(0)
  successRows     Int          @default(0)
  failedRows      Int          @default(0)
  skippedRows     Int          @default(0)
  duplicateRows   Int          @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  queuedAt        DateTime? // set when BullMQ job is confirmed in Redis
  failedAt        DateTime? // set when status → FAILED
  lastHeartbeatAt DateTime? // worker updates this every 10 s — detect crashes
  retryCount      Int          @default(0)
  uploadedById    String
  fieldMapping    Json? // saved column → field mappings
  options         Json? // { skipDuplicates, updateExisting, dryRun }
  detectedColumns String[] // detected CSV headers
  errorFilePath   String? // downloadable error CSV path
  error           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration?  @relation(fields: [integrationId], references: [id])
  rows         ImportRow[]
  errors       ImportError[]

  @@index([organizationId, status])
  @@index([organizationId, entity])
  @@index([status])
  @@index([bullmqJobId])
  @@index([createdAt])
  @@map("import_jobs")
}

enum ImportType {
  CSV
  EXCEL
  JSON
  XML
}

enum ImportEntity {
  CUSTOMERS
  VENDORS
  INVOICES
  PRODUCTS
  EMPLOYEES
  EXPENSES
  PAYMENTS
  LEADS
  CA_USERS
  FIRMS
  ASSIGNMENTS
  MASTER_IMPORT
}

enum ImportStatus {
  PENDING
  QUEUED
  MAPPING
  VALIDATING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  PARTIAL
}

// ============================================================
// IMPORT ROW (staging table — one row per source record)
// ============================================================
model ImportRow {
  id             String    @id @default(cuid())
  importJobId    String
  rowIndex       Int
  rawData        Json // original CSV row as key-value
  mappedData     Json? // after field mapping applied
  normalizedData Json? // after normalization (GST, dates, etc.)
  status         RowStatus @default(PENDING)
  isDuplicate    Boolean   @default(false)
  mergedIntoId   String? // entityId it was merged into
  entityId       String? // created/updated entity id
  error          String?
  warnings       String[]
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  importJob ImportJob     @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  errors    ImportError[]

  @@index([importJobId, status])
  @@index([importJobId, rowIndex])
  @@map("import_rows")
}

enum RowStatus {
  PENDING
  SUCCESS
  FAILED
  SKIPPED
  DUPLICATE
  MERGED
}

// ============================================================
// IMPORT ERROR (validation and processing errors)
// ============================================================
model ImportError {
  id          String        @id @default(cuid())
  importJobId String
  importRowId String?
  rowIndex    Int?
  field       String?
  errorCode   String
  message     String
  value       String? // the value that caused the error
  severity    ErrorSeverity @default(ERROR)
  createdAt   DateTime      @default(now())

  importJob ImportJob  @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  importRow ImportRow? @relation(fields: [importRowId], references: [id])

  @@index([importJobId])
  @@index([importRowId])
  @@map("import_errors")
}

enum ErrorSeverity {
  ERROR
  WARNING
  INFO
}

// ============================================================
// FIELD MAPPING (saved reusable column mapping templates)
// ============================================================
model FieldMapping {
  id             String        @id @default(cuid())
  organizationId String
  integrationId  String?
  name           String
  entity         ImportEntity
  sourceType     ConnectorType
  mappings       Json // MappingRule[] — see connector types
  isDefault      Boolean       @default(false)
  useCount       Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration? @relation(fields: [integrationId], references: [id])

  @@index([organizationId, entity])
  @@map("field_mappings")
}

// ============================================================
// WEBHOOK EVENT (inbound webhooks from Zoho, etc.)
// ============================================================
model WebhookEvent {
  id             String        @id @default(cuid())
  organizationId String
  integrationId  String
  source         ConnectorType
  eventType      String
  externalId     String? // provider event id (for dedup)
  payload        Json
  rawPayload     String? // raw body for signature verify
  signature      String?
  status         WebhookStatus @default(PENDING)
  bullmqJobId    String?
  processedAt    DateTime?
  error          String?
  retryCount     Int           @default(0)
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([externalId])
  @@map("webhook_events")
}

enum WebhookStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

// ============================================================
// INVOICE COUNTER (Atomic sequence for collision-safe numbering)
// ============================================================
model InvoiceCounter {
  id             String @id @default(cuid())
  organizationId String
  year           Int
  lastNumber     Int    @default(0)

  @@unique([organizationId, year])
  @@index([organizationId])
  @@map("invoice_counters")
}

// ============================================================
// =============== COMPLIANCE MANAGEMENT MODULE ===============
// ============================================================

enum ComplianceStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  PENDING_RENEWAL
  COMPLETED
}

enum ComplianceApprovalAction {
  APPROVE
  REJECT
  REQUEST_CHANGES
  ESCALATE
}

enum ComplianceReminderType {
  DUE_DATE
  EXPIRY
  PENDING_APPROVAL
  REJECTED_FOLLOW_UP
  RENEWAL
  CUSTOM
}

// ============================================================
// COMPLIANCE CATEGORY (dynamic, org-scoped categories)
// ============================================================
model ComplianceCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  code           String
  color          String   @default("#6366f1")
  icon           String   @default("ShieldCheck")
  isActive       Boolean  @default(true)
  isSystem       Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  types        ComplianceType[]
  submissions  ComplianceSubmission[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("compliance_categories")
}

// ============================================================
// COMPLIANCE TYPE (sub-types within categories)
// ============================================================
model ComplianceType {
  id                String   @id @default(cuid())
  organizationId    String
  categoryId        String
  name              String
  description       String?
  code              String
  requiredDocuments String[]
  validityDays      Int?
  defaultPenalty    Decimal? @db.Decimal(12, 2)
  isActive          Boolean  @default(true)
  isSystem          Boolean  @default(false)
  sortOrder         Int      @default(0)
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     ComplianceCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  submissions  ComplianceSubmission[]

  @@unique([organizationId, categoryId, code])
  @@index([organizationId, categoryId])
  @@map("compliance_types")
}

// ============================================================
// COMPLIANCE DOCUMENT (PostgreSQL BYTEA binary storage)
// Binary data excluded from listing queries — fetched on demand
// ============================================================
model ComplianceDocument {
  id             String  @id @default(cuid())
  organizationId String
  submissionId   String?

  fileName      String
  fileExtension String
  mimeType      String
  fileSize      Int
  checksum      String

  binaryData Bytes

  version      Int     @default(1)
  isLatest     Boolean @default(true)
  documentType String?
  description  String?

  reviewStatus  DocumentReviewStatus @default(PENDING)
  reviewComment String?
  reviewedById  String?
  reviewedAt    DateTime?

  uploadedById String?
  uploadedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submission   ComplianceSubmission? @relation(fields: [submissionId], references: [id])
  versions     DocumentVersion[]

  @@index([organizationId])
  @@index([submissionId])
  @@index([reviewStatus])
  @@map("compliance_documents")
}

enum DocumentReviewStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

// ============================================================
// COMPLIANCE SUBMISSION (core compliance lifecycle record)
// ============================================================
model ComplianceSubmission {
  id             String  @id @default(cuid())
  organizationId String
  categoryId     String
  typeId         String?

  title           String
  description     String?
  referenceNumber String?

  status ComplianceStatus @default(DRAFT)

  submissionDate DateTime?
  effectiveDate  DateTime?
  expiryDate     DateTime?
  dueDate        DateTime?
  renewalDate    DateTime?

  penaltyAmount Decimal? @db.Decimal(12, 2)
  feeAmount     Decimal? @db.Decimal(12, 2)

  assignedToId String?
  reviewedById String?
  assignedCaId String?
  verifiedById String?

  complianceData Json?

  version Int      @default(1)
  tags    String[]
  notes   String?

  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category      ComplianceCategory        @relation(fields: [categoryId], references: [id])
  type          ComplianceType?           @relation(fields: [typeId], references: [id])
  documents     ComplianceDocument[]
  approvals     ComplianceApproval[]
  reminders     ComplianceReminder[]
  statusHistory ComplianceStatusHistory[]
  deadlines     ComplianceDeadline[]
  auditLogs     ComplianceAuditLog[]

