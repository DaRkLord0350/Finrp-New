// ============================================================
model BankSyncHistory {
  id             String  @id @default(cuid())
  organizationId String
  bankAccountId  String?
  consentId      String? // BankConsent.id
  connectionId   String?

  provider AAProvider    @default(SETU)
  trigger  SyncTrigger   @default(MANUAL)
  syncType SyncType      @default(INCREMENTAL)
  status   SyncRunStatus @default(QUEUED)

  // Setu FI data session backing this run
  dataSessionId String?
  fromDate      DateTime?
  toDate        DateTime?

  // Outcome counters
  txnsFetched   Int @default(0)
  txnsSaved     Int @default(0)
  txnsDuplicate Int @default(0)
  balancesSaved Int @default(0)

  attempt   Int     @default(1)
  error     String?
  errorCode String?
  metadata  Json?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount  BankAccount? @relation("BankAccountSyncHistory", fields: [bankAccountId], references: [id])
  consent      BankConsent? @relation("BankConsentSyncHistory", fields: [consentId], references: [id])

  @@index([organizationId, startedAt])
  @@index([bankAccountId, startedAt])
  @@index([organizationId, status])
  @@index([dataSessionId])
  @@map("bank_sync_history")
}

enum SyncTrigger {
  MANUAL
  SCHEDULED
  WEBHOOK
  INITIAL
}

enum SyncType {
  FULL
  INCREMENTAL
  BALANCE_ONLY
}

enum SyncRunStatus {
  QUEUED
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

// ============================================================
// BANK BALANCE (point-in-time balance snapshots per account)
// ============================================================
model BankBalance {
  id             String @id @default(cuid())
  organizationId String
  bankAccountId  String

  balanceDate      DateTime
  currentBalance   Decimal       @db.Decimal(16, 2)
  availableBalance Decimal?      @db.Decimal(16, 2)
  ledgerBalance    Decimal?      @db.Decimal(16, 2)
  currency         String        @default("INR")
  source           BankTxnSource @default(AA_SETU)

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount  BankAccount  @relation("BankAccountBalances", fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@unique([bankAccountId, balanceDate, source])
  @@index([organizationId, balanceDate])
  @@index([bankAccountId, balanceDate])
  @@map("bank_balances")
}

// ============================================================
// BANK WEBHOOK EVENT (AA webhook audit + idempotency store)
// Standalone (not the generic WebhookEvent) because AA webhooks
// arrive before any Integration row exists and may not be
// resolvable to an organization until the consent is looked up.
// ============================================================
model BankWebhookEvent {
  id             String        @id @default(cuid())
  organizationId String? // resolved from consent lookup; null if unknown
  provider       AAProvider    @default(SETU)
  eventType      String
  externalId     String?       @unique // provider notification id (replay dedup)
  consentId      String? // Setu consent id
  dataSessionId  String?
  payload        Json
  rawBody        String?
  signature      String?
  signatureValid Boolean       @default(false)
  status         WebhookStatus @default(PENDING)
  processedAt    DateTime?
  error          String?
  retryCount     Int           @default(0)
  receivedAt     DateTime      @default(now())

  organization Organization? @relation("OrgBankWebhookEvents", fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([provider, eventType])
  @@index([consentId])
  @@index([status, receivedAt])
  @@map("bank_webhook_events")
}

// ============================================================
// ============================================================
//   CA HUB — Chartered Accountant Practice Operating System
//
//   Net-new data layer for the CA Hub super-module. Designed to be
//   ADDITIVE: every model carries scalar tenant keys (firmId /
//   organizationId = client org) with indexes instead of formal
//   back-relations, so adding this block does NOT require touching
//   any of the 100+ existing core models. Wire formal relations
//   later if/when needed.
//
//   Tenant model:
//     firmId         → the CA practice (Firm) that owns the record
//     organizationId → the CLIENT organization the filing belongs to
//     caUserId       → the CA/staff user responsible
//
//   Tables are prefixed ca_hub_* to avoid any name collision.
// ============================================================

enum CaFilingStatus {
  NOT_STARTED
  IN_PROGRESS
  PENDING_DOCS
  PENDING_REVIEW
  READY_TO_FILE
  FILED
  LATE_FILED
  OVERDUE
  REJECTED
}

enum CaRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum GstReturnType {
  GSTR1
  GSTR3B
  GSTR9
  GSTR9C
  CMP08
  GSTR4
  IFF
}

enum ItrFormType {
  ITR1
  ITR2
  ITR3
  ITR4
  ITR5
  ITR6
  ITR7
}

enum TaxRegime {
  OLD
  NEW
}

enum TdsFormType {
  FORM24Q
  FORM26Q
  FORM27Q
  FORM27EQ
}

enum AuditEngagementType {
  STATUTORY
  TAX_AUDIT
  INTERNAL
  GST_AUDIT
  STOCK
  CONCURRENT
  LIMITED_REVIEW
}

enum AuditEngagementStatus {
  PLANNING
  FIELDWORK
  REVIEW
  FINALIZED
  SIGNED_OFF
}

enum RocFormType {
  AOC4
  MGT7
  MGT7A
  DIR3KYC
  ADT1
  DPT3
  LLP8
  LLP11
  INC22
}

enum CaEsignType {
  AADHAAR
  DSC
}

enum CaEsignStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  DECLINED
  EXPIRED
}

enum CaCopilotRole {
  USER
  ASSISTANT
  SYSTEM
}

enum CaCopilotDomain {
  COMPLIANCE
  AUDIT
  GST
  TAX
  NOTICE
  GENERAL
}

// ── Per-client compliance scorecard (Client 360 + dashboard) ──
model ClientComplianceProfile {
  id             String         @id @default(cuid())
  organizationId String         @unique
  firmId         String?
  partnerUserId  String?
  managerUserId  String?
  healthScore    Int            @default(0)
  riskLevel      CaRiskLevel    @default(LOW)
  gstStatus      CaFilingStatus @default(NOT_STARTED)
  tdsStatus      CaFilingStatus @default(NOT_STARTED)
  itrStatus      CaFilingStatus @default(NOT_STARTED)
  rocStatus      CaFilingStatus @default(NOT_STARTED)
  auditStatus    CaFilingStatus @default(NOT_STARTED)
  payrollStatus  CaFilingStatus @default(NOT_STARTED)
  openTaskCount  Int            @default(0)
  monthlyFee     Decimal?       @db.Decimal(12, 2)
  lastReviewedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([firmId])
  @@index([riskLevel])
  @@map("ca_hub_client_profiles")
}

// ── GST filings (GSTR-1/3B/9/9C etc.) ─────────────────────────
model GstFiling {
  id             String         @id @default(cuid())
  organizationId String
  firmId         String?
  caUserId       String?
  gstin          String?
  returnType     GstReturnType
  periodLabel    String // e.g. "May 2026" or "FY 2025-26"
  periodMonth    Int?
  periodYear     Int
