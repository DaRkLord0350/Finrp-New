// ============================================
// FinRP — Prisma Schema
// Multi-tenant SaaS architecture
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ORGANIZATION (Tenant root)
// ============================================================
model Organization {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  plan                Plan     @default(FREE)
  onboardingCompleted Boolean  @default(false)
  enabledModules      String[] @default([])
  createdBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // ── Pricing & subscription (org-centric source of truth) ─────
  // `plan` (above) is the legacy enum kept for backward-compat; the
  // fields below drive the new CA/Business pricing model. See
  // lib/billing/plans.ts for the catalog these reference.
  billingCategory        BillingCategory? // CA firm vs. Business (null until chosen)
  planType               PlanType? // concrete plan within the category
  subscriptionStatus     SubscriptionStatus  @default(INACTIVE)
  clientLimit            Int? // CA: max active clients (null = unlimited)
  teamLimit              Int? // CA: max team members (null = unlimited)
  activeClientCount      Int                 @default(0) // CA: cached # of active client links
  teamMemberCount        Int                 @default(0) // CA: cached # of team members
  graceLimit             Int                 @default(0) // soft overage allowance above the hard limit
  linkedCAOrganizationId String? // BUSINESS: the CA org it is connected to
  relationshipStatus     RelationshipStatus? // BUSINESS: status of its CA link
  // ── Razorpay billing ──
  razorpayCustomerId     String?
  razorpaySubscriptionId String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?

  users                   User[]
  memberships             Membership[]
  invitations             Invitation[]
  rolePermissions         RolePermission[]
  integrations            Integration[]
  importJobs              ImportJob[]
  fieldMappings           FieldMapping[]
  webhookEvents           WebhookEvent[]
  customers               Customer[]
  vendors                 Vendor[]
  invoices                Invoice[]
  payments                Payment[]
  complianceTasks         ComplianceTask[]
  businessProfile         BusinessProfile?
  complianceCategories    ComplianceCategory[]
  complianceTypes         ComplianceType[]
  complianceSubmissions   ComplianceSubmission[]
  complianceDocuments     ComplianceDocument[]
  complianceApprovals     ComplianceApproval[]
  complianceReminders     ComplianceReminder[]
  complianceDeadlines     ComplianceDeadline[]
  complianceAuditLogs     ComplianceAuditLog[]
  complianceStatusHistory ComplianceStatusHistory[]
  analyticsRecords        AnalyticsRecord[]
  items                   Item[]
  loans                   Loan[]
  sales                   Sale[]
  purchases               Purchase[]
  expenses                Expense[]
  payroll                 Payroll[]
  accounts                Account[]
  journalEntries          JournalEntry[]
  bankAccounts            BankAccount[]
  vendorPayments          VendorPayment[]
  recurringInvoices       RecurringInvoice[]
  leads                   Lead[]
  fileUploads             FileUpload[]
  taxRates                TaxRate[]
  employees               Employee[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  settings                Settings?
  subscription            Subscription?
  orgDocuments            OrganizationDocument[]
  apiTokens               ApiToken[]
  caClients               CAClient[]                @relation("CAManagedOrgs")
  tredsIntegration        TredsIntegration?
  tredsInvoices           TredsInvoice[]
  firmTasks               FirmTask[]
  messages                Message[]
  signatureRequests       SignatureRequest[]
  notificationQueue       NotificationQueue[]
  complianceTemplates     ComplianceTemplate[]
  firmBranding            FirmBranding?
  firmNotifSettings       FirmNotificationSettings?
  dashboardSnapshots      DashboardSnapshot[]
  monthlyRevenueStats     MonthlyRevenueStat[]
  firmSnapshots           FirmSnapshot[]
  complianceStats         ComplianceStat[]
  scheduledReports        ScheduledReport[]

  // ── Banking OS ──────────────────────────────
  bankTransactions       BankTransaction[]
  bankingRules           BankingRule[]
  reconciliationSessions BankReconciliationSession[]
  bankConnections        BankConnection[]
  cashFlowSnapshots      CashFlowSnapshot[]
  gstBankMatches         GSTBankMatch[]
  bankRiskAlerts         BankRiskAlert[]
  bankAIInsights         BankAIInsight[]
  bankSyncHistory        BankSyncHistory[]
  bankBalances           BankBalance[]
  bankWebhookEvents      BankWebhookEvent[]          @relation("OrgBankWebhookEvents")
  rawBankStatements      RawBankStatement[]

  // ── Client Workspace (CA impersonation) ─────
  clientAssignments  ClientAssignment[]  @relation("ClientAssignmentOrg")
  clientActivityLogs ClientActivityLog[] @relation("ClientActivityOrg")

  // ── Firm team management (Phase 3) ──────────
  teamActivityLogs TeamActivityLog[]

  // ── Customer onboarding invitations ─────────
  customerInvitations CustomerInvitation[] @relation("OrgCustomerInvitations")

  // ── Customer document vault (Phase 5) ───────
  vaultDocuments CustomerDocument[] @relation("OrgVaultDocuments")

  // ── Invoice module (premium workspace) ──────
  invoiceAppearance  InvoiceAppearanceSettings?
  invoiceTemplates   InvoiceTemplate[]
  invoiceShareLinks  InvoiceShareLink[]
  invoiceActivities  InvoiceActivity[]
  invoiceVersions    InvoiceVersion[]
  creditNotes        CreditNote[]
  tdsTcsSections     TdsTcsSection[]
  invoiceAttachments InvoiceAttachment[]

  // ── Accounting (fiscal years, periods, settings) ─
  fiscalYears           FiscalYear[]
  fiscalPeriods         FiscalPeriod[]
  accountingSettings    AccountingSettings?
  budgets               Budget[]
  orgExchangeRates      OrgExchangeRate[]
  currencyRevaluations  CurrencyRevaluation[]
  bulkAccountUpdateJobs BulkAccountUpdateJob[]

  // ── CA ↔ Business pricing relationships ─────────────────────
  // Self-relation: a business org points at the CA org it is linked to.
  linkedCAOrganization      Organization?    @relation("CALinkedBusinesses", fields: [linkedCAOrganizationId], references: [id], onDelete: SetNull)
  linkedBusinesses          Organization[]   @relation("CALinkedBusinesses")
  caRelationshipsAsCA       CARelationship[] @relation("CARelationshipCA")
  caRelationshipsAsBusiness CARelationship[] @relation("CARelationshipBusiness")
  billingPayments           BillingPayment[]

  // ── Financial Reporting Engine ──────────────────────────────
  accountScheduleMaps  AccountScheduleMap[]  @relation("OrgAccountScheduleMaps")
  financialReports     FinancialReport[]     @relation("OrgFinancialReports")
  statementTemplates   StatementTemplate[]   @relation("OrgStatementTemplates")
  statementNotes       StatementNote[]       @relation("OrgStatementNotes")
  accountingPolicies   AccountingPolicy[]    @relation("OrgAccountingPolicies")
  adjustmentJournals   AdjustmentJournal[]   @relation("OrgAdjustmentJournals")
  statementExports     StatementExport[]     @relation("OrgStatementExports")
  financialSnapshots   FinancialSnapshot[]   @relation("OrgFinancialSnapshots")
  branchConsolidations BranchConsolidation[] @relation("BranchConsolidationParent")

  // ── TBX Foundation (Phase 1) ─────────────────────────────────
  orgBranches         OrgBranch[]
  orgDepartments      OrgDepartment[]
  kycProfile          KycProfile?
  orgOnboardingStages OrgOnboardingStage[]
  relatedParties      OrganizationRelatedParty[]
  bankVerifications   OrgBankAccountVerification[]

  // ── Lending Platform (Phase 3, Module 1) ────────────────────
  loanProducts            LoanProduct[]
  loanApplications        LoanApplication[]
  loanApprovalMatrixRules LoanApprovalMatrixRule[]
  loanAccounts            LoanAccount[]
  riskAssessments         RiskAssessment[]

  // ── Credit Bureau (Phase 3, Module 2) ───────────────────────
  creditReports CreditReport[]
  creditApiLogs CreditApiLog[]

  // ── AML (Phase 3, Module 3) ──────────────────────────────────
  amlScreenings AMLScreening[]
  amlCases      AMLCase[]

  // ── Fraud (Phase 3, Module 4) ────────────────────────────────
  fraudIdentityFingerprints FraudIdentityFingerprint[]
  fraudRules                FraudRule[]
  fraudScores               FraudScore[]
  fraudCases                FraudCase[]
  fraudListEntries          FraudListEntry[]
  fraudProviderChecks       FraudProviderCheck[]

  // ── Background Verification (Phase 3, Module 5) ─────────────
  verificationCases VerificationCase[]

  // ── Continuous Monitoring (Phase 3, Module 6) ────────────────
  monitoringRules  MonitoringRule[]
  monitoringAlerts MonitoringAlert[]
  monitoringCases  MonitoringCase[]

  @@index([slug])
  @@index([billingCategory, planType])
  @@index([linkedCAOrganizationId])
  @@map("organizations")
}

enum Plan {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

// ── New pricing model enums ───────────────────────────────────
// Two customer categories drive the entire pricing architecture.
enum BillingCategory {
  CA // Chartered Accountant practice / firm
  BUSINESS // A business (may or may not be linked to a CA)
}

// Concrete plans. The ACTIVE catalog is now a single universal four-tier
// model: FREE / STARTER / GROWTH / ENTERPRISE (see lib/billing/plans.ts).
// The legacy split-catalog values (SOLO … STANDALONE) are retained so any
// pre-existing row stays valid; getPlan() maps them onto the active tiers.
enum PlanType {
  // Active universal tiers
  FREE
  STARTER
  GROWTH
  ENTERPRISE
  // Legacy (retained for backward compatibility)
  SOLO
  GROWING_PRACTICE
  FIRM
  CONNECTED
  CONNECTED_PLUS
  STANDALONE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INACTIVE
}

// Status of a business's link to a CA (mirrored on Organization
// for the linked business and detailed on the CARelationship row).
enum RelationshipStatus {
  PENDING // invitation sent, not yet accepted
  ACTIVE // linked to an active CA
  INACTIVE // CA paused / not currently active
  TERMINATED // link removed
}

// ============================================================
// USER
// ============================================================
model User {
  id                     String             @id @default(cuid())
  clerkId                String             @unique
  email                  String
  name                   String?
  phone                  String?
  role                   Role               @default(STAFF)
  userRole               UserRole? // null = new user, hasn't selected role yet
  department             String?
  designation            String?
  lastActiveAt           DateTime?
  notificationPreference Json?
  avatarUrl              String?
  isActive               Boolean            @default(true)
  lastLoginAt            DateTime?
  organizationId         String
  firmId                 String?
  // ── Firm team-member profile (Phase 3) ──────────────────────
  firmRole               FirmMemberRole? // firm designation (≠ platform userRole)
  specialization         Specialization?
  joiningDate            DateTime?
  defaultPermissions     ClientPermission[] @default([]) // applied when assigned to a client workspace
  firmPermissions        FirmPermission[]   @default([]) // firm-level capability flags (Add-CA wizard)
  profileCompletedAt     DateTime? // stamped when a CA finishes their profile (onboarding stage)
  managerId              String? // reporting manager within the firm (self-relation)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  organization            Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firm                    Firm?                @relation("FirmUsers", fields: [firmId], references: [id])
  manager                 User?                @relation("FirmManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports                 User[]               @relation("FirmManager")
  auditLogs               AuditLog[]
  notifications           Notification[]
  memberships             Membership[]
  complianceTasks         ComplianceTask[]     @relation("AssignedTo")
  invoices                Invoice[]            @relation("InvoiceCreatedBy")
  payments                Payment[]            @relation("PaymentCreatedBy")
  sales                   Sale[]               @relation("SaleCreatedBy")
  purchases               Purchase[]           @relation("PurchaseCreatedBy")
  expenses                Expense[]            @relation("ExpenseCreatedBy")
  vendorPaymentsMade      VendorPayment[]      @relation("VendorPaymentMaker")
  vendorPaymentsChecked   VendorPayment[]      @relation("VendorPaymentChecker")
  journalEntries          JournalEntry[]       @relation("JournalEntryCreatedBy")
  journalEntriesPosted    JournalEntry[]       @relation("JournalEntryPostedBy")
  leads                   Lead[]               @relation("LeadAssignedTo")
  caClients               CAClient[]           @relation("CAManagedClients")
  caMessages              CAMessage[]          @relation("CASentMessages")
  customerAssignments     CustomerAssignment[] @relation("CAAssignments")
  assignmentsMade         CustomerAssignment[] @relation("AssignmentCreatedBy")
  firmTasksAsCa           FirmTask[]           @relation("CATasks")
  firmTasksCreated        FirmTask[]           @relation("FirmTaskCreatedBy")
  sentMessages            Message[]            @relation("MessageSender")
  receivedMessages        Message[]            @relation("MessageReceiver")
  templateAssignmentsMade TemplateAssignment[] @relation("TemplateAssignmentCreatedBy")
  clientAssignments       ClientAssignment[]   @relation("ClientAssignmentCA")
  clientAssignmentsMade   ClientAssignment[]   @relation("ClientAssignmentCreatedBy")
  clientActivityLogs      ClientActivityLog[]  @relation("ClientActivityCA")
  teamActivityLogs        TeamActivityLog[]    @relation("TeamActivityTarget")
  customerInvitesSent     CustomerInvitation[] @relation("CustomerInviteInvitedBy")
  customerInvitesAssigned CustomerInvitation[] @relation("CustomerInviteAssignedCa")
  headOfDepartments       OrgDepartment[]      @relation("DepartmentHead")

  // ── Lending Platform (Phase 3, Module 1) ────────────────────
  underwrittenLoanApplications      LoanApplication[]          @relation("LoanApplicationUnderwriter")
  createdLoanApplications           LoanApplication[]          @relation("LoanApplicationCreatedBy")
  uploadedLoanDocuments             LoanDocument[]             @relation("LoanDocumentUploadedBy")
  verifiedLoanDocuments             LoanDocument[]             @relation("LoanDocumentVerifiedBy")
  loanApprovalStepsAsApprover       LoanApprovalStep[]         @relation("LoanApprovalStepApprover")
  loanApprovalStepsDecided          LoanApprovalStep[]         @relation("LoanApprovalStepDecidedBy")
  issuedLoanLetters                 LoanGeneratedLetter[]      @relation("LoanLetterIssuedBy")
  assignedLoanCollectionCases       LoanCollectionCase[]       @relation("LoanCollectionCaseAssignedTo")
  performedLoanCollectionActivities LoanCollectionActivity[]   @relation("LoanCollectionActivityPerformedBy")
  loanUnderwritingDecisions         LoanUnderwritingDecision[] @relation("LoanUnderwritingDecidedBy")
  approvedLoanForeclosures          LoanForeclosure[]          @relation("LoanForeclosureApprovedBy")
  initiatedLoanDisbursements        LoanDisbursement[]         @relation("LoanDisbursementInitiatedBy")

  // ── Credit Bureau (Phase 3, Module 2) ───────────────────────
  creditReportsRequested CreditReport[] @relation("CreditReportRequestedBy")

  // ── AML (Phase 3, Module 3) ──────────────────────────────────
  amlScreeningsPerformed     AMLScreening[]    @relation("AMLScreeningScreenedBy")
  amlCasesAssigned           AMLCase[]         @relation("AMLCaseAssignedTo")
  amlAlertsReviewed          AMLAlert[]        @relation("AMLAlertReviewedBy")
  amlCaseActivitiesPerformed AMLCaseActivity[] @relation("AMLCaseActivityPerformedBy")

  // ── Fraud (Phase 3, Module 4) ────────────────────────────────
  fraudCasesAssigned           FraudCase[]         @relation("FraudCaseAssignedTo")
  fraudAlertsReviewed          FraudAlert[]        @relation("FraudAlertReviewedBy")
  fraudCaseActivitiesPerformed FraudCaseActivity[] @relation("FraudCaseActivityPerformedBy")
  fraudListEntriesAdded        FraudListEntry[]    @relation("FraudListEntryAddedBy")

  // ── Background Verification (Phase 3, Module 5) ─────────────
  verificationCasesAssigned     VerificationCase[]         @relation("VerificationCaseAssignedTo")
  verificationChecksPerformed   VerificationCheck[]        @relation("VerificationCheckPerformedBy")
  verificationDocumentsUploaded VerificationDocument[]     @relation("VerificationDocumentUploadedBy")
  verificationDocumentsVerified VerificationDocument[]     @relation("VerificationDocumentVerifiedBy")
  verificationCaseActivities    VerificationCaseActivity[] @relation("VerificationCaseActivityPerformedBy")

  // ── Continuous Monitoring (Phase 3, Module 6) ────────────────
  monitoringRulesCreated       MonitoringRule[]         @relation("MonitoringRuleCreatedBy")
  monitoringAlertsAcknowledged MonitoringAlert[]        @relation("MonitoringAlertAcknowledgedBy")
  monitoringAlertsResolved     MonitoringAlert[]        @relation("MonitoringAlertResolvedBy")
  monitoringCasesAssigned      MonitoringCase[]         @relation("MonitoringCaseAssignedTo")
  monitoringCaseActivities     MonitoringCaseActivity[] @relation("MonitoringCaseActivityPerformedBy")

  @@index([organizationId])
  @@index([userRole])
  @@map("users")
}

// Firm-internal designation for a team member (distinct from the
// platform-level UserRole that governs which portal they enter).
enum FirmMemberRole {
  CA
  MANAGER
  PARTNER
  ARTICLE_ASSISTANT
  ADMIN
}

// Firm-level capability flags granted to a team member (distinct from
// ClientPermission, which scopes per-client-workspace access). Set on
// the Add-CA wizard and carried from Invitation → User on accept.
enum FirmPermission {
  MANAGE_CUSTOMERS
  ASSIGN_TASKS
  VIEW_REPORTS
  MANAGE_TEAM
}

// Practice area a team member specialises in.
enum Specialization {
  GST
  INCOME_TAX
  AUDIT
  ROC
  ACCOUNTING
  PAYROLL
}

enum InviteStatus {
  PENDING
  SENT
  ACCEPTED
  EXPIRED
  REVOKED
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  ACCOUNTANT
  STAFF
  VIEWER
}

enum UserRole {
  CUSTOMER
  CA
  CA_FIRM_ADMIN
  ADMIN
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
  COGS
  STOCK
  BANK
  CASH
  TAX
}

enum EntryType {
  DEBIT
  CREDIT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum FileCategory {
  INVOICE
  RECEIPT
  TAX
  PAYROLL
  LOAN
  COMPLIANCE
  OTHER
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ============================================================
// CUSTOMER
// ============================================================
model Customer {
  id                String       @id @default(cuid())
  customerCode      String?
  name              String
  email             String?
  phone             String?
  company           String?
  address           String?
  city              String?
  state             String?
  country           String?
  gstin             String?
  customerType      CustomerType @default(INDIVIDUAL)
  creditLimit       Decimal      @default(0) @db.Decimal(12, 2)
  outstandingAmount Decimal      @default(0) @db.Decimal(12, 2)
  totalPurchases    Decimal      @default(0) @db.Decimal(16, 2)
  lastPurchaseDate  DateTime?
  customerScore     Int?
  tags              String[]
  notes             String?
  isActive          Boolean      @default(true)
  organizationId    String
  firmId            String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firm                Firm?                @relation("FirmCustomers", fields: [firmId], references: [id])
  invoices            Invoice[]
  sales               Sale[]
  recurringInvoices   RecurringInvoice[]
  creditNotes         CreditNote[]
  convertedLeads      Lead[]               @relation("LeadConversion")
  customerAssignments CustomerAssignment[] @relation("CustomerAssignments")
  firmTasks           FirmTask[]           @relation("CustomerFirmTasks")
  templateAssignments TemplateAssignment[] @relation("CustomerTemplateAssignments")
  vaultDocuments      CustomerDocument[]   @relation("CustomerVaultDocuments")
  invitations         CustomerInvitation[] @relation("CustomerInviteLinks")
  portalAccess        ClientPortalAccess[] @relation("CustomerPortalAccess")
  documentRequests    DocumentRequest[]    @relation("CustomerDocumentRequests")
  documentUploads     DocumentUpload[]     @relation("CustomerDocumentUploads")
  filingApprovals     FilingApproval[]     @relation("CustomerFilingApprovals")
  conversations       Conversation[]       @relation("CustomerConversations")

  // ── Lending Platform (Phase 3, Module 1) — Customer is the borrower ──
  loanApplications     LoanApplication[]
  loanCoApplicantLinks LoanCoApplicant[]
  loanAccounts         LoanAccount[]

  @@unique([organizationId, customerCode])
  @@index([organizationId, customerType])
  @@index([organizationId])
  @@map("customers")
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
  WHOLESALE
  RETAIL
  GOVERNMENT
}

// ============================================================
// INVOICE
// ============================================================
model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String
  customerId     String
  organizationId String
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  deletedAt      DateTime?
  createdById    String?
  updatedById    String?

  // Amounts
  subtotal        Decimal @db.Decimal(12, 2)
  discount        Decimal @default(0) @db.Decimal(12, 2) // computed invoice-level discount amount
  discountType    String  @default("FIXED") // FIXED | PERCENT — how discountValue is interpreted
  discountValue   Decimal @default(0) @db.Decimal(12, 2) // raw entered value (% or amount)
  shipping        Decimal @default(0) @db.Decimal(12, 2)
  adjustment      Decimal @default(0) @db.Decimal(12, 2) // arbitrary +/- adjustment
  roundOff        Decimal @default(0) @db.Decimal(12, 2) // rounding difference applied to grand total
  taxRate         Decimal @default(0) @db.Decimal(5, 2)
  taxAmount       Decimal @default(0) @db.Decimal(12, 2)
  // TDS / TCS (Indian withholding / collected tax)
  tdsTcsType      String? // TDS | TCS | null
  tdsTcsSectionId String? // selected TdsTcsSection
  tdsTcsRate      Decimal @default(0) @db.Decimal(5, 2)
  tdsTcsAmount    Decimal @default(0) @db.Decimal(12, 2)
  total           Decimal @db.Decimal(12, 2)
  paidAmount      Decimal @default(0) @db.Decimal(12, 2)
  balanceDue      Decimal @db.Decimal(12, 2)

  // PDF
  pdfUrl         String?
  pdfFileName    String?
  pdfGeneratedAt DateTime?

  // Metadata
  currency           String    @default("INR")
  paymentTerms       String? // DUE_ON_RECEIPT | NET_15 | NET_30 | NET_45 | NET_60 | CUSTOM
  salesperson        String?
  orderNumber        String?
  referenceNumber    String?
  subject            String?
  notes              String?
  terms              String?
  internalNotes      String? // private — never shown on PDF / public link
  customFields       Json? // [{ label, value }] extra fields rendered on the invoice
  invoicePdf         String?
  recurringInvoiceId String? // schedule that generated this invoice (if any)
  sentAt             DateTime?
  viewedAt           DateTime?
  exchangeRate       Decimal?  @db.Decimal(16, 6)
  baseCurrency       String? // For multi-currency tracking
  journalEntryId     String? // Link to general ledger
  incomeAccountId    String? // default income account for ledger posting
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer      Customer            @relation(fields: [customerId], references: [id])
  createdBy     User?               @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  incomeAccount Account?            @relation("InvoiceIncomeAccount", fields: [incomeAccountId], references: [id])
  tdsTcsSection TdsTcsSection?      @relation(fields: [tdsTcsSectionId], references: [id])
  items         InvoiceItem[]
  payments      Payment[]
  shareLinks    InvoiceShareLink[]
  activities    InvoiceActivity[]
  versions      InvoiceVersion[]
  creditNotes   CreditNote[]
  attachments   InvoiceAttachment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@index([organizationId, issueDate])
  @@index([organizationId, createdAt])
  @@index([organizationId])
  @@index([customerId])
  @@index([tdsTcsSectionId])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PAID
  PARTIAL
  OVERDUE
  CANCELLED
  VOID
}

// ============================================================
// INVOICE ITEM
// ============================================================
model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  sku         String?
  hsnSac      String? // HSN (goods) / SAC (services) code for GST
  unit        String? // unit of measure (pcs, hrs, kg…)
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  costPrice   Decimal @default(0) @db.Decimal(12, 2)
  taxPercent  Decimal @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  profit      Decimal @default(0) @db.Decimal(12, 2)

  incomeAccountId String?

  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  incomeAccount Account? @relation("InvoiceItemIncomeAccount", fields: [incomeAccountId], references: [id])

  @@index([invoiceId])
  @@index([incomeAccountId])
  @@map("invoice_items")
}

// ============================================================
// CREDIT NOTE — a credit issued against an invoice. Stored in its
// own table so it never pollutes invoice revenue / outstanding math.
// ============================================================
model CreditNote {
  id               String   @id @default(cuid())
  organizationId   String
  invoiceId        String
  customerId       String
  creditNoteNumber String
  reason           String?
  status           String   @default("ISSUED") // ISSUED, APPLIED, CANCELLED
  currency         String   @default("INR")
  subtotal         Decimal  @db.Decimal(12, 2)
  taxAmount        Decimal  @default(0) @db.Decimal(12, 2)
  total            Decimal  @db.Decimal(12, 2)
  notes            String?
  items            Json // snapshot of credited line items
  issueDate        DateTime @default(now())
  createdById      String?
  accountId        String? // account the credit posts against
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id])
  account      Account?     @relation("CreditNoteAccount", fields: [accountId], references: [id])

  @@unique([organizationId, creditNoteNumber])
  @@index([invoiceId])
  @@index([organizationId])
  @@map("credit_notes")
}

// ============================================================
// PAYMENT
// ============================================================
model Payment {
  id                 String        @id @default(cuid())
  invoiceId          String
  organizationId     String
  amount             Decimal       @db.Decimal(12, 2)
  method             PaymentMethod @default(BANK_TRANSFER)
  reference          String?
  transactionId      String?
  bankName           String?
  paymentGateway     String?
  paymentFees        Decimal       @default(0) @db.Decimal(10, 2)
  notes              String?
  paidAt             DateTime      @default(now())
  createdAt          DateTime      @default(now())
  deletedAt          DateTime?
  bankAccountId      String?
  createdById        String?
  journalEntryId     String? // Link to general ledger
  depositToAccountId String? // ledger account funds are deposited to

  bankAccount      BankAccount? @relation("BankAccountPayments", fields: [bankAccountId], references: [id])
  invoice          Invoice      @relation(fields: [invoiceId], references: [id])
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy        User?        @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  depositToAccount Account?     @relation("PaymentDepositAccount", fields: [depositToAccountId], references: [id])

  @@index([organizationId])
  @@index([invoiceId])
  @@map("payments")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  UPI
  CHEQUE
  ONLINE
  OTHER
}

// ============================================================
// INVOICE MODULE — premium workspace (appearance, themes,
// share links, activity timeline, version history)
// All additive; no changes to existing invoice columns.
// ============================================================

// Per-organization invoice appearance / branding for PDFs + preview.
model InvoiceAppearanceSettings {
  id             String @id @default(cuid())
  organizationId String @unique

  // Theme + branding
  template          String  @default("elegant-purple") // active built-in theme key
  accentColor       String  @default("#6366f1")
  fontFamily        String  @default("Helvetica")
  borderRadius      Int     @default(8)
  invoiceTitle      String  @default("INVOICE")
  footerText        String  @default("Generated securely by FinRP")
  signatureText     String?
  signatureImageUrl String?
  watermarkText     String?
  draftWatermark    Boolean @default(true)
  logoUrl           String? // overrides BusinessProfile.logoUrl when set

  // Visibility toggles
  showLogo            Boolean @default(true)
  showQr              Boolean @default(false)
  showPaymentLink     Boolean @default(false)
  showDueStamp        Boolean @default(true)
  showGst             Boolean @default(true)
  showPan             Boolean @default(true)
  showItemDescription Boolean @default(true)
  showDiscountColumn  Boolean @default(true)
  showTaxColumn       Boolean @default(true)
  showShipping        Boolean @default(true)
  showNotes           Boolean @default(true)
  showTerms           Boolean @default(true)

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("invoice_appearance_settings")
}

// Saved / custom invoice templates (built-ins live in code; users can save variants).
model InvoiceTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  key            String // theme key: modern-minimal, executive-dark, glass-premium, corporate-blue, elegant-purple, classic-accounting
  isBuiltIn      Boolean  @default(false)
  isDefault      Boolean  @default(false)
  config         Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invoice_templates")
}

// Secure public share links for an invoice.
model InvoiceShareLink {
  id             String    @id @default(cuid())
  invoiceId      String
  organizationId String
  token          String    @unique
  passwordHash   String?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  viewCount      Int       @default(0)
  lastViewedAt   DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([token])
  @@map("invoice_share_links")
}

// Activity / audit timeline entries for an invoice.
model InvoiceActivity {
  id             String   @id @default(cuid())
  invoiceId      String
  organizationId String
  type           String // CREATED, STATUS_CHANGED, UPDATED, PDF_GENERATED, PAYMENT_RECORDED, EMAIL_SENT, SHARED, VIEWED, DELETED
  message        String
  metadata       Json?
  actorId        String?
  actorName      String?
  createdAt      DateTime @default(now())

  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([invoiceId, createdAt])
  @@index([organizationId])
  @@map("invoice_activities")
}

// Immutable version snapshots of an invoice (history / restore).
model InvoiceVersion {
  id             String   @id @default(cuid())
  invoiceId      String
  organizationId String
  version        Int
  snapshot       Json
  changedById    String?
  changeSummary  String?
  createdAt      DateTime @default(now())

  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, version])
  @@index([invoiceId])
  @@map("invoice_versions")
}

// Configurable TDS / TCS sections + rates (per organization).
// Seeded with common Indian sections on first read; fully editable.
model TdsTcsSection {
  id             String   @id @default(cuid())
  organizationId String
  type           String // TDS | TCS
  code           String // e.g. 194C, 206C(1H)
  name           String // e.g. Payment to Contractors
  rate           Decimal  @db.Decimal(5, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     Invoice[]

  @@unique([organizationId, type, code])
  @@index([organizationId, type])
  @@map("tds_tcs_sections")
}

// Invoice file attachments — stored binary-in-DB (mirrors ComplianceDocument).
model InvoiceAttachment {
  id             String   @id @default(cuid())
  invoiceId      String
  organizationId String
  fileName       String
  mimeType       String
  fileSize       Int
  checksum       String
  binaryData     Bytes
  uploadedById   String?
  createdAt      DateTime @default(now())

  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([organizationId])
  @@map("invoice_attachments")
}

// ============================================================
// COMPLIANCE TASK
// ============================================================
model ComplianceTask {
  id             String        @id @default(cuid())
  title          String
  description    String?
  category       TaskCategory  @default(OTHER)
  status         TaskStatus    @default(PENDING)
  priority       PriorityLevel @default(MEDIUM)
  dueDate        DateTime
  reminderDate   DateTime?
  completedAt    DateTime?
  penaltyAmount  Decimal?      @db.Decimal(12, 2)
  documentUrl    String?
  assignedToId   String?
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("AssignedTo", fields: [assignedToId], references: [id])

  @@index([organizationId])
  @@index([organizationId, status, dueDate])
  @@map("compliance_tasks")
}

enum TaskCategory {
  TAX
  GST
  TDS
  REGULATORY
  LICENSE
  AUDIT
  REPORTING
  OTHER
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

// ============================================================
// BUSINESS PROFILE (Extended org details — one-to-one)
// ============================================================
model BusinessProfile {
  id             String @id @default(cuid())
  organizationId String @unique

  // Identity
  businessName   String
  businessType   String?
  registrationNo String?
  taxId          String? // GST / VAT / EIN
  gstin          String?
  pan            String?
  cin            String?
  industry       String?
  companySize    String? // "1-10", "11-50", etc.

  // Location
  country String?
  state   String?
  city    String?
  address String?
  pincode String?

  // Preferences
  currency        String         @default("INR")
  timezone        String         @default("Asia/Kolkata")
  language        String         @default("en")
  fiscalYearStart DateTime?
  fiscalYearType  FiscalYearType @default(APRIL_MARCH)

  // Financial setup (onboarding)
  initialCapital         Decimal? @db.Decimal(16, 2)
  openingBankBalance     Decimal? @db.Decimal(16, 2)
  openingCashBalance     Decimal? @db.Decimal(16, 2)
  monthlyRevenueEstimate Decimal? @db.Decimal(16, 2)
  monthlyExpenseEstimate Decimal? @db.Decimal(16, 2)
  defaultTaxRate         Decimal? @db.Decimal(5, 2)
  profitMarginTarget     Decimal? @db.Decimal(5, 2)
  paymentTermsDays       Int      @default(30)
  invoicePrefix          String   @default("INV")
  loanInterestBenchmark  Decimal? @db.Decimal(5, 2)

  // Inventory setup
  inventoryEnabled  Boolean @default(true)
  warehouseName     String?
  lowStockThreshold Int     @default(10)
  skuFormat         String?
  unitsUsed         String?

  // Compliance setup
  taxFilingFrequency String?
  gstFilingDates     String?
  licenseExpiryDates Json?
  auditSchedule      String?
  payrollTaxEnabled  Boolean @default(false)

  // Branding
  logoUrl      String?
  website      String?
  websiteUrl   String?
  contactEmail String?
  contactPhone String?
  phone        String?

  // Onboarding
  onboardingComplete Boolean @default(false)
  onboardingStep     Int     @default(0)

  // ── TBX Foundation (Phase 1) — Organization Master extensions ──
  msmeRegistrationNo   String?
  msmeCategory         String? // MICRO | SMALL | MEDIUM
  operationalAddress   Json? // set only when it differs from the registered address fields above
  defaultBankAccountId String? // FK -> BankAccount.id, no cascading relation needed

  panVerificationStatus TbxVerificationStatus?
  gstVerificationStatus TbxVerificationStatus?
  cinVerificationStatus TbxVerificationStatus?

  tbxCustomerId     String?   @unique
  tbxOrganizationId String?   @unique
  tbxStatus         String?
  tbxLastSyncAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

enum FiscalYearType {
  APRIL_MARCH // India
  JANUARY_DECEMBER
  JULY_JUNE
  OCTOBER_SEPTEMBER
}

// ============================================================
// ANALYTICS RECORD
// ============================================================
model AnalyticsRecord {
  id             String   @id @default(cuid())
  organizationId String
  period         String // e.g. "2025-01", "2025-Q1"
  metric         String // e.g. "revenue", "invoices_count", "new_customers"
  value          Decimal  @db.Decimal(16, 4)
  metadata       Json?
  recordedAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([period])
  @@index([metric])
  @@map("analytics_records")
}

// ============================================================
// ITEM (Inventory Catalog)
// ============================================================
model Item {
  id          String    @id @default(cuid())
  sku         String?
  barcode     String?
  name        String
  description String?
  category    String?
  brand       String?
  unit        String?
  image       String?
  batchNumber String?
  expiryDate  DateTime?
  deletedAt   DateTime?

  // Pricing
  costPrice    Decimal @default(0) @db.Decimal(12, 2)
  sellingPrice Decimal @default(0) @db.Decimal(12, 2)
  taxRate      Decimal @default(0) @db.Decimal(5, 2)

  // Stock
  stock        Int @default(0)
  reorderLevel Int @default(10)
  lowStockAt   Int @default(10)

  // Storage
  warehouse String?

  isActive       Boolean  @default(true)
  organizationId String
  vendorId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor        Vendor?        @relation(fields: [vendorId], references: [id])
  transactions  Transaction[]
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]

  @@unique([organizationId, sku])
  @@index([organizationId, category])
  @@index([organizationId, stock])
  @@index([organizationId])
  @@map("items")
}

// ============================================================
// VENDOR / SUPPLIER
// ============================================================
model Vendor {
  id                 String    @id @default(cuid())
  vendorCode         String? // org-level unique handled separately
  name               String
  contactPerson      String?
  email              String?
  phone              String?
  address            String?
  city               String?
  state              String?
  country            String?
  gstin              String?
  bankName           String?
  bankAccount        String?
  bankIFSC           String?
  outstandingBalance Decimal   @default(0) @db.Decimal(12, 2)
  totalPurchases     Decimal   @default(0) @db.Decimal(16, 2)
  paymentTermsDays   Int       @default(30)
  category           String?
  tags               String[]
  notes              String?
  isActive           Boolean   @default(true)
  organizationId     String
  payableAccountId   String? // default A/P account for this vendor
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  // TBX Beneficiary linkage (Phase 2C). Vendor is the source of truth —
  // there is no separate beneficiary master. One vendor <-> one TBX
  // beneficiary. tbxMetadata carries the raw last-synced TBX payload.
  tbxBeneficiaryId      String?
  tbxBeneficiaryStatus  TbxBeneficiaryStatus         @default(NOT_LINKED)
  tbxVerificationStatus TbxVerificationStatus        @default(NOT_STARTED)
  tbxApprovalStatus     TbxBeneficiaryApprovalStatus @default(NOT_REQUESTED)
  tbxLastSyncAt         DateTime?
  tbxMetadata           Json?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchases      Purchase[]
  items          Item[]
  payableAccount Account?     @relation("VendorPayableAccount", fields: [payableAccountId], references: [id])

  @@unique([organizationId, vendorCode])
  @@index([organizationId])
  @@index([organizationId, tbxBeneficiaryStatus])
  @@map("vendors")
}

enum TbxBeneficiaryStatus {
  NOT_LINKED
  PENDING
  ACTIVE
  INACTIVE
  FAILED
}

enum TbxBeneficiaryApprovalStatus {
  NOT_REQUESTED
  PENDING
  APPROVED
  REJECTED
}

// ============================================================
// BUSINESS (Legacy — Clerk-linked onboarding record)
// Keep for backward compatibility, migrate to BusinessProfile
// ============================================================
model Business {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  name      String
  type      String?
  industry  String?
  address   String?
  country   String?
  currency  String   @default("INR")
  taxId     String?
  createdAt DateTime @default(now())

  @@map("businesses")
}

// ============================================================
// DOUBLE ENTRY ACCOUNTING
// ============================================================
model Account {
  id String @id @default(cuid())

  organizationId String

  code String
  name String

  type           AccountType
  accountSubType String?

  description String?

  // Running ledger balance (debit/credit-normalized per `type`).
  // Exposed to API/service consumers as `currentBalance`.
  balance        Decimal @default(0) @db.Decimal(16, 2)
  openingBalance Decimal @default(0) @db.Decimal(16, 2)

  isActive          Boolean @default(true)
  isSystemGenerated Boolean @default(false)

  parentAccountId String?
  parentAccount   Account?  @relation("AccountHierarchy", fields: [parentAccountId], references: [id], onDelete: SetNull)
  children        Account[] @relation("AccountHierarchy")

  createdBy String?
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journalLines JournalLine[]
  loans        Loan[]
  budgetLines  BudgetLine[]

  expenses Expense[] @relation("ExpensePaymentAccount")

  // Source-document account references (used by Bulk Account Update + posting)
  invoiceIncomeLinks       Invoice[]            @relation("InvoiceIncomeAccount")
  invoiceItemIncomeLinks   InvoiceItem[]        @relation("InvoiceItemIncomeAccount")
  paymentDepositLinks      Payment[]            @relation("PaymentDepositAccount")
  purchaseExpenseLinks     Purchase[]           @relation("PurchaseExpenseAccount")
  purchaseItemExpenseLinks PurchaseItem[]       @relation("PurchaseItemExpenseAccount")
  vendorPayableLinks       Vendor[]             @relation("VendorPayableAccount")
  creditNoteLinks          CreditNote[]         @relation("CreditNoteAccount")
  accountScheduleMaps      AccountScheduleMap[] @relation("AccountScheduleMaps")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, type])
  @@index([organizationId, isActive])
  @@index([parentAccountId])
  @@map("accounts")
}

enum JournalStatus {
  DRAFT
  POSTED
  VOID
}

enum JournalType {
  MANUAL
  SYSTEM
  OPENING
  CLOSING
  FOREX
  ADJUSTMENT
}

model JournalEntry {
  id String @id @default(cuid())

  organizationId String

  // Human-facing sequence number (e.g. JN-2026-000001) — manual/posted entries.
  journalNumber String?

  status      JournalStatus @default(POSTED)
  journalType JournalType   @default(MANUAL)

  reference   String?
  description String?

  // Origin of the entry for system/integration postings (INVOICE/PAYMENT/EXPENSE/BANK/…).
  source   String?
  sourceId String?

  entryDate DateTime @default(now())

  // Multi-currency: amounts are stored in base currency; these document the source rate.
  currency     String  @default("INR")
  exchangeRate Decimal @default(1) @db.Decimal(18, 8)

  notes String?

  totalDebit Decimal @default(0) @db.Decimal(16, 2)

  totalCredit Decimal @default(0) @db.Decimal(16, 2)

  createdById String?
  postedById  String?
  postedAt    DateTime?

  // Reversal linkage — a VOID/reversing entry points back at the original.
  reversalOfId String?

  // Fiscal period the entry posts into (resolved at post time).
  fiscalYearId   String?
  fiscalPeriodId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser User?          @relation("JournalEntryCreatedBy", fields: [createdById], references: [id])
  postedByUser  User?          @relation("JournalEntryPostedBy", fields: [postedById], references: [id])
  reversalOf    JournalEntry?  @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversals     JournalEntry[] @relation("JournalReversal")
  fiscalYear    FiscalYear?    @relation(fields: [fiscalYearId], references: [id])
  fiscalPeriod  FiscalPeriod?  @relation(fields: [fiscalPeriodId], references: [id])
  lines         JournalLine[]

  @@unique([organizationId, journalNumber])
  @@index([organizationId, entryDate])
  @@index([organizationId, status])
  @@index([organizationId, journalType])
  @@index([organizationId, source, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id String @id @default(cuid())

  journalEntryId String

  accountId String

  type EntryType

  amount Decimal @db.Decimal(16, 2)

  description String?

  lineOrder Int @default(0)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

model JournalNumberCounter {
  id String @id @default(cuid())

  organizationId String
  prefix         String
  year           Int
  lastNumber     Int    @default(0)

  updatedAt DateTime @updatedAt

  @@unique([organizationId, prefix, year])
  @@map("journal_number_counters")
}

// ============================================================
// FISCAL YEARS, PERIODS & ACCOUNTING SETTINGS
// ============================================================
enum FiscalYearStatus {
  OPEN
  CLOSED
}

enum FiscalPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

model FiscalYear {
  id String @id @default(cuid())

  organizationId String

  name      String // e.g. "FY 2026-27"
  startDate DateTime
  endDate   DateTime

  status FiscalYearStatus @default(OPEN)

  closedAt         DateTime?
  closedById       String?
  // Journal entries created by the year-end close (closing + opening).
  closingJournalId String?
  openingJournalId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  periods          FiscalPeriod[]
  journals         JournalEntry[]
  budgets          Budget[]
  financialReports FinancialReport[] @relation("FiscalYearReports")

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@map("fiscal_years")
}

model FiscalPeriod {
  id String @id @default(cuid())

  organizationId String
  fiscalYearId   String

  name         String // e.g. "Apr 2026"
  periodNumber Int
  startDate    DateTime
  endDate      DateTime

  status FiscalPeriodStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fiscalYear   FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  journals     JournalEntry[]

  @@unique([fiscalYearId, periodNumber])
  @@index([organizationId, startDate, endDate])
  @@map("fiscal_periods")
}

model AccountingSettings {
  id String @id @default(cuid())

  organizationId String @unique

  baseCurrency String @default("INR")

  // Transaction locking — postings on/before this date are blocked
  // unless the actor holds `accounting.manage`.
  lockDate   DateTime?
  lockReason String?

  // System account mappings used by closing / forex / rounding postings.
  retainedEarningsAccountId String?
  forexGainLossAccountId    String?
  roundingAccountId         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("accounting_settings")
}

// ============================================================
// BUDGETS
// ============================================================
enum BudgetGranularity {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum BudgetStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Budget {
  id String @id @default(cuid())

  organizationId String
  fiscalYearId   String

  name        String
  granularity BudgetGranularity @default(MONTHLY)
  status      BudgetStatus      @default(DRAFT)

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fiscalYear   FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  lines        BudgetLine[]

  @@unique([organizationId, fiscalYearId, name])
  @@index([organizationId, status])
  @@map("budgets")
}

model BudgetLine {
  id String @id @default(cuid())

  budgetId    String
  accountId   String
  periodIndex Int // 0-based; 0-11 monthly, 0-3 quarterly, 0 yearly
  amount      Decimal @default(0) @db.Decimal(16, 2)

  budget  Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id])

  @@unique([budgetId, accountId, periodIndex])
  @@index([budgetId])
  @@index([accountId])
  @@map("budget_lines")
}

// ============================================================
// CURRENCY — org rate book + revaluation runs
// ============================================================
enum RevaluationStatus {
  DRAFT
  POSTED
}

model OrgExchangeRate {
  id String @id @default(cuid())

  organizationId String

  baseCurrency   String
  targetCurrency String
  rate           Decimal  @db.Decimal(18, 8)
  asOfDate       DateTime
  source         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, baseCurrency, targetCurrency, asOfDate])
  @@index([organizationId, targetCurrency, asOfDate])
  @@map("org_exchange_rates")
}

model CurrencyRevaluation {
  id String @id @default(cuid())

  organizationId String

  asOfDate      DateTime
  baseCurrency  String
  status        RevaluationStatus @default(DRAFT)
  totalGainLoss Decimal           @default(0) @db.Decimal(16, 2)

  journalEntryId String?
  createdById    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        CurrencyRevaluationLine[]

